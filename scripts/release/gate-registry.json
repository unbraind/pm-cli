{
  "version": 2,
  "automation_inventory": {
    "gate_scripts": [
      {
        "path": "scripts/release/tracker-measurement-gate.mjs",
        "disposition": "migrated",
        "replacement": "pm assurance run tracker-context-quality"
      },
      {
        "path": "scripts/release/absence-tolerance-gate.mjs",
        "disposition": "reduced_to_provider",
        "provider": "repository-quality/absence-tolerance",
        "negative_control": {
          "test": "tests/unit/scripts/release/absence-tolerance-gate.spec.ts",
          "assertion": "fails upward on a regression"
        }
      },
      {
        "path": "scripts/release/agent-task-token-gate.mjs",
        "disposition": "reduced_to_provider",
        "provider": "repository-quality/agent-task-token",
        "provider_negative_args": ["--negative-control"],
        "negative_control": {
          "test": "tests/unit/scripts/release/agent-task-token-gate.spec.ts",
          "assertion": "accepts an exact per-task baseline and detects a seeded regression"
        }
      },
      {
        "path": "scripts/release/context-eval-gate.mjs",
        "disposition": "reduced_to_provider",
        "provider": "repository-quality/context-eval",
        "negative_control": {
          "test": "tests/unit/scripts/release/context-eval-gate.spec.ts",
          "assertion": "fails closed for missing, malformed, unseedable, and regressed inputs"
        }
      },
      {
        "path": "scripts/release/context-intent-calibration-gate.mjs",
        "disposition": "reduced_to_provider",
        "provider": "repository-quality/context-intent-calibration",
        "negative_control": {
          "test": "tests/unit/scripts/release/context-intent-calibration-gate.spec.ts",
          "assertion": "negative control escaped detection"
        }
      },
      {
        "path": "scripts/release/coverage-threshold-gate.mjs",
        "disposition": "retained",
        "reason": "Validates coverage artifacts with integer uncovered-count negative controls."
      },
      {
        "path": "scripts/release/docs-skills-gate.mjs",
        "disposition": "reduced_to_provider",
        "provider": "repository-quality/docs-skills",
        "negative_control": {
          "test": "tests/unit/scripts/release/docs-skills-gate.spec.ts",
          "assertion": "main --links-only with broken link emits json + fail"
        }
      },
      {
        "path": "scripts/release/gate-registry.mjs",
        "disposition": "retained",
        "reason": "Fail-closes the hosted, local, migration, and graph-consumer inventories."
      },
      {
        "path": "scripts/release/greptile-review-gate.mjs",
        "disposition": "retained",
        "reason": "Reads hosted review state and cannot be evaluated from local tracker data."
      },
      {
        "path": "scripts/release/hosted-analysis-gate.mjs",
        "disposition": "retained",
        "reason": "Aggregates hosted analysis services using authenticated GitHub state."
      },
      {
        "path": "scripts/release/package-artifact-gate.mjs",
        "disposition": "retained",
        "reason": "Inspects packed package contents and installed consumer behavior."
      },
      {
        "path": "scripts/release/retrieval-eval-gate.mjs",
        "disposition": "reduced_to_provider",
        "provider": "repository-quality/retrieval-eval",
        "provider_negative_args": ["--negative-control"],
        "negative_control": {
          "test": "tests/unit/scripts/release/retrieval-eval-gate.spec.ts",
          "assertion": "runs the built CLI gate and its impossible-threshold negative control"
        }
      },
      {
        "path": "scripts/release/sentry-telemetry-gate.mjs",
        "disposition": "retained",
        "reason": "Queries privacy-safe live observability services under release policy."
      },
      {
        "path": "scripts/release/surface-replication-gate.mjs",
        "disposition": "retained",
        "reason": "Builds changed SDK surfaces and verifies package replication contracts."
      },
      {
        "path": "scripts/release/static-quality-gate.mts",
        "disposition": "reduced_to_provider",
        "provider": "repository-quality/static-quality",
        "provider_args": [
          "--max-eslint-suppressions",
          "113",
          "--max-coverage-ignore-pragmas",
          "477",
          "--min-docstring-coverage",
          "100",
          "--min-exported-docstring-coverage",
          "100",
          "--min-member-docstring-coverage",
          "100"
        ],
        "negative_control": {
          "test": "tests/unit/scripts/release/static-quality-gate.spec.ts",
          "assertion": "checkSdkImportBoundary fails closed on computed dynamic imports and require calls"
        }
      },
      {
        "path": "scripts/release/token-budget-gate.mjs",
        "disposition": "reduced_to_provider",
        "provider": "repository-quality/token-budget",
        "negative_control": {
          "test": "tests/unit/scripts/release/token-budget-gate.spec.ts",
          "assertion": "fails when the unbounded negative control no longer exceeds the default contract"
        }
      }
    ],
    "provider_checks": [
      {
        "kind": "provider_check",
        "path": "scripts/run-tests.mjs",
        "provider": "repository-quality/recovery-reference",
        "provider_args": [
          "test",
          "--",
          "tests/unit/sdk/refusal-reachability.spec.ts",
          "tests/integration/refusal-reachability.integration.spec.ts"
        ],
        "negative_control": {
          "test": "tests/unit/sdk/refusal-reachability.spec.ts",
          "assertion": "fails closed for missing, duplicate, unreachable, and undeclared proof"
        }
      }
    ],
    "graph_operations": [
      { "operation": "ancestors", "interactive_only_reason": "Bounded hierarchy lookup selected by an operator or agent root." },
      { "operation": "descendants", "interactive_only_reason": "Bounded hierarchy expansion selected by an operator or agent root." },
      { "operation": "predecessors", "interactive_only_reason": "Ordering lookup requires a caller-selected root and traversal bound." },
      { "operation": "successors", "interactive_only_reason": "Ordering lookup requires a caller-selected root and traversal bound." },
      { "operation": "paths", "interactive_only_reason": "Path enumeration requires caller-selected endpoints and cost bounds." },
      { "operation": "impact", "interactive_only_reason": "Impact analysis is an exploratory projection over a selected root." },
      { "operation": "analyze", "interactive_only_reason": "Broad graph analysis is an on-demand planning and diagnosis surface." },
      { "operation": "audit", "automated_consumer": "assurance gate tracker-context-quality" },
      { "operation": "communities", "interactive_only_reason": "Community detection is exploratory and has caller-selected parameters." },
      { "operation": "redundancy", "interactive_only_reason": "Redundancy candidates require human or agent remediation judgment." },
      { "operation": "dominators", "interactive_only_reason": "Dominator analysis requires a caller-selected execution root." },
      { "operation": "slack", "interactive_only_reason": "Schedule slack depends on a caller-selected planning projection." },
      { "operation": "centrality", "interactive_only_reason": "Centrality ranking is an on-demand prioritization projection." },
      { "operation": "articulation", "automated_consumer": "graph audit profile articulation_points and bridge_edges" },
      { "operation": "plan", "interactive_only_reason": "Remediation plans require explicit review before tracker mutation." },
      { "operation": "index", "interactive_only_reason": "Durable index lifecycle is explicitly controlled by the workspace operator." }
    ]
  },
  "local_preflight": {
    "command": "pnpm verify:preflight",
    "steps": [
      {
        "id": "build",
        "gates": ["compilation"],
        "executable": { "command": "pnpm", "args": ["build"] },
        "skip_policy": "forbidden"
      },
      {
        "id": "typecheck",
        "gates": ["compilation"],
        "executable": { "command": "pnpm", "args": ["typecheck"] },
        "skip_policy": "forbidden"
      },
      {
        "id": "static-quality-gate",
        "gates": ["documentation", "static-quality", "tracker-context-quality"],
        "executable": { "command": "pnpm", "args": ["quality:static"] },
        "skip_policy": "forbidden"
      },
      {
        "id": "context-entitlement-gate",
        "gates": ["context-retrieval"],
        "executable": {
          "command": "pnpm",
          "args": ["quality:context-eval"]
        },
        "skip_policy": "forbidden"
      },
      {
        "id": "coverage",
        "gates": ["test-coverage"],
        "executable": {
          "command": "pnpm",
          "args": ["test:coverage"],
          "env": { "PM_RUN_TESTS_SKIP_BUILD": "1" }
        },
        "skip_policy": "forbidden"
      },
      {
        "id": "version-policy",
        "gates": ["release-integrity"],
        "executable": { "command": "pnpm", "args": ["version:check"] },
        "skip_policy": "forbidden"
      },
      {
        "id": "secret-scan",
        "gates": ["security"],
        "executable": { "command": "pnpm", "args": ["security:scan"] },
        "skip_policy": "forbidden"
      },
      {
        "id": "npx-smoke",
        "gates": ["package-consumer"],
        "executable": { "command": "pnpm", "args": ["smoke:npx"] },
        "skip_policy": "forbidden"
      },
      {
        "id": "package-first-dogfood",
        "gates": ["package-consumer"],
        "executable": {
          "command": "pnpm",
          "args": ["dogfood:package-first"]
        },
        "skip_policy": "optional",
        "optional_flag": "--skip-dogfood"
      },
      {
        "id": "npm-pack-dry-run",
        "gates": ["package-consumer"],
        "executable": {
          "command": "npm",
          "args": ["pack", "--dry-run", "--silent"]
        },
        "skip_policy": "forbidden"
      },
      {
        "id": "compatibility-check",
        "gates": ["compatibility"],
        "executable": {
          "command": "node",
          "args": ["scripts/release/compatibility-check.mjs", "--json"],
          "capture_json": true
        },
        "skip_policy": "optional",
        "optional_flag": "--skip-compatibility"
      },
      {
        "id": "sentry-telemetry-gate",
        "gates": ["release-integrity"],
        "executable": {
          "command": "node",
          "args": [
            "scripts/release/sentry-telemetry-gate.mjs",
            "--json",
            "--telemetry-mode",
            "{{telemetry_mode}}",
            "--sentry-window-days",
            "{{sentry_window_days}}",
            "--max-critical",
            "{{max_sentry_critical}}",
            "--max-high",
            "{{max_sentry_high}}",
            "--max-telemetry-error-rate",
            "{{max_telemetry_error_rate}}",
            "--max-telemetry-missing-error-rows",
            "{{max_telemetry_missing_error_rows}}"
          ],
          "capture_json": true
        },
        "skip_policy": "optional",
        "optional_flag": "--skip-telemetry-sentry"
      },
      {
        "id": "hosted-analysis-gate",
        "gates": ["static-quality"],
        "executable": {
          "command": "node",
          "args": ["scripts/release/hosted-analysis-gate.mjs", "--json"],
          "capture_json": true,
          "env": { "GH_TOKEN": "{{release_policy_token}}" }
        },
        "skip_policy": "forbidden"
      },
      {
        "id": "greptile-review",
        "gates": ["static-quality"],
        "executable": {
          "command": "node",
          "args": ["scripts/release/greptile-review-gate.mjs", "--json"],
          "capture_json": true
        },
        "skip_policy": "optional",
        "optional_flag": "--skip-greptile"
      }
    ],
    "hosted_only": [
      {
        "gate": "harness-environment-isolation",
        "reason": "Requires distinct clean Claude Code, Codex, and GitHub runner environments."
      },
      {
        "gate": "tracker-integrity",
        "reason": "The authoritative merge receipt and representative-history check runs against a fresh GitHub checkout."
      }
    ]
  },
  "gates": [
    {
      "id": "compilation",
      "owner": "pm-k6t4yb",
      "pipelines": [
        "auto-release.yml#auto-release",
        "ci.yml#build-foundation",
        "ci.yml#build-test",
        "ci.yml#gates",
        "ci.yml#windows-regression",
        "docs.yml#docs",
        "nightly.yml#nightly",
        "release.yml#release"
      ],
      "failure_taxonomy": [
        "build_failed",
        "typecheck_failed",
        "generated_surface_drift"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Compilation failures block every hosted delivery path."
      },
      "negative_control": {
        "test": "tests/unit/scripts/dogfood-package-first.spec.ts",
        "assertion": "fails when the scaffold TypeScript typecheck (tsc) exits non-zero"
      }
    },
    {
      "id": "test-coverage",
      "owner": "pm-k6t4yb",
      "pipelines": [
        "ci.yml#build-test",
        "ci.yml#coverage",
        "ci.yml#coverage-shards",
        "ci.yml#windows-regression",
        "nightly.yml#nightly",
        "release.yml#release"
      ],
      "failure_taxonomy": [
        "test_failed",
        "coverage_threshold_failed",
        "coverage_summary_invalid",
        "coverage_artifact_missing",
        "platform_regression"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Tests and 100 percent coverage are required delivery evidence."
      },
      "negative_control": {
        "test": "tests/unit/scripts/release/coverage-threshold-gate.spec.ts",
        "assertion": "rejects a rounded 100% report using integer uncovered counts"
      }
    },
    {
      "id": "harness-environment-isolation",
      "owner": "pm-631t9p",
      "pipelines": ["ci.yml#gates"],
      "failure_taxonomy": [
        "ambient_harness_leak",
        "author_attribution_mismatch",
        "claim_identity_mismatch"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Harness-sensitive tests must produce the same verdict inside every supported agent host."
      },
      "negative_control": {
        "test": "tests/unit/sdk/agent-runtime-primitives.spec.ts",
        "assertion": "attributes update and close mutations to the detected harness"
      }
    },
    {
      "id": "static-quality",
      "owner": "pm-k6t4yb",
      "pipelines": [
        "ci.yml#gates",
        "codspeed.yml#benchmarks",
        "nightly.yml#nightly",
        "release.yml#release",
        "security.yml#actionlint",
        "security.yml#psscriptanalyzer",
        "security.yml#shellcheck"
      ],
      "failure_taxonomy": [
        "lint_failed",
        "duplication_failed",
        "docstring_coverage_failed",
        "agent_token_budget_failed",
        "intent_budget_unreachable",
        "cursor_chain_token_regression",
        "continuation_metadata_regression",
        "sdk_contract_drift",
        "replication_contract_drift",
        "cli_refusal_inventory_drift",
        "performance_regression",
        "workflow_or_script_quality_failed"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Static contracts and agent context budgets are mandatory."
      },
      "negative_control": {
        "test": "tests/unit/scripts/release/static-quality-gate.spec.ts",
        "assertion": "checkSdkImportBoundary fails closed on computed dynamic imports and require calls"
      }
    },
    {
      "id": "tracker-integrity",
      "owner": "pm-k6t4yb",
      "pipelines": ["ci.yml#gates"],
      "failure_taxonomy": [
        "tracker_validation_failed",
        "history_drift",
        "merge_driver_drift"
      ],
      "bypass": {
        "allowed": false,
        "audit": "The pm history chain and merge fence may not be bypassed."
      },
      "negative_control": {
        "test": "tests/integration/ci-workflow-contract.spec.ts",
        "assertion": "proves the full CI merge-integrity command rejects a non-representative drifted stream"
      }
    },
    {
      "id": "compatibility",
      "owner": "pm-k6t4yb",
      "pipelines": [
        "ci.yml#gates",
        "nightly.yml#nightly",
        "release.yml#release"
      ],
      "failure_taxonomy": [
        "legacy_read_failed",
        "migration_failed",
        "post_migration_validation_failed"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Published storage compatibility is a release requirement."
      },
      "negative_control": {
        "test": "tests/unit/scripts/release/compatibility-check.spec.ts",
        "assertion": "fails when validate returns ok=false"
      }
    },
    {
      "id": "tracker-context-quality",
      "owner": "pm-kpftft",
      "pipelines": ["ci.yml#gates"],
      "failure_taxonomy": [
        "assurance_floor_undercut",
        "assurance_ceiling_exceeded",
        "graph_structure_regressed",
        "outcome_reachability_regressed"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Filed tracker measurements enforce stable context-quality floors and ceilings; lifecycle-sensitive partitions remain explicit advisory diagnostics."
      },
      "negative_control": {
        "test": "tests/unit/sdk/graph/structural-governance.spec.ts",
        "assertion": "requires typed hierarchy or implements paths instead of arbitrary related edges"
      }
    },
    {
      "id": "context-retrieval",
      "owner": "pm-b2hc4x",
      "pipelines": [
        "ci.yml#gates",
        "release.yml#release"
      ],
      "failure_taxonomy": [
        "context_metric_regressed",
        "retrieval_metric_regressed",
        "corpus_contract_invalid",
        "token_entitlement_regressed",
        "per_invocation_accounting_drift",
        "task_token_regression",
        "accounting_receipt_unbounded",
        "consumed_field_omitted"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Context and retrieval relevance are required CI and release gates."
      },
      "negative_control": {
        "test": "tests/unit/scripts/release/retrieval-eval-gate.spec.ts",
        "assertion": "runs the built CLI gate and its impossible-threshold negative control"
      }
    },
    {
      "id": "documentation",
      "owner": "pm-k6t4yb",
      "pipelines": [
        "docs.yml#docs",
        "release.yml#release"
      ],
      "failure_taxonomy": [
        "documentation_contract_failed",
        "broken_relative_link",
        "skill_contract_failed"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Public documentation and skill contracts ship with the CLI."
      },
      "negative_control": {
        "test": "tests/unit/scripts/release/docs-skills-gate.spec.ts",
        "assertion": "main --links-only with broken link emits json + fail"
      }
    },
    {
      "id": "security",
      "owner": "pm-k6t4yb",
      "pipelines": [
        "codeql.yml#analyze",
        "nightly.yml#nightly",
        "release.yml#release",
        "scorecard.yml#analysis",
        "security.yml#actionlint",
        "security.yml#psscriptanalyzer",
        "security.yml#shellcheck",
        "security.yml#trivy",
        "security.yml#trufflehog"
      ],
      "failure_taxonomy": [
        "secret_detected",
        "dependency_vulnerability",
        "static_security_finding",
        "supply_chain_posture_failed"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Security findings require remediation or a reviewed policy change."
      },
      "negative_control": {
        "test": "tests/unit/scripts/check-secrets.spec.ts",
        "assertion": "exits non-zero and lists findings when a tracked file contains a secret"
      }
    },
    {
      "id": "package-consumer",
      "owner": "pm-k6t4yb",
      "pipelines": [
        "ci.yml#build-test",
        "ci.yml#gates",
        "release.yml#release"
      ],
      "failure_taxonomy": [
        "pack_failed",
        "installed_cli_failed",
        "sdk_consumer_failed",
        "plugin_consumer_failed"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Package consumers must pass from isolated installed artifacts."
      },
      "negative_control": {
        "test": "tests/unit/scripts/smoke-npx-from-pack.spec.ts",
        "assertion": "fails when the packed TypeScript consumer typecheck rejects (GH-602)"
      }
    },
    {
      "id": "release-integrity",
      "owner": "pm-k6t4yb",
      "pipelines": [
        "auto-release.yml#auto-release",
        "nightly.yml#nightly",
        "release.yml#release"
      ],
      "failure_taxonomy": [
        "version_policy_failed",
        "duplicate_daily_release",
        "reliability_threshold_failed",
        "release_metadata_failed",
        "published_consumer_failed"
      ],
      "bypass": {
        "allowed": false,
        "audit": "Release identity, observability, and installed consumers must agree."
      },
      "negative_control": {
        "test": "tests/unit/scripts/release/verify-published-release.spec.ts",
        "assertion": "fails when an executor reports a mismatched version (no_output branch)"
      }
    }
  ],
  "claims": [
    {
      "source": "src/sdk/eval.ts",
      "evidence": "provider swaps (including the offline BM25 provider",
      "gate": "context-retrieval",
      "disposition": "enforced"
    },
    {
      "source": "src/cli/register-list-query.ts",
      "evidence": "Evaluate search relevance against a curated golden-query set",
      "gate": "context-retrieval",
      "disposition": "enforced"
    },
    {
      "source": "docs/COMMANDS.md",
      "evidence": "`--fail-under <0..1>` turns `pm eval` into a CI gate",
      "gate": "context-retrieval",
      "disposition": "enforced"
    },
    {
      "source": "docs/SDK_CONTEXT_INTEGRITY.md",
      "evidence": "`pnpm quality:surface-replication` activates sets from the Git changeset",
      "gate": "static-quality",
      "disposition": "enforced"
    }
  ]
}

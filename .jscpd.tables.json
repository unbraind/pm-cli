{
  "path": [
    "src",
    "packages",
    "plugins"
  ],
  "format": [
    "typescript",
    "javascript"
  ],
  "crossFormats": [
    [
      "javascript",
      "typescript"
    ]
  ],
  "mode": "strict",
  "minLines": 28,
  "minTokens": 80,
  "threshold": 0,
  "reporters": [
    "console"
  ],
  "noTips": true,
  "ignore": [
    "**/dist/**",
    "**/node_modules/**",
    "src/core/extensions/extension-types.ts",
    "packages/pm-*/extensions/*/runtime-loader.ts",
    "plugins/pm-*/scripts/pm-mcp-server.mjs"
  ]
}

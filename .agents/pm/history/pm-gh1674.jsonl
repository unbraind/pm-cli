ull_item_fields omission receipt"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-06T04:48:51.329Z"}],"before_hash":"d3acaf66082ef3041ab45d3656fc5334d3dd003f406ad8463f668b1483947161","after_hash":"417ebda41b362a64f73bf727f26bd8eafbdaa469bf6711556efacb1371ebb226","item_hash_version":3,"message":"Narrow two criteria to the shipped contract; see the scope note","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"a909a67c4c5809bd38bc83c8d4a0d7303592490f6acd721c8a49ecbbb0402ddb"}
{"hash_algorithm":"sha256","ts":"2026-11-06T04:48:52.041Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"889f14fd4f565135be7f7e17","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1663","claim:pm-gh1674","lineage:pm-gh1663","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1663+pm-gh1674","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1663","claim:pm-gh1674","lineage:pm-gh1663","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.319","source":"probe"}},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-06T04:48:52.041Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-11-06T04:48:52.041Z","author":"harness:claude-code","text":"Scope decisions made during implementation (2026-11-06). (1) items_encoding keeps json_columns and absent even when both are empty. The table-rows spec's own TOON decoder recognizes an encoding block by checking that both are arrays, and external hosts that decode TOON tables can use the same signature, so omitting them would break table detection for about 37 B per table. pm-gh1642 kept the block for the same reason. (2) completeness unchecked stays visible as one status line, because pm-6pycus requires that unchecked or partial source evidence never disappears; only the two zero unreadable counts are dropped. (3) JSON list envelopes are unchanged: default and --fields JSON already differ only by the filters.fields echo. JSON search --fields now echoes only the filters the caller set, through the same compact summary the default search uses, and keeps projection, now and mode_source in the typed result. (4) A projection whose field list disagrees with the row keys is treated as inconsistent and passes through unchanged, so the compaction never hides a producer mismatch."}]}],"before_hash":"417ebda41b362a64f73bf727f26bd8eafbdaa469bf6711556efacb1371ebb226","after_hash":"6d7bc78a084e533c9e0e6eb920bf2aeaed828152dd4d149b64be7a00489bd2bf","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"ef8fcdc0d36808f77ac537b8aa3ecd0bf5329ad159ae373320e7672c7d8a0d59"}

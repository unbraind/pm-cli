{"ts":"2026-06-16T17:23:23.003Z","author":"claude-code-agent","op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-06-16T17:23:23.003Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-06-16T17:23:23.003Z","author":"claude-code-agent","text":"Design decisions for GH-243 (pm comments edit/delete): (1) 1-based index matching list order. (2) Flags: --delete <index> and --edit <index>; replacement text from positional [text]/--add/--stdin/--file. (3) New ops comment_edit, comment_delete; allowlisted in bypassesAssigneeConflict under --allow-audit-comment. (4) Edit preserves original created_at+author, sets edited_at=nowIso(). (5) Extend runAnnotationCommand mode union with edit/delete; surface only on comments command."}]}],"before_hash":"ca242849e601d23f473224e73309ba58e4e72757e59d30e0fad58b075e5e48ad","after_hash":"de3865176c534d073132a340b4c556d7358e28718ea1ea20af540f959000868b"}

{"hash_algorithm":"sha256","ts":"2026-11-21T19:07:46.024Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-fable-5-2","agent_model_source":"probe","agent_instance":"df02aa70db5bf450de2ff7ae","agent_provenance":{"model":{"value":"claude-fable-5-2","source":"probe"},"effort":{"value":"medium","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1656","lineage:pm-gh1656","lineage:pm-9rgaal","lineage:pm-doxj"]},"topic":{"value":"pm-gh1656","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1656","lineage:pm-gh1656","lineage:pm-9rgaal","lineage:pm-doxj"]},"version":{"value":"2.1.330","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/2","value":{"created_at":"2026-11-21T19:07:46.024Z","author":"harness:claude-code","text":"Implementation evidence. New row { op: 'finalize', id, set?, unset?, match?, force? } in the BulkItemMutation union; the step lives in buildFinalizeStep (src/sdk/item-transaction.ts) and the fenced write in applyItemFinalization (src/sdk/transactions/item-finalization.ts). Decisions taken while building: (1) the event is recorded under the existing native history operation 'import' (the identity pm-github already writes for this finalization), so the declared operation vocabulary, event classification and stale-work readers need no contract change; (2) 'type' joins id, updated_at and pm_format_version as refused fields, because a probe showed set type to an unregistered name moved the document where the locator cannot find it; (3) null is refused and unset removes a field; (4) besides the reader round trip (serialize then parseItemDocument under the workspace schema), each set value must be stored in its own JSON shape, because a probe showed tags: 'a' normalizing to an empty tag list without any refusal; (5) the structured document planner keeps create/update/close/release only and now names the narrower BulkItemLifecycleMutation type, acknowledged in sdk/public-surface.json. Probe before/after on the GH reproduction: update + finalization + throw in the committing observer now ends with history create, update, import, restore, restore and the pre-batch document; the same observer writing through client.update still ends in transaction_partial_mutation (negative control kept as a spec)."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-21T19:07:46.024Z"}],"before_hash":"40cdc4e7a02ad11997ea8dcd47a9392d4b8da56c3b882cb50212d80524eb3723","after_hash":"1efa698aa727be064b3a272b7b470f2fe5cfe8faa13836e9d361f00e08c50167","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"e7cce7d4c7b9811091a0e7ab928071b9d5ef312ac03056942fc264d4ea7016e5"}

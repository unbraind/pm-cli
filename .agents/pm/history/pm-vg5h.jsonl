{"ts":"2026-05-01T19:14:49.621Z","author":"cursor-agent","op":"comment_add","patch":[{"op":"replace","path":"/front_matter/updated_at","value":"2026-05-01T19:14:49.621Z"},{"op":"add","path":"/front_matter/comments","value":[{"created_at":"2026-05-01T19:14:49.621Z","author":"cursor-agent","text":"Fix applied: when --include resolves to events-only (no deadlines/reminders) and no explicit --to, --occurrence-limit, or --recurrence-lookahead-days is set, the recurrence lookahead now defaults to 28 days instead of 365. A warning 'recurring_events_default_cap_applied:28d' is added to the result so agents/users know the cap was applied and can override with explicit flags. When any explicit bound is provided, the full 365-day default is preserved. Tests: 14/14 calendar-command.spec.ts passed. Build: clean."}]}],"before_hash":"e454e251c87449d1a2dbc616b5d82a9e886edac7a62985034676934c61bd421c","after_hash":"bcb9e74fb0b4d11df80896495773b2d75d9a6b7e32931b3ecc5c48dccf1087c9"}

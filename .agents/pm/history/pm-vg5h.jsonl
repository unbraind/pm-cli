{"ts":"2026-05-01T18:59:53.408Z","author":"maintainer-agent","op":"create","patch":[{"op":"add","path":"/front_matter/id","value":"pm-vg5h"},{"op":"add","path":"/front_matter/title","value":"pm cal --include events|scheduled expands recurring events without default cap"},{"op":"add","path":"/front_matter/description","value":"When using --include events (or the new --include scheduled alias) without --occurrence-limit or --to, pm calendar expands recurring events across the full lookahead window (default 365 days). A weekly recurring event generates 52+ calendar rows. Agents calling this without bounds get unexpectedly large output. Should apply a sensible default cap (e.g., 4 weeks / 28 days) for the events-only filter, or warn when expansion exceeds a threshold."},{"op":"add","path":"/front_matter/type","value":"Issue"},{"op":"add","path":"/front_matter/status","value":"open"},{"op":"add","path":"/front_matter/priority","value":2},{"op":"add","path":"/front_matter/tags","value":["agents","calendar","performance","recurring","ux"]},{"op":"add","path":"/front_matter/created_at","value":"2026-05-01T18:59:53.408Z"},{"op":"add","path":"/front_matter/updated_at","value":"2026-05-01T18:59:53.408Z"},{"op":"add","path":"/front_matter/author","value":"maintainer-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"5f26cfaf8653d3493f254208e635434b1823bfc513ca4d0549c1a8e7af99010e","message":""}

d","path":"/metadata/files/9","value":{"path":"tests/unit/core/telemetry/telemetry-runtime.spec.ts","scope":"project"}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-01T11:26:14.027Z"}],"before_hash":"b9bad4d7318131b8d55ba80b85a2b5d872c1ae1b1105c2390dec83be5b2d9e3b","after_hash":"cefd4f20adc75c2dbd3e2bff612b49bd6fe8aada46bc90690e1ad525f17ae828","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"maintenance","record_hash_version":1,"record_hash":"77381ce7660b41216c0281f9976e8dd9a2846e66a553bb12652d8844f8c5067c"}
{"hash_algorithm":"sha256","ts":"2026-11-01T11:26:14.659Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"489489c9e2938b0738fed20a","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-4zpq71","claim:pm-fr10t8","claim:pm-gh1580","claim:pm-gh1647","lineage:pm-fr10t8","lineage:pm-yql1","lineage:pm-n7rr","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"workset:pm-4zpq71+pm-fr10t8+pm-gh1580+pm-gh1647","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-4zpq71","claim:pm-fr10t8","claim:pm-gh1580","claim:pm-gh1647","lineage:pm-fr10t8","lineage:pm-yql1","lineage:pm-n7rr","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.316","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-01T11:26:14.659Z","author":"harness:claude-code","text":"Follow-up from the full suite: three AUTOMATIC writers also acted on the defaults fallback. They are the mutation preflight item_format pin (src/cli/migration-gates.ts), the telemetry installation-id write (src/core/telemetry/runtime.ts ensureInstallationId) and the first-run consent prompt (src/core/telemetry/consent.ts). Before this change, each of them silently replaced an unreadable settings.json with defaults. cli-main-errors.spec even asserted that a {version:1} document was rewritten with item_format toon. With the new refusal, the pin would have blocked every mutation command on a tracker with schema-invalid settings. New public helper isSettingsReadFallback(settings), exported from the SDK runtime primitives: the three automatic writers now skip their write when settings are a fallback. The command runs on the defaults with the existing warning, telemetry captures nothing until the global settings are readable, and the consent prompt is not shown because its answer could not be recorded. User-requested writes (config, schema, package install, init on an existing tracker) keep the field-naming refusal. Tests: the cli-main-errors expectation now asserts the document is byte-identical, and telemetry-consent.spec and telemetry-runtime.spec each gained an unreadable-global-settings case.\n"}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-01T11:26:14.659Z"}],"before_hash":"cefd4f20adc75c2dbd3e2bff612b49bd6fe8aada46bc90690e1ad525f17ae828","after_hash":"782cbdab682890bbee68a1feae54acb557d6ee64f15f457d1cd163fda8398c93","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"2105467d165dfab50c1d35da92810f0faa1c6c9871878a33e14d05d5d8bef786"}

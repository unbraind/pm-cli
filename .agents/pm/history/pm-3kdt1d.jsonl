y"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-22T10:03:52.854Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-22T10:03:52.854Z"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/estimated_minutes","value":45},{"op":"add","path":"/metadata/acceptance_criteria","value":"The gate reads the synthetic tracker as settled, one racy window after it was written, through the summary's wall-clock seam; Six consecutive runs on an unchanged tree pass against the approved report without regenerating it; The racy window itself is unchanged for every product read"},{"op":"add","path":"/metadata/parent","value":"pm-u9d0"},{"op":"add","path":"/metadata/risk","value":"low"},{"op":"add","path":"/metadata/confidence","value":"high"},{"op":"add","path":"/metadata/expected_result","value":"The calibration gate reports the same bytes on every run of an unchanged tree"},{"op":"add","path":"/metadata/actual_result","value":"The 2243-item orientation session alternates between 32724 and 32816 delivered bytes and the gate fails most runs"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"3086b60b38b6b0b2f452973420bad334e983b5b348ccd03726d3b72c3dcf3464","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"f6873420a2a6ca52be7cb4fa952b26b6b4bf3f6ed60efbf01106991495691c1d"}

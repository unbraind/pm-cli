adata/goal","value":"project management = context management"},{"op":"add","path":"/metadata/objective","value":"Make deterministic workspace execution reachable from every supported process transport without global monkey-patching"},{"op":"add","path":"/metadata/value","value":"Conformance, golden-file, replay, and cross-language harnesses can compare authoritative pm bytes through supported interfaces"},{"op":"add","path":"/metadata/why_now","value":"GitHub issue 1089 demonstrates that the closed SDK recipe feature leaves binary consumers on the original nondeterministic path"},{"op":"add","path":"/metadata/parent","value":"pm-usfg"},{"op":"add","path":"/metadata/risk","value":"medium"},{"op":"add","path":"/metadata/confidence","value":"high"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-9rgaal","kind":"implements","created_at":"2026-08-22T12:29:57.227Z","author":"harness:codex","source_kind":"cli:create:dep","author_source":"detected"},{"id":"pm-rbcvt2","kind":"discovered_from","created_at":"2026-08-22T12:29:57.227Z","author":"harness:codex","source_kind":"cli:create:dep","author_source":"detected"},{"id":"pm-usfg","kind":"implements","created_at":"2026-08-22T12:29:57.227Z","author":"harness:codex","source_kind":"cli:create:dep","author_source":"detected"}]},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-22T12:29:57.227Z","author":"harness:codex","text":"Duplicate check 2026-08-22: certified full read covered 2534/2534 items across open closed and canceled with no omissions or unreadable records; exact,fuzzy,GitHub-number,process-environment,deterministic CLI/MCP,and parent-scope searches found the closed SDK-only owner pm-rbcvt2 and no process-transport owner. This item records the distinct post-close GH-1089 boundary gap."}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"127e1e6a7e327aefbff3e9a81cc6024df5a2aa6260b218ff731985b95683b8fd","item_hash_version":2,"message":""
_GUIDE.md calls the baseline published evidence. Result: base distribution 19,989,811 of 20,000,000 B (10,189 B headroom, 1,589 files), and the Sentry-injected simulation at 20,270,125 of 20,300,672 B."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-11T08:01:09.450Z"}],"before_hash":"0e9c083c8760731d591adc78903a75df8a460309159b6e8bc53cb4b263d26aab","after_hash":"4ff4d99a6bcfbcab741ef8f8a812e28b3df2a61bc381c75bc43c3ee1005f72d4","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"db4793befdce4a8e166f7c174c78ad27caf4a65bfb7294505133603a344d3e24"}

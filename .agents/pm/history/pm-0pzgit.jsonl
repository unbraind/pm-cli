created_at":"2026-08-03T06:31:56.940Z","author":"harness:claude-code","source_kind":"cli:update:dep","author_source":"detected"},{"id":"pm-zclzll","kind":"related","created_at":"2026-08-03T06:31:56.940Z","author":"harness:claude-code","source_kind":"cli:update:dep","author_source":"detected"}]}],"before_hash":"6b4dc66c5c73affdf4486c0ff83802690a106dc8ab0e8a6cf50371e4ab5fd131","after_hash":"7abde2930c46435ef0b6e260b22b46608f348b8464330d0c545a4fe2011aff9d","message":"Wire the boundary-fixture gate into defect-escape, mutation-testing, and format-conformance lineage"}

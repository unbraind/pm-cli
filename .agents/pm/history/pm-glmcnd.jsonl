":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/estimated_minutes","value":45},{"op":"add","path":"/metadata/acceptance_criteria","value":"The publication gate downloads the selected binding again after a bounded wait when the provider answers HTTP 404, each attempt into a fresh directory; Any other download failure, and a 404 that outlasts the wait, is refused at once with the provider's error; the downloaded file is verified exactly as before; A spec drives trailing 404 downloads, a persistent 404 and a non-404 failure through the gate and proves the waits and refusals; GH-1788 carries a root-cause comment naming this item"},{"op":"add","path":"/metadata/parent","value":"pm-u9d0"},{"op":"add","path":"/metadata/risk","value":"low"},{"op":"add","path":"/metadata/confidence","value":"high"},{"op":"add","path":"/metadata/expected_result","value":"A producer binding listed in the complete inventory is downloaded and verified, and the release is pushed"},{"op":"add","path":"/metadata/actual_result","value":"gh run download answered HTTP 404 1.5 s after the upload finalized, and the gate refused the release"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-jvb9pk","kind":"discovered_from","created_at":"2026-11-26T14:22:25.576Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"c0c2bf7d7d0477408099232719539fa6434de9fd752664c6bd6c37082ead6323","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"1ce8fdf1fa11dfe64811f58fff25a445fc066201ffe804f68f41c431316cea3a"}

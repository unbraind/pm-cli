 items outside that status, so active_items equals open plus in_progress whenever the progress status carries the active role. ContextSummary, COMMANDS.md and MUTATION_INTEGRITY.md document the population; contract_change declares the non-default-workflow difference."},{"op":"add","path":"/metadata/close_reason","value":"pm context counts in_progress and both in-progress advisories over one population"}],"before_hash":"f5935cf6a8a5abae8067d3f2e74cdc41d73b07839822c7f3cc5be8f53bd1f766","after_hash":"775303ef220cfcfc32d3501a996fb889bcebd7a631060eb0f0f7ed21a641a8d9","item_hash_version":3,"context":{"completion":{"timestamp":"2026-11-20T05:12:58.002Z","source":"close_time"},"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"78f8453afae9bc47d5035651f4a5979cffe01843cbd4bd628907f7ad4842c769"}

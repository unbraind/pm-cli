{"hash_algorithm":"sha256","ts":"2026-11-08T13:07:46.849Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"1c7226cdcb831e4341d98ac7","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-e3hfv8","claim:pm-fkhdy8","claim:pm-rrwh2o","claim:pm-sbqn4h","lineage:pm-sbqn4h","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"workset:pm-e3hfv8+pm-fkhdy8+pm-rrwh2o+pm-sbqn4h","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-e3hfv8","claim:pm-fkhdy8","claim:pm-rrwh2o","claim:pm-sbqn4h","lineage:pm-sbqn4h","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.319","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-08T13:07:46.849Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-08T13:07:46.848Z","author":"harness:claude-code","text":"Implementation evidence, branch fix/annotation-read-fidelity. Reproduced on main dbe6be164: a sandbox item with comments [object, null, 42] rendered comments[2] beside count 3 in TOON, while --json delivered all three rows. Fix: src/sdk/read-output/positional-rows.ts declares PM_READ_OUTPUT_POSITIONAL_ROW_PATHS (comments, notes and learnings, the collections --edit and --delete address by absolute index) and readOutputPositionalRowPaths(surface). nativeRenderer in src/core/output/output.ts resolves the read surface, so the item namespace form 'pm item comments' resolves too, and passes the paths to formatBuiltInOutput. There, restorePositionalRows re-delivers every row of a declared path, compacting each row as the sparse policy compacts a row object, so a null renders as '- null'. It runs only when some row would be dropped, so a well-formed listing renders byte-for-byte as before. The general TOON null-dropping contract is unchanged for every other payload: the spec's negative control shows the same listing without the declaration still renders comments[2]. JSON is unchanged. Verified with the built CLI: pm comments, pm item comments --limit 2 and --limit 1 render one row per delivered entry. A non-object row in a --limit page still carries no index field; its address is its position counted back from total_count. pm-yo46im's validate clause is the repair path."}]}],"before_hash":"93009715e933570a2d3bfae7124fa9d6aec8fb038b241343570e76698ea009ab","after_hash":"88fe03bb3940f17e871e0278c7d856b258ace7f29f948cf4013cd2bad11c8ce8","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"2e50ca775a4acd361394f5b4681bcd7be63a40111ae6e4f6e99f73567d696a14"}

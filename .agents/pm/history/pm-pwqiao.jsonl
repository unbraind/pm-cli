{"hash_algorithm":"sha256","ts":"2026-11-11T06:43:25.190Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"e6ba0f6f7044b066fe23d5ec","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-4yxzvd","claim:pm-gh1700","claim:pm-oglm0t","claim:pm-pwqiao","claim:pm-tuxw1i","lineage:pm-oglm0t","lineage:pm-f05lsg","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"workset:pm-4yxzvd+pm-gh1700+pm-oglm0t+pm-pwqiao+pm-tuxw1i","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-4yxzvd","claim:pm-gh1700","claim:pm-oglm0t","claim:pm-pwqiao","claim:pm-tuxw1i","lineage:pm-oglm0t","lineage:pm-f05lsg","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.322","source":"probe"}},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-11T06:43:25.190Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-11-11T06:43:25.190Z","author":"harness:claude-code","text":"Implementation on branch fix/collection-mutation-receipts (2026-11-11). runLinkedArtifacts parses --add entries through parseAddEntriesWithNoteRecovery. When parsing refuses, the first failing entry is located and findMisreadNoteSegment is asked three questions:\n- Does the entry carry note= or note: ?\n- Does a later comma segment open with an identifier followed by = or : (URLs excluded)?\n- Does the link alone, the text before note, parse cleanly?\n\nOnly then is the refusal rethrown as linked_artifact_note_key_misread. The message names the segment and key, and details carries entry_index, misread_segment, misread_key, note and cause. recovery.suggested_retry_args and nextSteps hold the same link with the prose moved to --note; --note takes it verbatim, and the retry is rendered with resolvePmCommandScopeArgs. The retry also carries --append-stable (files only), --author, --message and --force. required says that other entries of a refused multi-entry invocation were not written.\n\nEvery other refusal keeps its message: a typo key with no note (GH-258 lable=main), or an invalid link such as scope=bogus.\n\nEvidence. Executing the emitted retry against a sandbox tracker links a.txt with the full note text in all three variants:\n- the generic invalid-entry refusal ('host:port, whitespace');\n- the unknown-key refusal (note ending 'host:port');\n- the repeated-key refusal from pm-oglm0t ('path: b.txt').\n\nSpecs: tests/unit/sdk/linked-artifact-note-recovery.spec.ts."}]}],"before_hash":"8f2bde1ff8e47389cb0a8903c6ee308c4aa1adc247de338f94cd4292b0add674","after_hash":"95dbe49935e6c7f56feaf23745fa1330f5d54e2885aae9456d4497906b04fe73","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"b59c846c17a78f5a876f9fedad6892d7cd7caa3c4a136ab02c564e7184cae628"}

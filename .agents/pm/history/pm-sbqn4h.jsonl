{"hash_algorithm":"sha256","ts":"2026-11-08T13:07:49.464Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"1c7226cdcb831e4341d98ac7","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-e3hfv8","claim:pm-fkhdy8","claim:pm-rrwh2o","claim:pm-sbqn4h","lineage:pm-sbqn4h","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"workset:pm-e3hfv8+pm-fkhdy8+pm-rrwh2o+pm-sbqn4h","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-e3hfv8","claim:pm-fkhdy8","claim:pm-rrwh2o","claim:pm-sbqn4h","lineage:pm-sbqn4h","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.319","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-08T13:07:49.464Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-08T13:07:49.463Z","author":"harness:claude-code","text":"Implementation evidence, branch fix/annotation-read-fidelity. runMcpCommentsAction set an implicit producer limit of 20 on every listing. That predates the universal output budget. pm_notes and pm_learnings never had one, and neither does the CLI. Now a listing only sets includeMeta (total_count, has_more) and leaves the bound to the default output budget, whose ordered_suffix retention keeps the newest comments and issues a backward cursor. Keeping the implicit page was rejected: a cursor continuation cannot widen the producer page without changing the row fingerprint the cursor is bound to. Measured on a sandbox item with 30 comments of about 310 characters each through tools/call: page 1 returned indexes 12-30 with has_more true and next_cursor; page 2 returned 1-11 with has_more false and no cursor. Before the change the same walk stopped at index 11 of the 20-row page with has_more true and no cursor. options.limit=N still returns only the newest N, with total_count and has_more. The pm_comments tool description and the contract snapshot were updated, and docs/READ_OUTPUT_CONTRACTS.md records the change. The spec follows next_cursor alone from index 30 to index 1 and asserts has_more equals the presence of a cursor on every page."}]}],"before_hash":"3c8ac3e1e2730713319b6f7387e56c7b57cd9f51973b827d0a19445c12b90086","after_hash":"7af203398c175dcde46e73e81c48d134037ffc443fd8a9484c3f87aa69095f69","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"11e5711a3a41b5553d0de802226180ccfb1d6f8d403c0400801da3b4ef419e37"}

he default output budget, whose ordered_suffix retention keeps the newest comments and issues a backward cursor, exactly like pm_notes, pm_learnings and the CLI. options.limit=N still selects the newest N. The pm_comments tool description, the contract snapshot and docs/READ_OUTPUT_CONTRACTS.md record the change."},{"op":"add","path":"/metadata/close_reason","value":"Fixed: MCP pm_comments listings apply no producer page, so following next_cursor alone reaches the oldest comment"}],"before_hash":"ac959f38241c1fdd64e2d9d34a836a583325aedd26a4f547eb0bfa668d0f0f9f","after_hash":"eeaf4a4cb16bea55c4a3be0638990a3cf7f4f54527b6101799b7c909a9b527cd","item_hash_version":3,"context":{"completion":{"timestamp":"2026-11-08T13:44:58.261Z","source":"close_time"},"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"119366c293f4d11dc9723b987b10b9ba52ed50c0b7408ea3edf01813d003ba61"}
{"hash_algorithm":"sha256","ts":"2026-11-08T13:45:07.747Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"1c7226cdcb831e4341d98ac7","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"release-operator","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-sbqn4h","release:pm-rrwh2o"]},"topic":{"value":"pm-sbqn4h","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-sbqn4h","release:pm-rrwh2o"]},"version":{"value":"2.1.319","source":"probe"}},"op":"release","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-08T13:45:07.747Z"}],"before_hash":"eeaf4a4cb16bea55c4a3be0638990a3cf7f4f54527b6101799b7c909a9b527cd","after_hash":"c15fa719566a0e8bea970d8d4cfffa6e5309f673365ba7a705ccfddee43292f3","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"maintenance","record_hash_version":1,"record_hash":"c36fd7daebf9fda57108c7df5537f3e099b712ab20be7d0dbdcbb0e847ac597a"}
{"hash_algorithm":"sha256","ts":"2026-11-08T14:41:06.003Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"1c7226cdcb831e4341d98ac7","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.319","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-08T14:41:06.001Z","author":"harness:claude-code","text":"CodeRabbit review of PR 1688. Fixed: the pm_comments tool description and docs/READ_OUTPUT_CONTRACTS.md now say that an explicit options.limit window can report has_more without a cursor, because the caller chose that window and raises or removes the limit to read older comments. outputBudget unbounded returns the complete listing at once, and options.full=true returns the complete history after a write; on a listing, full no longer means anything distinct. The runMcpCommentsAction JSDoc no longer mentions twenty entries. Declined with measurement: the Major about fitting work on very large histories. On a sandbox item with 5,000 comments of about 150 B, the default MCP listing took 1,078 ms, against 833 ms with limit 20 and 765 ms for a 30-comment item; the CLI listing took 713 ms. At 20,000 comments the figures were 1,570 ms default, 1,129 ms with limit 20 and 1,340 ms for a cursor page, against 1,660 ms on the CLI. The cost is linear and dominated by parsing the item document, which a limit does not avoid, and the CLI, pm_notes and pm_learnings already run the same path. A bounded producer cursor for annotation windows is the structural fix, the same design pm-gh1679 owns for item history."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-08T14:41:06.003Z"}],"before_hash":"c15fa719566a0e8bea970d8d4cfffa6e5309f673365ba7a705ccfddee43292f3","after_hash":"d61c466f457a65675c28dbf2327351c531fed1a9dbcfa0e386750aa3238abc6a","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"7dd6e7dbc84840cda5f7545041a63e71fa3ad9866e43714e2d6346be55c46ac8"}
{"hash_algorithm":"sha256","ts":"2026-11-08T16:02:54.530Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"1c7226cdcb831e4341d98ac7","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.319","source":"probe"}},"op":"update","patch":[{"op":"replace","path":"/metadata/expected_result","value":"Following next_cursor alone reaches the oldest comment of a listing without an explicit limit, and has_more is true there only while a continuation is present; with options.limit or outputLimit the caller chose the window, so has_more can report older comments without a cursor"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-08T16:02:54.530Z"}],"before_hash":"d61c466f457a65675c28dbf2327351c531fed1a9dbcfa0e386750aa3238abc6a","after_hash":"c194183e2ae44b83b36df0fa6da67ffdeb486f9c57205faaca3cac1c20ea47b2","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"maintenance","record_hash_version":1,"record_hash":"38fed94deea6dbe2bbf0bf79001a5ce6da2901924109c7fa730a419ec8f002b4"}
{"hash_algorithm":"sha256","ts":"2026-11-08T16:07:56.085Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"1c7226cdcb831e4341d98ac7","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.319","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/2","value":{"created_at":"2026-11-08T16:07:56.085Z","author":"harness:claude-code","text":"CodeRabbit re-review of PR 1688. expected_result is now qualified: the cursor guarantee holds for listings without an explicit limit; with options.limit or outputLimit the caller chose the window, so has_more can report older comments without a cursor. docs/READ_OUTPUT_CONTRACTS.md documents the outputLimit case too. Tests tightened: the MCP walk asserts that the first page carries a string next_cursor (so the walk really pages), the limited response asserts that it offers no cursor, and the integration test now passes a numeric options.limit."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-08T16:07:56.085Z"}],"before_hash":"c194183e2ae44b83b36df0fa6da67ffdeb486f9c57205faaca3cac1c20ea47b2","after_hash":"9ef3250650dae3eb9bb54d050eb5f9ecc28b9584d1f9778922c4d119616397bc","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"5665fc092cdade020779ca9c29e62fd6029b9e65a21c31c48f79154454dcc6cc"}

{"hash_algorithm":"sha256","ts":"2026-11-12T08:56:29.398Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1704","claim:pm-gh1707","lineage:pm-gh1707","lineage:pm-qwoy","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1704+pm-gh1707","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1704","claim:pm-gh1707","lineage:pm-gh1707","lineage:pm-qwoy","lineage:pm-doxj"]},"version":{"value":"2.1.322","source":"probe"}},"op":"close","patch":[{"op":"replace","path":"/metadata/actual_result","value":"secret-policy-parity: 17 keys x 3 spellings plus XML flag credential_key_assignment; 19 must-allow cases stay clean; block mode refuses; 422 secret-guard tests pass and every changed line is covered"},{"op":"replace","path":"/metadata/expected_result","value":"Every row of the GH-1704 table flags in all three spellings plus XML; the must-allow corpus stays clean"},{"op":"remove","path":"/metadata/claim_principal"},{"op":"remove","path":"/metadata/assignee"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T08:56:29.398Z"},{"op":"replace","path":"/metadata/status","value":"closed"},{"op":"add","path":"/metadata/closed_at","value":"2026-11-12T08:56:29.386Z"},{"op":"add","path":"/metadata/completed_at","value":"2026-11-12T08:56:29.386Z"},{"op":"add","path":"/metadata/resolution","value":"New mutation-only secret rule credential_key_assignment in src/core/shared/secret-rules.ts. It covers keys whose last word names a credential (secret, token, api/secret/private/access key, client secret, passwd, pwd) and underscore compounds such as DB_PASSWORD, aws_secret_access_key and GITHUB_TOKEN, in key: v, key=v, JSON, Python-dict and XML-element spellings through the GH-1699 structured pass. Values need 8 or more whitespace-free characters and entropy of at least 3 bits per character, and must not be placeholders (<...>, ${...}, $(...), $VAR, %VAR%, [scrubbed]), paths, dotted member paths or calls. Plain and hyphenated password keys stay with password_assignment, so each value is reported once. The repository scan is unchanged because the rule is mutation-only."},{"op":"add","path":"/metadata/close_reason","value":"A short credential under any credential-named key is now flagged in every spelling while pm fields, placeholders and prose stay clean"}],"before_hash":"8ff103e2a24e1766748989a099f11b1f59129b58312858654d10ac1765f4fe5d","after_hash":"d2cd47363eaf6772f5c998a0351049498925bceb349118e0113341e8ac4aa9ca","item_hash_version":3,"context":{"completion":{"timestamp":"2026-11-12T08:56:29.386Z","source":"close_time"},"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"cf291ac938aee90a793f2deb49ec7e7e0a379cb81bc8a2f4999c45b01af6d73c"}

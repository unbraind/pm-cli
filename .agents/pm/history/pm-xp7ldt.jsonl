{"hash_algorithm":"sha256","ts":"2026-11-22T01:53:55.818Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-fable-5-2","agent_model_source":"probe","agent_instance":"8fcf1176eceedef40be11ce4","agent_provenance":{"model":{"value":"claude-fable-5-2","source":"probe"},"effort":{"value":"medium","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-998juj","claim:pm-xp7ldt","claim:pm-zi34i1","lineage:pm-xp7ldt","lineage:pm-9rgaal","lineage:pm-doxj"]},"topic":{"value":"workset:pm-998juj+pm-xp7ldt+pm-zi34i1","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-998juj","claim:pm-xp7ldt","claim:pm-zi34i1","lineage:pm-xp7ldt","lineage:pm-9rgaal","lineage:pm-doxj"]},"version":{"value":"2.1.330","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/2","value":{"created_at":"2026-11-22T01:53:55.817Z","author":"harness:claude-code","text":"Implemented on branch fix/sdk-admission-scope-identity. dispatchAction now calls assertNativeUpdateManyOptions (src/sdk/runtime/mutation-admission.ts) for a native update-many before the handler runs. It reads the caller's own option keys before any normalization copy, so an own __proto__ key is judged, and refuses an undeclared key with the message, nearest-name hint and typed context a single update gives for the same key. With a nested update record, the record's keys are judged as update options and every outer key must select rows or control the run; an update field left outside is refused with its update.<key> placement instead of being ignored. Finding while writing the spec: the bulk path applies a runtime schema field only when the field is declared for update_many (collectRuntimeUpdateFieldValues in update-many.ts), so a field declared for update alone was also dropped without notice. Admission therefore accepts runtime fields by the update_many declaration, not the update one. MCP transport input returns before the check. Proof: tests/integration/sdk/mutation-admission.integration.spec.ts, case 'refuses an undeclared update-many key by name before any row changes, as a single update does'."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-22T01:53:55.818Z"}],"before_hash":"9bbbbe2379ff6554940eda30d7c8a2e6cfe02a5b45793e961ddae7a25f013f11","after_hash":"0e916a2dc50c5af5e1e5a214c1a313ebfd0cdf8e70917585cc6c6c31bbbcf3f7","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"2176a3ee34713fd999f2a19d503f025e0a013060ca96ed82289eed566fb92726"}

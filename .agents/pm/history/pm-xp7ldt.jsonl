{"hash_algorithm":"sha256","ts":"2026-11-21T19:34:43.782Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-fable-5-2","agent_model_source":"probe","agent_instance":"df02aa70db5bf450de2ff7ae","agent_provenance":{"model":{"value":"claude-fable-5-2","source":"probe"},"effort":{"value":"medium","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1656","claim:pm-w7clh6","lineage:pm-w7clh6","lineage:pm-9rgaal","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1656+pm-w7clh6","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1656","claim:pm-w7clh6","lineage:pm-w7clh6","lineage:pm-9rgaal","lineage:pm-doxj"]},"version":{"value":"2.1.330","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-xp7ldt"},{"op":"add","path":"/metadata/title","value":"update-many ignores an unknown flat update key where a single update refuses it by name"},{"op":"add","path":"/metadata/description","value":"Observed while fixing typed null handling in update-many. runAction('update-many', { options: { ids: [id], bogus: 'x', description: 'changed' } }) changes the description and reports one updated row; the unknown key is dropped without a warning. The same payload through runAction('update') refuses with: Unknown update option \"bogus\". Did you mean \"body\"? No changes were made. The GH-1520 admission check covers native create and update only, so a misspelled bulk field (for example asignee) is silently not applied to any matched row."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":3},{"op":"add","path":"/metadata/tags","value":["admission","area:sdk","honesty","update-many"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-21T19:34:43.782Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-21T19:34:43.782Z"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/estimated_minutes","value":90},{"op":"add","path":"/metadata/acceptance_criteria","value":"runAction update-many refuses an undeclared flat update key by name with the nearest declared key before any row changes, in the flat and nested spellings; Declared aliases, runtime schema fields and extension fields stay accepted; MCP update-many keeps its transport contract; A spec proves parity with the single update refusal for the same key"},{"op":"add","path":"/metadata/parent","value":"pm-9rgaal"},{"op":"add","path":"/metadata/risk","value":"low"},{"op":"add","path":"/metadata/confidence","value":"high"},{"op":"add","path":"/metadata/expected_result","value":"An unknown update key in an update-many payload is refused by name, as a single update refuses it"},{"op":"add","path":"/metadata/actual_result","value":"The unknown key is dropped and the remaining fields are applied to every matched row"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-fl3phm","kind":"related","created_at":"2026-11-21T19:34:43.782Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"},{"id":"pm-w7clh6","kind":"discovered_from","created_at":"2026-11-21T19:34:43.782Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"}]},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-21T19:34:43.782Z","author":"harness:claude-code","text":"Duplicate check: pm search for 'update-many unknown option key silently ignored' returned the closed GH-1520 item (create and update admission, not bulk) and no open item for the bulk path."}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"5d555cbca96372baf0b5e8471ddf29017e88dcd5abaaa4600fc7900331cd23a0","item_hash_version":3,"message":"","context":{"agent_prov
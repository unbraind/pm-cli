ith a Git-free PATH."}]}],"before_hash":"7ef1a2e0a0f7f6846c959c9c829205b64af669b3f8bbddf614f97ea6b69781ba","after_hash":"0603d85f355bca236c15c781dbe4f017b80717495dea8519890d9ab0d7ef0c2e","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"20015649bf36f1fa7f3777643a2816c7b37275d366a2b3b4ea9f2f9d56f22a61"}

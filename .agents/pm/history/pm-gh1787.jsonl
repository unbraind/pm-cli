{"hash_algorithm":"sha256","ts":"2026-11-26T14:58:07.559Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"bde5973a64851be416b1c911","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1781","claim:pm-gh1787","claim:pm-glmcnd","claim:pm-jzrtsr","lineage:pm-gh1787","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1781+pm-gh1787+pm-glmcnd+pm-jzrtsr","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1781","claim:pm-gh1787","claim:pm-glmcnd","claim:pm-jzrtsr","lineage:pm-gh1787","lineage:pm-doxj"]},"version":{"value":"2.1.332","source":"probe"}},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-26T14:58:07.559Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-11-26T14:58:07.558Z","author":"harness:claude-code","text":"Root cause: findSourceRepositoryRoot walked up to any .git marker and ignored GIT_CEILING_DIRECTORIES. Fix follows Git's own discovery rule, checked against git rev-parse --show-toplevel for nine scenarios: the start directory is always examined, the walk never moves up into a ceiling, only absolute entries count (path.delimiter separated), entries are resolved to physical paths up to the first empty entry and kept as spelled after it, and Git compares them with the physical directories it walks, so an unresolved entry spelled through a symbolic link never matches. Returned coordinates keep their existing logical spelling. Covered by tests/unit/extensions/portable-workspace-ceiling.spec.ts (real directories and a link or junction) and an end-to-end case in extension-host-contracts.integration.spec.ts that runs an installed extension command with Git on PATH and with a Git-free PATH."}]}],"before_hash":"7ef1a2e0a0f7f6846c959c9c829205b64af669b3f8bbddf614f97ea6b69781ba","after_hash":"0603d85f355bca236c15c781dbe4f017b80717495dea8519890d9ab0d7ef0c2e","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"20015649bf36f1fa7f3777643a2816c7b37275d366a2b3b4ea9f2f9d56f22a61"}

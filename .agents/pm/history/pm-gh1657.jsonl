{"hash_algorithm":"sha256","ts":"2026-11-06T04:55:55.428Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"889f14fd4f565135be7f7e17","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1663","claim:pm-gh1674","lineage:pm-gh1663","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1663+pm-gh1674","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1663","claim:pm-gh1674","lineage:pm-gh1663","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.319","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-06T04:55:55.428Z","author":"harness:claude-code","text":"Evidence for the release-time check (2026-11-06): pm-gh1663 changes the public SDK contract in the next Unreleased window. Before: GetResult.linked always carried files, tests and docs, and a nested selector padded unrequested groups with []. After: a nested selector (linked.files, claim_state.claimed) returns only the members it names, linked members are optional and claim_state is Partial; the omission receipt names populated siblings as <facet>.<member>. Migrate: read linked.<group> with optional chaining or ?? [], or request the whole linked selector. The sdk/public-surface.json acknowledgment carries the same line. Until this item ships, that acknowledgment and docs/GET_READ_EVIDENCE.md are the only migration record, because the changelog renders the item title under Fixed."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-06T04:55:55.428Z"}],"before_hash":"8420d9e5c826eb5ab82af12d69d3c8ff319192bf0de6110b453fa2b52386538a","after_hash":"c1a4772c4943355b803b662ad299706f739
{"hash_algorithm":"sha256","ts":"2026-11-08T18:17:52.826Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"1c7226cdcb831e4341d98ac7","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.319","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-08T18:17:52.826Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-08T18:17:52.825Z","author":"harness:claude-code","text":"Scope note from the CodeRabbit review of PR 1688. 'pm files discover <id> --note \"context\" --output-limit 5' is a read-only preview without --apply, yet read_output_mutation_conflict refuses it. HYBRID_READ_MUTATION_KEYS has listed note as a files mutation key since before PR 1688, and discover mode is not distinguished. Once files discover has its own contract entry, the guard can treat note as a mutation only together with --apply."}]}],"before_hash":"d65f6e6ad6662b8bc94a008ecd93f291df795d457e87b5be16ce5c8a3ffe8b51","after_hash":"03cccf1b0abbbc2830a76f2c6117ffdce79b7b517887439111a705d0cf791dda","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"e04f6b6929ffa67b725c3719b3771246441ec5a53ae849d95fa1c44d0fa98565"}

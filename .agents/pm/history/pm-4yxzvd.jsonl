et blocked_by for multi-edge items. The close pending-unblock docs and the unblock recipe guidance describe the scoped clear. Removal helpers moved to src/sdk/lifecycle/dependency-removal.ts."},{"op":"add","path":"/metadata/close_reason","value":"Clearing the blocked_by scalar removes only the rows naming its own target, kind=<kind> alone is the explicit kind-wide removal, and every dependency removal is named in a dependencies_removed warning"}],"before_hash":"2321cf8d3717f46a3a194f35087a6ea20374df82f305a785ddb7905361a24b97","after_hash":"187432618a6aa656b9296101f6b869e7a9d84445878e165d3758ba5c4fcdf60d","item_hash_version":3,"context":{"completion":{"timestamp":"2026-11-11T08:02:16.177Z","source":"close_time"},"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"68d51f6da9edee09b26f966a403c8257ba0e59f4024b52bd4e744d9dea91bb23"}

 a third)."}]}],"before_hash":"aaff76888dae591037ead69384411016914f983948a9bd4e0c43ea981c2b797d","after_hash":"ed8ce553db3b5c17bb000c497d3113e83815faf4049134fddccb70ea8ab5e32b","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"064f31ee682b70504b1f0380f1795bc3e9d68a7d6143d9bb3118114b8c25473e"}

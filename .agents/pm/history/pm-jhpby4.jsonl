":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-20T20:11:18.429Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-20T20:11:18.429Z"},{"op":"add","path":"/metadata/author","value":"harness:codex"},{"op":"add","path":"/metadata/acceptance_criteria","value":"The existing blocks ceiling is retargeted to total blocks minus evidence-cited blocks; Evidence-cited blocks receive an independent non-regression floor; Both assertions carry executable boundary negative controls and remain blocking in graph-composition"},{"op":"add","path":"/metadata/goal","value":"Provable history"},{"op":"add","path":"/metadata/objective","value":"Keep anti-fabrication and recovered ordering simultaneously enforceable"},{"op":"add","path":"/metadata/value","value":"Evidence-backed historical ordering can grow without weakening graph governance"},{"op":"add","path":"/metadata/impact","value":"Unblocks pm-c90tfh and its three ordering-lineage dependents"},{"op":"add","path":"/metadata/outcome","value":"Provenance-partitioned blocking assertions replace one contradictory global count"},{"op":"add","path":"/metadata/why_now","value":"The live global blocks ceiling is exactly saturated and rejected the required evidence-backed edges"},{"op":"add","path":"/metadata/parent","value":"pm-m2u1"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-4jqm","kind":"implements","created_at":"2026-08-20T20:11:18.429Z","author":"harness:codex","source_kind":"evidence:pm-c90tfh","author_source":"detected"},{"id":"pm-c90tfh","kind":"discovered_from","created_at":"2026-08-20T20:11:18.429Z","author":"harness:codex","source_kind":"evidence:pm-c90tfh","author_source":"detected"},{"id":"pm-dwj33e","kind":"implements","created_at":"2026-08-20T20:11:18.429Z","author":"harness:codex","source_kind":"evidence:pm-c90tfh","author_source":"detected"}]},{"op":"add","path":"/metadata/comments","value":[{"created_at
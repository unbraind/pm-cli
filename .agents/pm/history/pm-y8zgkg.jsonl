{"hash_algorithm":"sha256","ts":"2026-11-19T06:03:12.128Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"5063d084c5ce4e109baf97d9","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1753","claim:pm-gh1754","claim:pm-y8zgkg","lineage:pm-y8zgkg","lineage:pm-i7w2"]},"topic":{"value":"workset:pm-gh1753+pm-gh1754+pm-y8zgkg","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1753","claim:pm-gh1754","claim:pm-y8zgkg","lineage:pm-y8zgkg","lineage:pm-i7w2"]},"version":{"value":"2.1.328","source":"probe"}},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-19T06:03:12.128Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-11-19T06:03:12.127Z","author":"harness:claude-code","text":"Implemented as proposed. isAbsolutePattern in src/core/fs/file-glob.ts treats a pattern as absolute only when it has a leading / (a root or a //server/share UNC root) or, on win32, a drive root matching ^[A-Za-z]:/. splitStatic and literalMatch both use it instead of path.isAbsolute, so a leading backslash is always the glob escape: \\a.ts matches a.ts and \\!x.ts matches !x.ts, with relative output on every platform. The tinyglobby parity entry \\a.ts is now POSIX-only, because on Windows the old expansion matched nothing and the escape reading is a superset. A new cross-platform spec covers the escape plus isAbsolutePattern on win32, linux and darwin. Behaviour that does not change: on win32, path.isAbsolute also treated C:\\x as absolute, but in glob grammar that pattern reads C: plus an escaped x, and both readings match no file because Windows file names cannot contain ':'. A POSIX directory named C: stays relative. Verified on Linux (17/17 in file-glob.spec.ts); the Windows proof is the PR's windows-latest matrix and the next nightly."}]}],"before_hash":"145e3c00e4928368299cb88431d15a851ce211e0def44516cf10c06e4de57fa3","after_hash":"3be6e594e04634fe79a25df91f2bb4db27af61bd409a7fd170cc3e5938438d68","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"2eb62dc56ddf50f0602ab30e724ddd0ab9a4afba194c7f98b4178b62ecd13986"}

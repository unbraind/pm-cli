mutation-guard-actor.spec.ts (claimant-only close through SDK client, CLI, MCP; preview/commit actor parity; delete dry run, copy, import; test harness defaults)."}]}],"before_hash":"320108f0fc75c214dbe052304e5f8c0f1b040365180544088ba12dac8fd275c6","after_hash":"22e2a6ccedb7ccadfccada2e1dd42b4540191b375723a39e2517f60bca7d3fd0","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"62ae7193020847b50e70f136111a5c7f70dc8823a5acae45c86b4b04f352c535"}

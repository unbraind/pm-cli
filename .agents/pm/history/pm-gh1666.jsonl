{"hash_algorithm":"sha256","ts":"2026-11-07T11:10:34.509Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"54ac87379db6592d81af1cc6","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1665","claim:pm-gh1666","claim:pm-gh1667","lineage:pm-gh1667","lineage:pm-9rgaal","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1665+pm-gh1666+pm-gh1667","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1665","claim:pm-gh1666","claim:pm-gh1667","lineage:pm-gh1667","lineage:pm-9rgaal","lineage:pm-doxj"]},"version":{"value":"2.1.319","source":"probe"}},"op":"close","patch":[{"op":"replace","path":"/metadata/actual_result","value":"The integration spec reads inherited_flags from the contract and invokes every listed flag except --help on a mutating command with exit 0, asserts --json, --author, --pm-path, --output-format and --expect-hash are present and read-output controls, --no-extensions and root-only flags absent, checks text and JSON help carry the same set, and refuses --all/--explain on commands with and without declared flags while pm list --all still works with an extension flag on list"},{"op":"remove","path":"/metadata/claim_principal"},{"op":"remove","path":"/metadata/assignee"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-07T11:10:34.509Z"},{"op":"replace","path":"/metadata/status","value":"closed"},{"op":"add","path":"/metadata/closed_at","value":"2026-11-07T11:10:34.458Z"},{"op":"add","path":"/metadata/completed_at","value":"2026-11-07T11:10:34.458Z"},{"op":"add","path":"/metadata/resolution","value":"pm contracts --command <ext> --flags-only --json now carries inherited_flags (owner host, delivered through context.global) for registered extension commands, and pm help <ext> --json carries the same rows as inherited_options; text help prints an Inherited host flags section that points at the contracts command. The rows derive from extension_command_availability declared beside each reserved host flag (read-output controls only on commands that declare read_output; --no-extensions never listed; discovery_value_name path for --pm-path), so a new host flag is classified where it is reserved. Extension rows carry owner extension and sdk_option. CLI dispatch refuses an undeclared root-only --all or --explain on an extension-created command (refuseUndeclaredRootOnlyOptions in the action wrapper) instead of leaking it into context.options; core commands an extension only augments keep their own --all."},{"op":"add","path":"/metadata/close_reason","value":"Extension commands list every flag they accept, marked host- or extension-owned"}],"before_hash":"f944001a74f7b93c8a6a3bcef85695f5dda07c39da762cf0c8018111a3dae4b5","after_hash":"077afaffd4017a3a3ac0618c62b3f6768869533a558630fcb6bd894d0eb0733c","item_hash_version":3,"context":{"completion":{"timestamp":"2026-11-07T11:10:34.458Z","source":"close_time"},"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"60f8db740d6f0841be6e44eec98c353f4e7fe11bef35f606158fec39c6c8b498"}

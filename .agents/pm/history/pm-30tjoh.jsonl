{"hash_algorithm":"sha256","ts":"2026-11-08T08:03:22.636Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"5d97cc75851de74b9275ff63","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-0jzl5t","lineage:pm-0jzl5t","lineage:pm-wzmbvn","lineage:pm-u9d0","lineage:pm-doxj"]},"topic":{"value":"pm-0jzl5t","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-0jzl5t","lineage:pm-0jzl5t","lineage:pm-wzmbvn","lineage:pm-u9d0","lineage:pm-doxj"]},"version":{"value":"2.1.319","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-08T08:03:22.635Z","author":"harness:claude-code","text":"Codex review of PR 1687 (P2, fixed): once malformed entries load, buildSearchCorpus in src/core/search/corpus.ts still mapped every comments/notes/learnings entry to entry.text. A null entry threw a TypeError in the BM25/semantic corpus and in the reindex corpus, aborting search for every item, where main had skipped the damaged item with a warning. annotationTexts now keeps only plain-object entries with string text. The spec adds a corpus case, and that case fails against the previous corpus.ts. A built-CLI sweep over list, search, get, context, comments, notes, learnings, validate, stats, health, activity and graph impact showed the damaged item and its healthy neighbour both delivered with exit 0.\n"}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-08T08:03:22.636Z"}],"before_hash":"58fdaa861c40a9e7cb4a4b5d03efdfdda01d3ed0dc4a2c4561dbafa6fd7b56ce","after_hash":"9ab84aff2dffbbfea3dffab1353075b045002c8bd731999afe0528b8580a8607","item_hash_version":3,"context":{"agent_provenance_outcomes"
_hash":"9812f5930b430fcba4784ff76a5b11a6cf56da87e27fd084f1c15c7c568df92f","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"maintenance","record_hash_version":1,"record_hash":"ea8ab7b73fcd4ddafc520b76f162041a5224a6e4b88a6abea2dd74ba1378bfad"}
{"hash_algorithm":"sha256","ts":"2026-11-07T09:04:28.169Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"54ac87379db6592d81af1cc6","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1665","claim:pm-gh1666","claim:pm-gh1667","lineage:pm-gh1667","lineage:pm-9rgaal","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1665+pm-gh1666+pm-gh1667","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1665","claim:pm-gh1666","claim:pm-gh1667","lineage:pm-gh1667","lineage:pm-9rgaal","lineage:pm-doxj"]},"version":{"value":"2.1.319","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-07T09:04:28.169Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-07T09:04:28.169Z","author":"harness:claude-code","text":"Implementation evidence (branch feat/extension-authoring-contracts, 2026-11-07).\n\nMeasured the gap on the emitted declarations with the TypeScript checker: 281 entrypoint x type gaps, 197 distinct package types named by exported function signatures (parameters, return types, type-parameter constraints) that the entrypoint did not export: ./sdk 120, ./sdk/testing 41, ./sdk/runtime 39, ./sdk/core 24, ./sdk/query 20, ./sdk/authoring 14, ./sdk/governance 11, ./sdk/graph 7 (including ProjectedGraphResult for runGraph), ./sdk/contracts 3, ./sdk/merge 2. HistoryEntry (named by appendHistoryEntry) was exported from no entrypoint at all.\n\nChange:\n- scripts/sdk-surface-snapshot.mjs: analyzeSignatureTypeReachability walks every exported function declaration's signature, resolves each type reference to its declaration, and reports package types (declared under dist/) the same entrypoint does not export. Identity is by declaration, so a same-named different type is still a gap. buildSdkSurfaceSnapshot refuses any gap, naming the type, its declaration file and the functions that name it, and the snapshot records signature_type_reachability counts per entrypoint.\n- Closed all 281 gaps with type-only re-exports per entrypoint, plus export keywords on 27 module-local types (for example ReadPromise, ReadOptions, InitialReadOptions in runtime.ts; AcquireLockOptions in core/lock).\n- sdk/extension-contracts ExtensionCapability re-exports the structurally identical core declaration, so signatures typed with the core alias resolve to the exported type.\n- The merge half already held: MergeDecisionReceipt.conflict_resolution is typed by the exported ItemScalarConflictResolution, importable from sdk/merge and the aggregate; the type test now imports it from both.\n- tests/types/sdk-subpath-entrypoints.test-d.ts imports ProjectedGraphResult (sdk/graph and sdk), ItemScalarConflictResolution and MergeDecisionReceipt (sdk/merge), HistoryEntry (sdk) and ExtensionActivationResult (sdk/testing) as type-only imports beside the value-export parity checks.\n\nSDK surface: 306 classified changes, all additive or compatible except four acknowledged signature changes (CliFlagContract gains optional owner/sdk_option in ./sdk and ./sdk/contracts; ExtensionCapability now names the core declaration in ./sdk and ./sdk/authoring).\n\nVerified: tests/unit/scripts/sdk-surface-snapshot.spec.ts (19 tests) covers gaps, identity, unresolved names, merged function+namespace, and the build refusal. Negative control: deleting the ProjectedGraphResult re-export from dist/sdk/graph.d.ts makes sdk-surface-snapshot --check fail with './sdk/graph: ProjectedGraphResult (declared in dist/sdk/graph/run.d.ts; named by runGraph)'.\n\nFollow-up filed: pm-bqyk1z (98 class-member and 875 type-declaration references still name unexported types; mostly PmClient methods from ./sdk/core).\n"}]}],"before_hash":"9812f5930b430fcba4784ff76a5b11a6cf56da87e27fd084f1c15c7c568df92f","after_hash":"56590cab5749d38731fdf22dd5c32af3539a24f8a45c1f33b3a585f6b97e2877","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"12f1f4573f72448673adc9bca0effc693d5cd031a30545ed7374953709355307"}

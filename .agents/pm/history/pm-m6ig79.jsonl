{"hash_algorithm":"sha256","ts":"2026-10-30T18:54:42.758Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"7b0e58428f53e3aaeaafb372","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-m6ig79","lineage:pm-m6ig79","lineage:pm-doxj"]},"topic":{"value":"pm-m6ig79","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-m6ig79","lineage:pm-m6ig79","lineage:pm-doxj"]},"version":{"value":"2.1.312","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/2","value":{"created_at":"2026-10-30T18:54:42.757Z","author":"harness:claude-code","text":"Hosted run 41081552276 on 049a2ba36 (all 30 checks green). Wall clock 15:31-18:29 UTC was almost entirely runner queueing: per-job queue waits ran from 1.8 to 112.5 minutes while the account pool was saturated. Job run times: Build foundation 1.3 min; Packed runtime ubuntu 1.6, macos 2.0, windows 17.8; Gates static 13.8, smokes 11.2, coverage aggregate 0.8; Coverage shards 5.0 to 7.2; Windows regression cohorts 5.7 to 6.8. Uncontended critical path is Build foundation plus Packed runtime (windows-latest), about 19 minutes; the static gate path is about 15 minutes. The Windows packed job is now the longest single job and the first candidate if the 20-minute budget tightens."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-10-30T18:54:42.758Z"}],"before_hash":"568810b4923b1f0e969ecc67c5bef1c79447aaef73d4ae827eddb24e9451b52a","after_hash":"8cfa166e414082a60cf3ca142cb8d5b2170fb719cd07ba62e9ec6e8f330dfe8c","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"r
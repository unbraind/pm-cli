e":"detected"},{"id":"pm-p258tx","kind":"related","created_at":"2026-07-29T22:50:13.344Z","author":"harness:codex","source_kind":"cli:create:dep","author_source":"detected"}]},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-07-29T22:50:13.344Z","author":"harness:codex","text":"Duplicate-check evidence: searched all statuses for workspace snapshot writer lease heartbeat lock ENOENT temporary path and restore lost writer lock. The closed pm-dkrmzv owns the shipped snapshot primitive but no item owns this activation race. Reproduced twice on 2026-07-30, once in full coverage and once in the focused 10-test snapshot suite."}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"b8a062f7eae924a9eea7af734cbe40e8734182726ea41fb5869d4f6e14f6e9a6","message":"Track snapshot activation lease race discovered during PR #818 gates"}

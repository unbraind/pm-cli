{"hash_algorithm":"sha256","ts":"2026-11-13T19:40:30.932Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"bde39398f74f9316857947fc","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-tcvccz","claim:pm-v1mp64","lineage:pm-v1mp64","lineage:pm-5t33or","lineage:pm-n7rr","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"workset:pm-tcvccz+pm-v1mp64","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-tcvccz","claim:pm-v1mp64","lineage:pm-v1mp64","lineage:pm-5t33or","lineage:pm-n7rr","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.323","source":"probe"}},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-13T19:40:30.932Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-11-13T19:40:30.932Z","author":"harness:claude-code","text":"Design decision (2026-11-13): the unit of the quiet judgment is one item's run, the same rule pm test applies since GH-1702. Each test-all results[] entry is projected exactly as a pm test reply would be. A quiet item (ok, every row passed and mismatch-free, all failure categories zero) is reduced to the decision fields. A non-quiet item keeps the full context on EVERY row, including its passing rows, so the failing row can be compared side by side with its siblings. When every item that ran shares one reduced context, test-all hoists it once to the top-level execution_context.\n\nAC refinement: the first AC clause reads \"a passing ... row\". It holds for every row of a quiet item. A passing row inside a failing item keeps its full context, for the same reason pm test keeps it.\n\nCode: the projection moved from src/core/output/output.ts into src/core/output/linked-test-projection.ts (projectLinkedTestReply). output.ts now dispatches both commands to it.\n\nMeasured on a one-item, one-test sandbox: test-all TOON 2124 B -> 1248 B, JSON 3010 B -> 1760 B. No absolute path remains in the default projection."}]}],"before_hash":"755670bc83380a0e3007f49cb237f27face99f42291511163d2231d251b85f13","after_hash":"4b8e3c6fa83937ca8db3bf7b1e0ffa14ca0f6709410fd49998874036178af0d3","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"8b3972419e4bbb379e2be6b31f746f60dc46220c11864bafff5c9ebc62c965e2"}

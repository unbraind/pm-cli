{"hash_algorithm":"sha256","ts":"2026-11-16T16:55:16.674Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"aafa2be13b294c2b9a62368a","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1741","lineage:pm-gh1741","lineage:pm-n7rr","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"pm-gh1741","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1741","lineage:pm-gh1741","lineage:pm-n7rr","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.325","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-16T16:55:16.674Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-16T16:55:16.674Z","author":"harness:claude-code","text":"Implementation note (2026-11-16): parseBareKeyValueToken now returns null for a colon token that contains any whitespace, so a shell-grouped token such as \"Docs: adopt X\" stays text, while whitespace-free shorthand (docs:README.md) and the equals form keep their promotion. main.ts records the invocation's bare_key_value promotions in src/cli/runtime/invocation-rewrites.ts. The create positional-type refusal names each promoted token and suggests renderPmCommand([create, <type>, --title, <token>]), and otherwise suggests the --title form, never the attempted command. Its message was shortened to stay within the 120-character problem title. Verified on a scratch tracker: all six listed prefixes create Issues with their titles intact, and pm create issue Docs:README refuses with next step 'Keep \"Docs:README\" as the title: pm create issue --title Docs:README'."}]}],"before_hash":"b7653072f43e65400a3083dae9cd7c0ef094ab33cd85fc94a8
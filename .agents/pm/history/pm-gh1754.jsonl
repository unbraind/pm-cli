{"hash_algorithm":"sha256","ts":"2026-11-19T06:03:07.671Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"5063d084c5ce4e109baf97d9","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1753","claim:pm-gh1754","claim:pm-y8zgkg","lineage:pm-y8zgkg","lineage:pm-i7w2"]},"topic":{"value":"workset:pm-gh1753+pm-gh1754+pm-y8zgkg","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1753","claim:pm-gh1754","claim:pm-y8zgkg","lineage:pm-y8zgkg","lineage:pm-i7w2"]},"version":{"value":"2.1.328","source":"probe"}},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-19T06:03:07.671Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-11-19T06:03:07.671Z","author":"harness:claude-code","text":"Root cause: both string-compaction walkers (compactStrings in src/sdk/read-output-budget.ts and compactContextIntentValue in src/sdk/context-intent-contracts.ts) exempted any string under a key named cursor or ending in _cursor at every depth, so a tracker item's own field with such a name was treated as a continuation token. Fix: the exemption now stops at tracker item documents. isTrackerItemDocumentKey in src/core/shared/text-normalization.ts names the top-level item and items keys, and both walkers switch the exemption off beneath them. Envelope tokens stay whole: next_cursor, output_cursor, output_budget_truncation continuations, nested section cursors, and pm events per-row cursors under events. A census found no producer that emits a real continuation token inside an item or items row. Evidence: on src the GH-1754 fixture returns one row with a 255-character value for next_cursor, output_cursor, source_cursor, cursor, sync_cursor and ordinary_text, in JSON and TOON, with and without --for triage. Negative controls: reverting either walker fails all three new specs in tests/unit/sdk/read-output/continuation-tokens.spec.ts, and the GH-1710 specs keep passing."}]}],"before_hash":"5fb53b70e5502460ea6d2db25313e3e89e11ef54eed19df577c0aa20770bdbb3","after_hash":"261e1da11f442b88ea8cc3f0278312aa183311948fab65066a4457eee8f7585d","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"6e8d03da773e9b63c2a5ae9d0df1899c5a5d3049844374c34c835196adf6a4db"}

{"hash_algorithm":"sha256","ts":"2026-11-19T06:49:30.062Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"5063d084c5ce4e109baf97d9","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1753","claim:pm-gh1754","claim:pm-y8zgkg","lineage:pm-y8zgkg","lineage:pm-i7w2"]},"topic":{"value":"workset:pm-gh1753+pm-gh1754+pm-y8zgkg","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1753","claim:pm-gh1754","claim:pm-y8zgkg","lineage:pm-y8zgkg","lineage:pm-i7w2"]},"version":{"value":"2.1.328","source":"probe"}},"op":"note_add","patch":[{"op":"add","path":"/metadata/notes/1","value":{"created_at":"2026-11-19T06:49:30.062Z","author":"harness:claude-code","text":"Review (Codex, uncommitted diff): restricting the exemption by key alone also shortened genuine tokens inside an extension's items rows, since extensions may declare row_keys [\"items\"] for records that are not tracker items. Fixed by scoping on the surface as well as the key. isTrackerItemDocumentKey(surface, key) is true only for item and items on the native item reads get, list and search. Both walkers now receive the resolved surface: compactReadOutputToBudget takes resolved.command, and the intent walker takes resolveReadOutputSurface(command), which resolves extension commands first, so an extension named list probe stays extension:list probe. A new spec covers a registered extension's items[0].evidence.next_cursor kept whole beside a compacted note, and a key-by-surface table covers get/list/search against next, context, events and extension surfaces. Negative control: forcing the list surface fails the extension spec."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-19T06:49:30.062Z"}],"before_hash":"1d449bee1aa879089f47c17fcae6f3c5189e4e4ebcf45d473df2c60d555799b0","after_hash":"53e3579d8fe0ba7998da666ea15f891a24f215890fc5ae6f7d189ad3e97de932","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"718318a2ad09a2e755846759e2fbd07771048868334d0ed56e39b4351e9a0a47"}

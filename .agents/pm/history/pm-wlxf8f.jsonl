{"hash_algorithm":"sha256","ts":"2026-11-07T19:07:15.128Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"b76020648d06f21575f92b8e","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"release-operator","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-1du7s3","claim:pm-wlxf8f","release:pm-y26mvc"]},"topic":{"value":"workset:pm-1du7s3+pm-wlxf8f","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-1du7s3","claim:pm-wlxf8f","release:pm-y26mvc"]},"version":{"value":"2.1.319","source":"probe"}},"op":"close","patch":[{"op":"replace","path":"/metadata/actual_result","value":"Built-CLI spec refuses separate, attached and grouped spellings, and accepts equal values, list accumulation and repeated-spelling last-wins; real-Commander specs cover ancestor consumption, positional and pass-through stops and core short-alias ownership; negative control without captured tokens keeps the last value silently"},{"op":"replace","path":"/metadata/expected_result","value":"pm demo --status-filter open -s closed exits 2 with extension_option_spelling_conflict naming both spellings"},{"op":"remove","path":"/metadata/claim_principal"},{"op":"remove","path":"/metadata/assignee"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-07T19:07:15.128Z"},{"op":"replace","path":"/metadata/status","value":"closed"},{"op":"add","path":"/metadata/closed_at","value":"2026-11-07T19:07:15.107Z"},{"op":"add","path":"/metadata/completed_at","value":"2026-11-07T19:07:15.107Z"},{"op":"add","path":"/metadata/resolution","value":"Each command records the tokens its own option parser receives (captureCommandOptionTokens). refuseConflictingArgvOptionSpellings (src/sdk/extension/command-options.ts) replays Commander's parseOptions rules over every command on the dispatch path: short groups, required/optional/variadic values, negative numbers, --long=value, the positional and pass-through stop rules, registered ownership and negations, plus the loose grammar for unregistered declared flags. It refuses with extension_option_spelling_conflict when two spellings hold different values after coercion. Equal values, repeats of one spelling and list flags are unchanged. Codex review rounds 1-3 hardened the scan."},{"op":"add","path":"/metadata/close_reason","value":"CLI argv with two spellings of one declared scalar extension flag and different values is refused like direct callers"}],"before_hash":"7ae220335bae41f7160f87f2df502a02f141ee8f994be4d045579ae357e3d6bd","after_hash":"5570f9948d5acadf5f660931e118eee6ec8d216b5b79f01299e97a84dd63056a","item_hash_version":3,"context":{"completion":{"timestamp":"2026-11-07T19:07:15.107Z","source":"close_time"},"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"b109a9e081167459d15d55b42a9054ac628d7ea73ca83def50c49bb2052e3b41"}

{"hash_algorithm":"sha256","ts":"2026-11-14T05:21:44.116Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"9d7f970542d8df5a0a6bdb3b","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1713","claim:pm-gh1719","claim:pm-o74zyh","lineage:pm-o74zyh","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1713+pm-gh1719+pm-o74zyh","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1713","claim:pm-gh1719","claim:pm-o74zyh","lineage:pm-o74zyh","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.325","source":"probe"}},"op":"note_add","patch":[{"op":"add","path":"/metadata/notes/1","value":{"created_at":"2026-11-14T05:21:44.115Z","author":"harness:claude-code","text":"Side effect handled in scope (2026-11-14): adding deferred_fields to the item key order pushed the pm list --fields refusal from 1,9xx to 2,025 estimated tokens, over the 2,000-token recovery-bundle budget. The ladder then dropped why and examples and cut allowed_values to 3 entries. The cause was that list doubled its legal domain with an item.-prefixed copy of every field. The list refusal and its closed-domain contract now name each field once (listCanonicalListProjectionFields) and state the item. alias in required. The refusal fits undegraded again, with all 78 fields and its examples. listListProjectionFields still returns every accepted spelling. get and search keep their domains; for search, item.<field> differs from search-row fields. Also in scope: deferred_fields joins ITEM_UNION_COLLECTION_FIELDS so concurrent resolutions union-merge, and the stdin-json document adapter treats it as read-only on update and maps it to defer/deferReason on create (pm-o74zyh)."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-14T05:21:44.116Z"}],"before_hash":"16804a8b528a6e6c83b0a5fe4d0a5e9fd58b21176eb5510738f902a07bc0bbde","after_hash":"f81b98d6729e5d0f38cda022b4b2cc0a29ac3b90d6ce6ea7a02b4d8c9c618c9f","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"c7ba668b2ab26a4f44e2af6530ad186813de753bc66ce9f2eebe9b62ad5a4d22"}

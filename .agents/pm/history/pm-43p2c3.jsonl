{"hash_algorithm":"sha256","ts":"2026-11-18T10:27:28.225Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"928e5cd9a3bda9591c204f9f","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-43p2c3","claim:pm-5kfzjh","claim:pm-gh1749","lineage:pm-43p2c3","lineage:pm-ugqx","lineage:pm-doxj"]},"topic":{"value":"workset:pm-43p2c3+pm-5kfzjh+pm-gh1749","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-43p2c3","claim:pm-5kfzjh","claim:pm-gh1749","lineage:pm-43p2c3","lineage:pm-ugqx","lineage:pm-doxj"]},"version":{"value":"2.1.327","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-18T10:27:28.225Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-18T10:27:28.224Z","author":"harness:claude-code","text":"Implemented on branch feat/sdk-stable-consumer-classifications, together with pm-5kfzjh. checkGithubUpdate's default runner no longer goes through runGitCommand. runGitUpdateQuery runs git ls-remote under the shared runBoundedUpdateQuery deadline, with GIT_TERMINAL_PROMPT=0 and GCM_INTERACTIVE=never. It reports github_remote_lookup_timed_out with update_check_timeout_ms when the deadline passes, and github_remote_lookup_failed for any other failure, never git's command line, the repository URL or stderr. An injected runner now has the npm runner's signature (args, timeoutMs). no_remote_reference_found and missing_installed_commit are unchanged. Tests are in tests/unit/extensions/npm-update-check-timeout.spec.ts (the GitHub describe block) and the existing annotated-tag case in extension-command.spec.ts.\n"}]}],"before_hash":"ae5f51d937c98ca2e83590dba16839533927b103c9
{"hash_algorithm":"sha256","ts":"2026-10-20T10:34:31.518Z","author":"harness:codex","author_source":"detected","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"1e3aaed2ebb33413fa918dd9","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"xhigh","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-hdvxqg"},{"op":"add","path":"/metadata/title","value":"GH-1519: preflight test run options before persisting linked-test edits"},{"op":"add","path":"/metadata/description","value":"https://github.com/unbraind/pm-cli/issues/1519 reports on published 2026.10.20/plain non-Git trackers that test --add persists a link before refusing invalid --timeout, --pm-context, --env-set or --only-index values, so retries accumulate duplicate registrations. It also reports run counters on add-only --progress and generic errors for some invalid values. This is reporter evidence; current-head reproduction and implementation remain pending. The scope is admission of the entire requested link/run option combination before any write, beyond the earlier linked-context validation."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["agent-ux","area:testing","mutation-safety"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-20T10:34:31.518Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-20T10:34:31.518Z"},{"op":"add","path":"/metadata/author","value":"harness:codex"},{"op":"add","path":"/metadata/estimated_minutes","value":180},{"op":"add","path":"/metadata/acceptance_criteria","value":"Exercise invalid timeout, context, environment and index options through CLI and native SDK with add/remove edits: preflight refusals must leave item bytes, link
l-credentials.spec.ts tests/integration/cli/credential-redaction.integration.spec.ts (public-URL and stored-identity cases fail on the previous rule)","local_checks":["node scripts/run-tests.mjs test -- tests/unit/core/shared/url-credentials.spec.ts tests/integration/cli/credential-redaction.integration.spec.ts tests/unit/sdk/agent-runtime-primitives.spec.ts"],"hosted_checks":["CI / Gates (static)","CI / Gates (coverage)"]}}],"before_hash":"a22ddb45b9e79f0786a0459618437f177e2c4a478cb733184915b76fee0d079f","after_hash":"c4293c81e8379136bb249d6b6539b8cac3f121bdcea65289ad3ef5a2963b89cb","item_hash_version":3,"message":"Record escape class, gate evidence and contract change","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"138f7ecdd579c6ce89fbabc842dd887dfd8d941a07a5c606bb9676809cbb822a"}
{"hash_algorithm":"sha256","ts":"2026-11-12T08:56:31.769Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"release-operator","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1707","release:pm-gh1704"]},"topic":{"value":"pm-gh1707","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1707","release:pm-gh1704"]},"version":{"value":"2.1.322","source":"probe"}},"op":"close","patch":[{"op":"replace","path":"/metadata/actual_result","value":"url-credentials spec 36 cases pass, including the GH-1707 corpus. The credential-redaction integration spec drives PM_AUTHOR, --author and --assignee and a legacy stored holder through claim, update and --if-available with no secret in any output. 3,339 tests over the changed modules pass and every changed line is covered."},{"op":"replace","path":"/metadata/expected_result","value":"Must-allow URLs stay intact, must-redact URLs are hidden, and no stored or asserted credential reaches storage or a refusal"},{"op":"remove","path":"/metadata/claim_principal"},{"op":"remove","path":"/metadata/assignee"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T08:56:31.769Z"},{"op":"replace","path":"/metadata/status","value":"closed"},{"op":"add","path":"/metadata/closed_at","value":"2026-11-12T08:56:31.736Z"},{"op":"add","path":"/metadata/completed_at","value":"2026-11-12T08:56:31.736Z"},{"op":"add","path":"/metadata/resolution","value":"userinfoBounds now scopes redaction to the URL authority. Userinfo ends at the last at sign inside it, and an authority holding a colon but no at sign still extends to the token's last at sign, so a password with an unencoded slash stays hidden. Scoped-package, blob, query and fragment at signs are left alone and keep an executable retry. resolveAuthorIdentity replaces URL userinfo in explicit, PM_AUTHOR and configured authors with [redacted], and create and update do the same for --assignee and create's --author, so claim principals are clean too. A holder stored by an older version still reads. Ownership refusals, the three is-assigned-to conflicts and the claim and release envelopes (claimed_by, previous_assignee and the claim_skipped_held_by and claim_takeover warnings) redact it as one whole value. Follow-up pm-oh24c5 reports such legacy records in validate."},{"op":"add","path":"/metadata/close_reason","value":"Public URLs with an at sign in the path survive redaction, and identities can no longer store or echo URL credentials"}],"before_hash":"c4293c81e8379136bb249d6b6539b8cac3f121bdcea65289ad3ef5a2963b89cb","after_hash":"3be8545fcc61063a4619fd341c70d6ff0226751f69e9c5968bba254e9ac6d5ad","item_hash_version":3,"context":{"completion":{"timestamp":"2026-11-12T08:56:31.736Z","source":"close_time"},"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"709eb303340be8251bd5a4ba2a396aba0a3ae1039519e422deabf29e89a861ab"}
{"hash_algorithm":"sha256","ts":"2026-11-12T08:56:32.716Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"release-operator","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1707","release:pm-gh1704"]},"topic":{"value":"pm-gh1707","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1707","release:pm-gh1704"]},"version":{"value":"2.1.322","source":"probe"}},"op":"release","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T08:56:32.716Z"}],"before_hash":"3be8545fcc61063a4619fd341c70d6ff0226751f69e9c5968bba254e9ac6d5ad","after_hash":"538b144f983998d1631b3205664ce032c71a5f3d275631cd11231c66fa448aee","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"maintenance","record_hash_version":1,"record_hash":"50e09d8ed2f743ccd503acc3a9a77291946a63186e478019d6979e0c44bb8a6e"}
{"hash_algorithm":"sha256","ts":"2026-11-12T09:36:13.058Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T09:36:13.058Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-12T09:36:13.058Z","author":"harness:claude-code","text":"Pre-push Codex review (three P1s), fixed before the PR opened. The first narrowing scoped redaction to the authority and so leaked three shapes the old first-colon/last-at rule hid: a tab before the authority slashes (https:<TAB>//secret@host, which WHATWG parsers strip), a credential URL nested in a public URL's query (https://public.example/?next=https://u:secret@localhost), and a password holding both an @ and a / (https://u:ab@cd/efGHIJKL@localhost/x). The rule is now inverted: the old conservative span is the default, and a token is exempt only when it provably holds no userinfo. Its authority has neither : nor @, the rest has no : (no nested URL), and it has no tab or line break. All three shapes are must-redact cases in the spec, and the scoped npm alias went back to the documented conservative cost.\n"}]}],"before_hash":"538b144f983998d1631b3205664ce032c71a5f3d275631cd11231c66fa448aee","after_hash":"b5564160f847008024d2b4d02c8b8ed230df02437ccaaa54d7fa05b243af863e","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"3ccda04c8c6193c9b4cca94c33f69a1bf78b27353432af622ea7c57d691278dc"}
{"hash_algorithm":"sha256","ts":"2026-11-12T09:54:05.212Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-12T09:54:05.211Z","author":"harness:claude-code","text":"Pre-push Codex review round 2 (P2), fixed before the PR opened: the provably-public exemption ended the authority at ?, # or /, but Git passes ssh://Zq8vN3k?LmP0wXy7Ab@github.com/repo to OpenSSH, which reads the part before the at sign as the username. A ? or # therefore no longer ends the authority; only / does. Both SSH shapes are must-redact cases in the spec.\n"}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T09:54:05.212Z"}],"before_hash":"b5564160f847008024d2b4d02c8b8ed230df02437ccaaa54d7fa05b243af863e","after_hash":"f3b06747195414df88c97a7b654ed71e50d054200633183a4c57e4ba8b7dc067","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"62881c868a015c9a170176a3b4bb6dcb19d15969774f3ae357f271d767eaa7f1"}
{"hash_algorithm":"sha256","ts":"2026-11-12T10:48:35.096Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/2","value":{"created_at":"2026-11-12T10:48:35.095Z","author":"harness:claude-code","text":"PR 1712 review (Greptile, two CodeRabbit Majors, one CodeRabbit Minor), fixed in this PR. (1) Warn-mode ownership warnings in item-store, history-rewrite and restore still interpolated the raw stored assignee, and runRelease returned them unchanged. (2) Ownership checks compared the raw stored principal with the now-redacted caller, so under strict enforcement a legacy owner would have been locked out of its own item; claim's held-by check had the same mismatch. Every site now reads the stored holder in its redacted form for both comparison and echo. (3) A runtime or registered create field mapped to the author, assignee or claim_principal metadata keys replaced the sanitized value with raw input; both spreads now pass through redactIdentityFields. Unit tests cover warn and strict with a legacy holder, plus the field helper; every changed line is covered.\n"}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T10:48:35.096Z"}],"before_hash":"f3b06747195414df88c97a7b654ed71e50d054200633183a4c57e4ba8b7dc067","after_hash":"0c168947163af738f5fd66054e8146bc0b2a3b37d21402f738e79f76e2a19a33","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"39ed601d8e6cc1b0a03bfd0933bdab279da1683fbd58e4b75d149c40f20b79c7"}
{"hash_algorithm":"sha256","ts":"2026-11-12T11:08:34.200Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/3","value":{"created_at":"2026-11-12T11:08:34.200Z","author":"harness:claude-code","text":"PR 1712 review round 2, fixed in this PR. (1) Greptile: comparing the stored holder in redacted form made distinct legacy holders on one host, such as https://alice:one@host and https://bob:two@host, compare equal, so one caller could claim or update the other's item without --force. That reverses the CodeRabbit Minor fix. A legacy owner being refused until --force or a rewrite is recoverable; one owner silently acting as another is not. Ownership is compared exactly again, and only the echo is redacted. The item-store spec now expects a redacted caller and a stranger to be refused under strict, and a forced takeover to succeed.\n"}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T11:08:34.200Z"}],"before_hash":"0c168947163af738f5fd66054e8146bc0b2a3b37d21402f738e79f76e2a19a33","after_hash":"d121d2636bc7d071c57b94a271f21de3a010413802aed47b84346c3adf298198","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"4cc59aaa8fe57c9b290bbf4190703f662fd05eef33ebfe8b7a01a2789037d3b5"}
{"hash_algorithm":"sha256","ts":"2026-11-12T11:50:04.821Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"update","patch":[{"op":"replace","path":"/metadata/contract_change/migrate","value":"Use a plain name for PM_AUTHOR, --author, default_author and --assignee; rewrite a holder stored by an older version with pm update <id> --assignee <name>, or take it over with --force"},{"op":"replace","path":"/metadata/contract_change/after","value":"Only a token that provably holds no userinfo is left alone, so scoped-package and blob URLs keep an executable retry; an asserted or configured identity, --assignee, or an identity runtime field carrying URL userinfo is refused with invalid_argument_value, and refusals, warnings and claim envelopes redact a stored one"},{"op":"replace","path":"/metadata/contract_change/api","value":"URL credential redaction in refusals and recoveries; author, assignee and claim identities"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T11:50:04.821Z"}],"before_hash":"d121d2636bc7d071c57b94a271f21de3a010413802aed47b84346c3adf298198","after_hash":"415a1135c02d5fb8057a8d3fc0c9c81d791ca4356f832feb6f4ae727bcb73f57","item_hash_version":3,"message":"Contract change: identities with URL userinfo are refused, not stripped (PR 1712 review)","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"e292a4e6435901b74347918f3548e91c445f25e4958a4e431b65c74964226b07"}
{"hash_algorithm":"sha256","ts":"2026-11-12T11:50:20.759Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"update","patch":[{"op":"replace","path":"/metadata/resolution","value":"URL redaction keeps the conservative first-colon/last-at span unless a token provably holds no userinfo. A token qualifies when its authority (up to the next slash) has neither colon nor at sign, the rest of the token has no colon, and it has no tab or line break. So scoped-package and blob URLs keep host, path and an executable retry, while nested URLs, SSH userinfo with ? or # and passwords containing @ and / stay hidden. URL userinfo is refused with invalid_argument_value, naming the source but never the value, wherever an identity is set: an asserted or configured identity (--author, PM_AUTHOR, default_author), --assignee on create and update, and identity runtime or registered field values. Refusal rather than stripping keeps distinct identities from collapsing into one principal. A holder stored by an older version still reads. Ownership compares it exactly, and refusals, warn-mode warnings and claim and release envelopes, including the returned item copy, echo it redacted. Follow-ups: pm-oh24c5 (validate reports legacy identities) and pm-3fbj1f (object-key payload scanning)."},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T11:50:20.759Z"}],"before_hash":"415a1135c02d5fb8057a8d3fc0c9c81d791ca4356f832feb6f4ae727bcb73f57","after_hash":"6c325317ee879a1fe78a2b147ed083a8f8a39b710905ceaba1c8f3634b4315bc","item_hash_version":3,"message":"Resolution reflects the refusal design adopted in PR 1712 review","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"maintenance","record_hash_version":1,"record_hash":"45aa4e9392ec189cac3f56d2962fc53f10cb93bc964bb001dad35defd732cc17"}
{"hash_algorithm":"sha256","ts":"2026-11-12T11:50:21.389Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/4","value":{"created_at":"2026-11-12T11:50:21.388Z","author":"harness:claude-code","text":"PR 1712 CodeRabbit full review on aaf184261, addressed in this PR. (Outside diff, Major) Stripping userinfo collapsed distinct new identities, such as https://alice:x@host and https://bob:y@host, into one principal. Identities carrying URL userinfo are now refused with invalid_argument_value at every write point: resolveAuthorIdentity for --author, PM_AUTHOR and default_author; --assignee on create and update; and identity keys in create metadata and runtime update fields. This is the issue's own first option, and nothing credential-bearing or collapsed is stored. (Major) Claim and release results now return a redacted item copy. (Minor) Runtime update fields are covered by the same refusal inside collectRuntimeUpdateFieldValues. (Minor, heavy lift) Object-key payload scanning was filed as pm-3fbj1f.\n"}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T11:50:21.389Z"}],"before_hash":"6c325317ee879a1fe78a2b147ed083a8f8a39b710905ceaba1c8f3634b4315bc","after_hash":"c37dad32f92cd2ae4c3f31c9843bbc3b028df692896aa2e54e99b94196862cf9","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"81e6c2821b0c361978d5026a952017e3e50bf6be370e0defdd434042f3f05135"}
{"hash_algorithm":"sha256","ts":"2026-11-12T13:06:19.062Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/5","value":{"created_at":"2026-11-12T13:06:19.062Z","author":"harness:claude-code","text":"PR 1712 final Codex round 3 (P2), fixed in this PR. A percent-encoded at sign in the authority (ssh://Zq8vN3kLmP0wXy7Ab%40github.com/repo@v1) passed the provably-public exemption, but Git decodes the authority into token userinfo. Any percent escape in the authority now keeps the conservative span. The case is in the spec.\n"}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T13:06:19.062Z"}],"before_hash":"c37dad32f92cd2ae4c3f31c9843bbc3b028df692896aa2e54e99b94196862cf9","after_hash":"4c0d3904c0c1c69285041e641bc9ab8bd60f8e7c859458f87367fbba0309e49d","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"e753c78332f98c71efd17b1e932d72bbc512e9fe73090c975451062f32e65a29"}

olds the lock for the configured wait window without progress, or a hard ceiling is reached; Every observed owner handoff (token change or release) restarts the no-progress window; Explicit maxWaitMs ceilings (background consumers) and wait 0 fail-fast are unchanged; The conflict receipt reports waited time and observed owner handoffs; A multi-process conformance test runs many concurrent writers (comments + parented creates) on one non-git tracker and loses zero writes under default settings; Docs for locks.wait_ms and PM_LOCK_WAIT_MS describe the no-progress semantics"},{"op":"add","path":"/metadata/parent","value":"pm-dj98"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-gh1549","kind":"related","created_at":"2026-10-22T18:10:30.531Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"},{"id":"pm-lvyd","kind":"implements","created_at":"2026-10-22T18:10:30.531Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"9958b0aa7c75ee613f55463303b67735ee19324514945c6c5134c87eadff1fff","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"2ce49d134041c1105a110d577ea5a5e05ba834af6e99767f5670036627d36822"}

{"hash_algorithm":"sha256","ts":"2026-11-12T20:13:44.115Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T20:13:44.115Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-12T20:13:44.114Z","author":"harness:claude-code","text":"PR 1714 Greptile, fixed in this PR: the walk skipped recursion when an identity key held an object, so {audit_details: {author: {author: url}}} passed. The walk now recurses into every container, including one stored under an identity key; the case is in the spec.\n"}]}],"before_hash":"fe4489dd82fc5037d5269f03fce4a6dde097843d8b9d248dcbe42fbd5267a0f4","after_hash":"aad1ab3aa6ad3c728a321263dfa1722a1ec89452a80d0385e8ffe396d7493148","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"d5c6a8231ff9feed2b926f30c875848306a0635b9f92ce50bdb1da76afaed44a"}
{"hash_algorithm":"sha256","ts":"2026-11-12T21:00:55.741Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"6cac702086723f6d9ab0b467","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-12T21:00:55.740Z","author":"harness:claude-code","text":"PR 1714 Codex review (P2), fixed in this PR: the recursive walk judged every nested key named author, so a linked test whose assert_json_field_equals map checks an author field holding a public URL with an at sign in its path (an example.com profile URL) was refused at create. pm reads identities only at declared locations, so the walk now follows a declared table: the top-level author, assignee and claim_principal plus the entry paths comments/notes/learnings/dependencies/plan_decisions/plan_discoveries author and tests provenance author. A container stored at one of those locations is still identity data throughout (bounded at depth 4), so author holding an object with a nested URL credential stays refused. An author key in arbitrary field data, such as an assertion map or audit_details, is no longer judged. The refusal now names the entry path, for example comments[0].author.\n"}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T21:00:55.741Z"}],"before_hash":"aad1ab3aa6ad3c728a321263dfa1722a1ec89452a80d0385e8ffe396d7493148","after_hash":"48f0adcdebb6e21330cd95b609ffcd868d9ace26047fb7c5d0f0e4bb50e162d8","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"0be78bf93cad1cd5ad39a2b5ae39556df2b91d67f70a6232644e5a73780df428"}

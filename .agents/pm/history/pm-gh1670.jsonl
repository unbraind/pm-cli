{"hash_algorithm":"sha256","ts":"2026-11-05T21:19:04.453Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"77179288e1d1c04bcc4da0e8","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-998juj","claim:pm-gh1670","lineage:pm-gh1670","lineage:pm-5t33or","lineage:pm-n7rr","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"workset:pm-998juj+pm-gh1670","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-998juj","claim:pm-gh1670","lineage:pm-gh1670","lineage:pm-5t33or","lineage:pm-n7rr","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.318","source":"probe"}},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-05T21:19:04.453Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-11-05T21:19:04.453Z","author":"harness:claude-code","text":"Design decision: compose, not refuse. list, graph and deps refuse --summary or --brief together with --full as a usage conflict, because there --full is purely a projection. For health, --full is first a check-scope flag: it overrides --check-only fast paths and the skip flags, and its help says it runs all checks including the slow integrity, drift and vectorization checks. The projection was a side effect. Fleet CI gates already call pm health --full --summary, so a refusal would break them with exit 2 on upgrade.\n\nThe flags now compose. --full decides which checks run. An explicit --summary, otherwise an explicit --brief, decides the projection. --full alone still returns complete details. --strict-exit implies the summary only when --full is absent, so --strict-exit --full keeps its documented complete details.\n\nMeasured on a one-item sandbox tracker: plain --summary already runs every check, with omitted_checks empty. --check-only --summary omits integrity, history_drift and vectorization. --check-only --full --summary now runs all ten checks and returns the summary with omitted_checks empty, and that summary is far smaller than --full (636 B against 15,704 B for the pair before the fix).\n\nThe negative control was run: reverting the three source edits fails five assertions across the new integration spec and the projection contract spec."}]}],"before_hash":"f74aa5f6483c3dda316cf62475d16f8d31d4469928b748526f60ebd3ba1ca300","after_hash":"56f4a027b7093450bb703c0f14171a45a9592eb975b31c0c50a762141fe5cbd0","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"7f5f6303b3a40a2651cec12f673ef2438521bbe99174fb1568a1d880287ec522"}

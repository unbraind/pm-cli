{"hash_algorithm":"sha256","ts":"2026-11-28T13:55:25.922Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"39f0409326ff3a93bdf4de17","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-x17o8l","lineage:pm-x17o8l","lineage:pm-8jdc","lineage:pm-doxj"]},"topic":{"value":"pm-x17o8l","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-x17o8l","lineage:pm-x17o8l","lineage:pm-8jdc","lineage:pm-doxj"]},"version":{"value":"2.1.332","source":"probe"}},"op":"close","patch":[{"op":"replace","path":"/metadata/actual_result","value":"Built CLI: statuses.json [{id:triage, description:5, aliases:[3,'tri'], order:'x'}, null] and types.json [{name:Spike, description:5, aliases:[5,'spk'], folder:3, execution_role:'humna', bad options and policies}, {name:''}] keep id_prefix zz- with only runtime_schema_*_entry_invalid:1 warnings, while 2026.11.27 resets to pm- with settings_read_merge_failed. validate lists every ignored member under schema_status_definition_losses and schema_type_definition_losses, and 37 focused tests pass with 100% coverage of the added lines"},{"op":"replace","path":"/metadata/expected_result","value":"A status or type schema-file entry with any wrong-typed member no longer fails the settings read, and validate names each ignored member with its file and position"},{"op":"remove","path":"/metadata/claim_principal"},{"op":"remove","path":"/metadata/assignee"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-28T13:55:25.922Z"},{"op":"replace","path":"/metadata/status","value":"closed"},{"op":"add","path":"/metadata/closed_at","value":"2026-11-28T13:55:25.905Z"},{"op":"add","path":"/metadata/completed_at","value":"2026-11-28T13:55:25.905Z"},{"op":"add","path":"/metadata/resolution","value":"Status entries are read by inspectRuntimeStatusDefinition, so a non-string description is ignored and bad aliases, roles and order are reported. Type entries from schema/types.json pass through inspectItemTypeDefinition, the coercion the registry already used for extension registrations, now shared, before normalization. A wrong-typed member is ignored and the rest of the entry and of the settings load. An unknown execution_role in a file fails closed as human, and an extension registration still refuses it. pm validate --check-metadata names each dropped or partly read entry with its file and position (validate_schema_{status,type}_definition_{dropped,partial})."},{"op":"add","path":"/metadata/close_reason","value":"Wrong-typed status and type schema-file members are ignored and reported instead of resetting every setting"}],"before_hash":"1037bcb15f5a2eab8f1c7e5582fde614ddead10a7fde00b675c68fde36dfbd2b","after_hash":"f51cc9e04b366688b3bdbdb6e165ef0da62c9aefa936da1fe7f94c8c3bc8e9ea","item_hash_version":3,"context":{"completion":{"timestamp":"2026-11-28T13:55:25.905Z","source":"close_time"},"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"1074a06756d0b6fed0037964b2d6b88392b0d4322d7410b385c828a2ded07177"}

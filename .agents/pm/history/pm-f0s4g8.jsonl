{"hash_algorithm":"sha256","ts":"2026-11-28T13:57:31.272Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"39f0409326ff3a93bdf4de17","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-f0s4g8","lineage:pm-f0s4g8","lineage:pm-ugqx","lineage:pm-doxj"]},"topic":{"value":"pm-f0s4g8","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-f0s4g8","lineage:pm-f0s4g8","lineage:pm-ugqx","lineage:pm-doxj"]},"version":{"value":"2.1.332","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-28T13:57:31.271Z","author":"harness:claude-code","text":"Root cause (2026-11-28): two transport stages in src/sdk/runtime/schema.ts drop the blank string before runSchemaAddField sees it. readRuntimeString treats a whitespace-only cliFlag as absent, and the shared alias reader readRuntimeStringArray filters out empty entries. Decision: keep the generic transport rule (93 readRuntimeString call sites rely on blank = omitted for author, path, limit and the like). Add-field gets its own exception, because it is the receiver that judges supplied spellings: readSuppliedSpelling passes any supplied string for cliFlag (top-level args first, then options), and the add-field alias list keeps every entry. Result: cliFlag ' ', '' and '--' and alias [''] or ['  '] are refused with schema_field_flag_invalid through PmClient.schemaAddField, run('schema') and MCP, exactly as the CLI refuses them. An omitted cliFlag still registers the default flag."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-28T13:57:31.272Z"}],"before_hash":"f37b5984a9c23916dfd4b10037a269393d8e53f31ec1185e95312182a1fe764d","after_hash":"72cfa6f515911dac6a4647cffebf56d35b600ef160f58d667d9f341789d1dede","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"ae9b1ced6637feaf1c09952739da502271ec29db14efb51becb0aedd97ef943b"}

{"hash_algorithm":"sha256","ts":"2026-11-12T06:48:41.698Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"72bc6070cdf8e143b3ffadf4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-12T06:48:41.698Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-12T06:48:41.698Z","author":"harness:claude-code","text":"PR 1711 Codex review (P2), fixed in this PR. The runtime guide catalogue in src/sdk/guide-topics.ts still listed docs/RELEASING.md as a required document of the release topic, so on an npm install pm guide release at standard or deep depth would warn 'Missing required guide document: docs/RELEASING.md'. The same topic already listed scripts/release/run-gates.mjs, which the package never shipped, so that warning predated this change. Both entries are now optional and say they exist only in a repository checkout. The docs-skills gate could not see the gap because it runs guides from the checkout. It now also applies package.json files in npm order (isPackagedPath) and fails when a required guide document is not shipped (validateGuideDocsPackaged); the spec covers a negated pattern, a dot-directory and the real repository.\n"}]}],"before_hash":"23317824c1e84e5f16b6497fdbb90c641b75676cc23bc796273d70ec62df3df1","after_hash":"0ec27fe6b01cea0eae8832cb3e810a947aa673f7d5f033dca7ea206e07d5a974","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"d4a8985db5bc72
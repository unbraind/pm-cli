{"hash_algorithm":"sha256","ts":"2026-11-14T17:28:40.361Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"dec610b5c29dc08047ecfcc1","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1726","claim:pm-gh1727","claim:pm-gh1728","claim:pm-gh1729","lineage:pm-gh1729","lineage:pm-ugqx","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1726+pm-gh1727+pm-gh1728+pm-gh1729","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1726","claim:pm-gh1727","claim:pm-gh1728","claim:pm-gh1729","lineage:pm-gh1729","lineage:pm-ugqx","lineage:pm-doxj"]},"version":{"value":"2.1.325","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-14T17:28:40.360Z","author":"harness:claude-code","text":"Bundled-package census before the refusal (2026-11-14): grepped every bundled package's handler reads of context.options and importer options. pm-vcs reads parent and at, both declared; the beads and todos importers read file, backupDir, preserveSourceIds, folder and message, all declared, and author, which is host-owned. pm-calendar's meet, event and remind read inheritFocus without declaring it, so only direct callers could ever set it and the CLI refused --no-inherit-focus as unknown; tests/unit/packages/calendar-shortcuts.spec.ts failed on the new refusal (Unknown option 'inheritFocus' for extension command 'meet'). Fixed by declaring --inherit-focus (boolean, help text shortened to stay inside the flag-help token ratchet) in the package's common flags; on the built CLI pm meet --no-inherit-focus now creates the meeting without the focused parent, which was impossible before."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-14T17:28:40.361Z"}],"before_hash":"168945ab78c520f7bbf084d8b2b482e2250abdebd82cb52766747e21a8cd03d8","after_hash":"5e6a9ad0d75553133d0d4cf696b568e581f724d2531f39626d4cee9ac8f9d3eb","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"2760fc4a10bef8d08cd621d26f90b8f738a1692561f114c04bad5953e163dace"}

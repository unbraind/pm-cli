{"hash_algorithm":"sha256","ts":"2026-11-14T19:16:38.135Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"dec610b5c29dc08047ecfcc1","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"release-operator","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1727","claim:pm-gh1728","claim:pm-gh1729","release:pm-gh1726"]},"topic":{"value":"workset:pm-gh1727+pm-gh1728+pm-gh1729","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1727","claim:pm-gh1728","claim:pm-gh1729","release:pm-gh1726"]},"version":{"value":"2.1.325","source":"probe"}},"op":"close","patch":[{"op":"replace","path":"/metadata/actual_result","value":"Specs pass for PmClient.run, the harness and the in-process CLI with a handler-run negative control (one run after every refusal); pm meet --no-inherit-focus creates an unparented meeting on the built CLI; linked run passed 34/34; Codex rounds 1-5 findings fixed"},{"op":"replace","path":"/metadata/expected_result","value":"A missing required flag, an undeclared key and a disabled flag are refused with stable codes before dispatch for PmClient.run and the harness, matching the CLI; host keys and native-path options keep working"},{"op":"remove","path":"/metadata/claim_principal"},{"op":"remove","path":"/metadata/assignee"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-14T19:16:38.135Z"},{"op":"replace","path":"/metadata/status","value":"closed"},{"op":"add","path":"/metadata/closed_at","value":"2026-11-14T19:16:38.090Z"},{"op":"add","path":"/metadata/completed_at","value":"2026-11-14T19:16:38.090Z"},{"op":"add","path":"/metadata/resolution","value":"Shared refusal helpers in src/sdk/extension/command-options.ts throw literal codes for both validators: missing_required_option (flag, field = handler key, recovery.missing, example built from the declared value contract), extension_option_disabled, unknown_option. The direct path refuses a key that is neither declared nor host-owned (reserved host flags in camel/snake/dashed form, --no-* positives, force, subcommand, inputResponses, requestState) on extension-created command paths; DirectExtensionOptionPolicy keeps native paths an extension extends passing undeclared keys through (resolveDirectExtensionOptionPolicy in src/sdk/extension/native-command-options.ts). Labels use the declaration's flag token. pm-calendar declares --inherit-focus, the only bundled undeclared read."},{"op":"add","path":"/metadata/close_reason","value":"Direct callers of extension-created commands get missing_required_option, unknown_option and extension_option_disabled before the handler runs"}],"before_hash":"4d4691ed5c2a395a2c2f88be7a1ed368601edd861b850a7d20ba6e87c21efed4","after_hash":"7b26c265a3a61ce43010b024dc8073839c7a004ab7d6832c174d3c9eceeb9c42","item_hash_version":3,"context":{"completion":{"timestamp":"2026-11-14T19:16:38.090Z","source":"close_time"},"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"0be684a80e0c53bcf7d34c423f0dbef406ca8ac079b6b34503b5f930f91b2480"}

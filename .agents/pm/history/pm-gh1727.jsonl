{"hash_algorithm":"sha256","ts":"2026-11-14T19:16:09.425Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"dec610b5c29dc08047ecfcc1","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1726","claim:pm-gh1727","claim:pm-gh1728","claim:pm-gh1729","lineage:pm-gh1729","lineage:pm-ugqx","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1726+pm-gh1727+pm-gh1728+pm-gh1729","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1726","claim:pm-gh1727","claim:pm-gh1728","claim:pm-gh1729","lineage:pm-gh1729","lineage:pm-ugqx","lineage:pm-doxj"]},"version":{"value":"2.1.325","source":"probe"}},"op":"learning_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-14T19:16:09.425Z"},{"op":"add","path":"/metadata/learnings","value":[{"created_at":"2026-11-14T19:16:09.424Z","author":"harness:claude-code","text":"A harness or SDK path that claims parity with native dispatch must be checked against every stage native dispatch runs between the handler and the verdict, not only the one under test: five Codex rounds each found one more stage (native option ownership, command-result overrides, output_format structured replacement, encoding resolution, service payload). When the set of legitimate inputs on a path is open-ended (native command aliases, negations, settings-dependent runtime fields), scope the refusal to the path whose contract you fully own instead of enumerating."}]}],"before_hash":"2543a05e04b02be8ad6d88835eade32792a1f3108b6be922dbce70fa4ca7746a","after_hash":"4d4691ed5c2a395a2c2f88be7a1ed368601edd861b850a7d20ba6e87c21efed4","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","re
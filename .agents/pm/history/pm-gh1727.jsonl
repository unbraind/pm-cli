{"hash_algorithm":"sha256","ts":"2026-11-14T16:55:49.659Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"dec610b5c29dc08047ecfcc1","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1726","claim:pm-gh1727","claim:pm-gh1728","claim:pm-gh1729","lineage:pm-gh1729","lineage:pm-ugqx","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1726+pm-gh1727+pm-gh1728+pm-gh1729","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1726","claim:pm-gh1727","claim:pm-gh1728","claim:pm-gh1729","lineage:pm-gh1729","lineage:pm-ugqx","lineage:pm-doxj"]},"version":{"value":"2.1.325","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-14T16:55:49.659Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-14T16:55:49.640Z","author":"harness:claude-code","text":"Root cause (2026-11-14): normalizeDirectExtensionCommandOptions in src/sdk/extension/command-options.ts split folded options into declared and passthrough maps and passed every undeclared key straight to the handler; refuseDirectDeclarationViolations threw a bare PmCliError for a missing required flag with no context, so the code was undefined. The CLI path reported missing_required_option only because src/cli/error-guidance.ts derived it from the message text, and that heuristic printed a broken 'Pass ... for extension command ... with a valid value' hint plus pm create examples. Fix: shared refusal helpers with literal codes for both validators (missing_required_option with flag, field = handler key, recovery.missing and a command-specific example; extension_option_disabled; unknown_option), and the direct path refuses any key that is neither a declared spelling nor host-owned (reserved host flags in camel, snake or dashed form, plus the pm_run transport keys force, subcommand, inputResponses and requestState, which reach the same option record). Census before tightening: pm-presets injects resolvedParameterValues inside its own code, not through the host, and pm-linear/pm-presets runtime code makes no direct PmClient.run calls with extra keys."}]}],"before_hash":"961165733db5d0d5f0142f32263121573932ae8a888488fe2957fcb5f05da6b7","after_hash":"3bf38270b7e2118fcec3fd1d6e72cfa4cef323e15edc1661b1e4ad74d0095107","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"07b7ac8d0251524070f467d49cedf0cdbd3c78680c75fc59d62426289dcfc42d"}

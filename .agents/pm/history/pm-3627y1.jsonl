0 ms in total) and a 512 KB run (under 1 s; quadratic would take minutes). node scripts/check-secrets.mjs stays clean over every tracked file.\n"}]}],"before_hash":"5e09878481b4935cba0168400b0c4ca638dd786d08cdbe68f768513f504ee5aa","after_hash":"2f45b5a85d110511a53a5e446c17218edd85b4c87be88240a57c6eef308bde46","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"6ad6cce37d8a2bf3c50225d240328ff80182575b3c62c2e799d32b8600418361"}

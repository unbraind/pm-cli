tover 'text=' prefix in that fallback is pm-fr10t8's territory.\n\nRegression specs: parse-utils.spec.ts covers both grammars and Path/path; linked-artifact-note-recovery.spec.ts covers files --add, --dep and test --add."}]}],"before_hash":"427d6e0ee7f02a8eb1a02cf15fc83353d2ab9004bf21c20b77f7b819a9d1cc3a","after_hash":"403bf618f3d34fb1388d796be631f6e34af347eae3077f4691cf8c25bbb353c3","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"ea53100b70c3514ebd041c3fc70fda5167e0a283fb32cca66ac52441c03f7924"}

{"hash_algorithm":"sha256","ts":"2026-11-22T12:27:03.471Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-fable-5-2","agent_model_source":"probe","agent_instance":"ab4bb49999c22e44f166c80b","agent_provenance":{"model":{"value":"claude-fable-5-2","source":"probe"},"effort":{"value":"medium","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-3kdt1d","claim:pm-jvb9pk","lineage:pm-3kdt1d","lineage:pm-u9d0","lineage:pm-doxj"]},"topic":{"value":"workset:pm-3kdt1d+pm-jvb9pk","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-3kdt1d","claim:pm-jvb9pk","lineage:pm-3kdt1d","lineage:pm-u9d0","lineage:pm-doxj"]},"version":{"value":"2.1.330","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-fyg1hl"},{"op":"add","path":"/metadata/title","value":"A configuration-only settings scope does not expire for work captured inside it, so a deferred SDK read keeps seeing no file-backed schema fields"},{"op":"add","path":"/metadata/description","value":"Found by review of the host-client preview path. PmClient.previewItemMutations and itemTransactions.status run their extension activation inside runWithConfigurationOnlySettings. A callback captured during that activation and run after the preview settled still carries the configuration-only policy in its async context, so a later same-tracker read such as schemaListFields returns no file-backed fields. The ordinary client path has had this shape since previews were introduced; the host-client path gained it when host transactions started to activate their own tracker. The extension scope already expires on settle (live flag); the settings policy layer has no equivalent."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":3},{"op":"add","path":"/metadata/tags","value":["area:sdk","scope-lifetime","settings"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-22T12:27:03.471Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-22T12:27:03.471Z"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/estimated_minutes","value":90},{"op":"add","path":"/metadata/acceptance_criteria","value":"runWithConfigurationOnlySettings marks its layer expired when its callback settles and readers skip an expired layer; A spec captures a read inside a preview's activation, runs it after the preview settles, and sees file-backed schema fields"},{"op":"add","path":"/metadata/parent","value":"pm-9rgaal"},{"op":"add","path":"/metadata/risk","value":"low"},{"op":"add","path":"/metadata/confidence","value":"medium"},{"op":"add","path":"/metadata/expected_result","value":"A settings policy layer ends when the call that opened it settles; deferred work reads ordinary settings"},{"op":"add","path":"/metadata/actual_result","value":"Deferred work captured inside a preview keeps configuration-only settings indefinitely"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-zi34i1","kind":"discovered_from","created_at":"2026-11-22T12:27:03.471Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"c48fe300387367a9a79ce509f936326ea3c8fb6a8e9d52a598c9f67633dd158d","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"b8c2f092932e0b36a44a1b0c6a8b22932f061e390448adb92435138967af9a88"}

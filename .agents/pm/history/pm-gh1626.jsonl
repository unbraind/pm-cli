/actual_result","value":"Generated probe over 12 declaring surfaces: 38/38 misspellings corrected and every advertised retry exits 0, against 7/38 on base d9c4a0bca. search --depth brief lists 'Completeness controls accepted by pm search: --compact, --full.' 76 generated SDK cases, the CLI integration test, the runtime-boundary no-deps --version test and linked tests all pass. Full suite 11,666 passed; the remaining failure is environmental and passes with NODE_PATH."},{"op":"add","path":"/metadata/close_reason","value":"Same-command completeness corrections are derived from runtime contracts on every declaring read surface."}],"before_hash":"3bc99ef4426432f19546fe783e04c104d8d928c3bf2ab8ce2217025fb55c1521","after_hash":"2cecc5994b524107d6dbc21722eaae0f1d3111d38c9cb0c531798cd308213404","item_hash_version":3,"context":{"completion":{"timestamp":"2026-10-30T13:53:11.799Z","source":"close_time"},"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"046fd9ad78ae68588cdf8d930ab12086cf0a5381bb0648fca60cfb0fba6aa18d"}

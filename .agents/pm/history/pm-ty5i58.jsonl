sue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-10-12T13:31:06.760Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-12T13:31:06.760Z"},{"op":"add","path":"/metadata/author","value":"harness:codex"},{"op":"add","path":"/metadata/estimated_minutes","value":120},{"op":"add","path":"/metadata/acceptance_criteria","value":"Direct and functional typed SDK helpers persist string, number, and boolean correctly; omitted type retains the documented default; installed Node/Bun consumers exercise non-string registration; independent pre-fix control fails on the persisted type; exact full-source coverage and SDK contracts remain intact."},{"op":"add","path":"/metadata/parent","value":"pm-atfm"},{"op":"add","path":"/metadata/risk","value":"medium"},{"op":"add","path":"/metadata/confidence","value":"high"},{"op":"add","path":"/metadata/expected_result","value":"Typed custom field registration persists its documented type and validates/coerces values consistently with the schema action."},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-i4kxx1","kind":"related","created_at":"2026-10-12T13:31:06.760Z","author":"harness:codex","source_kind":"cli:create:dep","author_source":"detected"},{"id":"pm-vhbf","kind":"discovered_from","created_at":"2026-10-12T13:31:06.760Z","author":"harness:codex","source_kind":"cli:create:dep","author_source":"detected"}]},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-10-12T13:31:06.760Z","author":"harness:codex","text":"Duplicate check: complete all-status corpus plus fresh schemaAddField/fieldType search and open/in_progress inventories found no active owner. Closed pm-vhbf and earlier custom-field fixes remain completed historical lineage. This SDK consumer defect fits the current connected primitive/customization delivery."}]}],"before_hash"
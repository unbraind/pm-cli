{"hash_algorithm":"sha256","ts":"2026-11-08T13:07:47.782Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"1c7226cdcb831e4341d98ac7","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-e3hfv8","claim:pm-fkhdy8","claim:pm-rrwh2o","claim:pm-sbqn4h","lineage:pm-sbqn4h","lineage:pm-mpbb","lineage:pm-doxj"]},"topic":{"value":"workset:pm-e3hfv8+pm-fkhdy8+pm-rrwh2o+pm-sbqn4h","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-e3hfv8","claim:pm-fkhdy8","claim:pm-rrwh2o","claim:pm-sbqn4h","lineage:pm-sbqn4h","lineage:pm-mpbb","lineage:pm-doxj"]},"version":{"value":"2.1.319","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-08T13:07:47.782Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-08T13:07:47.782Z","author":"harness:claude-code","text":"Implementation evidence, branch fix/annotation-read-fidelity. Reproduced on main dbe6be164 with the built CLI. pm get <id> --fields id,linked rendered linked.files but dropped linked.tests: [] and linked.docs: []; --fields id,schedule dropped schedule.reminders: [] and schedule.events: []; JSON kept all four. The cause: restoreRequestedEmptyItemCollections restored only top-level keys of item, while linked, schedule, claim_state, children and blockers are envelope facets beside item. Fix: the facet roots moved from src/sdk/query/get.ts into src/sdk/query/get-facet-roots.ts, an import-free module the core renderer can read without loading the get command. restoreRequestedEmptyCollections now restores recursively inside item and every selected facet. restoreEmptyCollections re-inserts every source-empty array or object at any depth around what the sparse policy kept. Array rows align by position when the policy kept every row; when it dropped some, the dropped rows are re-derived from the same policy. Nulls stay dropped, as the existing sj66lm spec pins for top-level item fields. Non-facet envelope keys keep the sparse policy. JSON, SDK and MCP output are unchanged; only the TOON renderer changed. The spec covers a nested scalar-plus-empty-array field (plan_scope.paths, nested.more), facets, array-of-array rows and a negative control without the selection flag."}]}],"before_hash":"f02d1a7e00a44e26d8b87df7aabdf73917a237290c789517c29c563f38a4da7b","after_hash":"538303f8a24e5d08b0c692e6500615f101d10b5a434c7ae7f67d244387c22d68","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"6900e19c632386142f431bf56c20842de590d991da0880229b7f5fb60e75bad8"}

{"hash_algorithm":"sha256","ts":"2026-11-07T09:07:11.835Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"54ac87379db6592d81af1cc6","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1665","claim:pm-gh1666","claim:pm-gh1667","lineage:pm-gh1667","lineage:pm-9rgaal","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1665+pm-gh1666+pm-gh1667","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1665","claim:pm-gh1666","claim:pm-gh1667","lineage:pm-gh1667","lineage:pm-9rgaal","lineage:pm-doxj"]},"version":{"value":"2.1.319","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-y26mvc"},{"op":"add","path":"/metadata/title","value":"pm comments/notes <id> --add --file <path> is refused as positional-and---add conflict instead of naming the swallowed --file flag, so the annotation flag-like check from pm-vcu7 loses precedence"},{"op":"add","path":"/metadata/description","value":"Found 2026-11-07 while reading telemetry: comments is the top failing command (255 finish failures in 24 h, automation context). Repro on 2026.11.7: pm comments <id> --add --file note.md exits 2 with code command_failed and detail 'Specify comment text either as positional [text] or with --add, not both'. Commander binds --file as the value of --add, so note.md becomes positional text and the positional/--add conflict check fires first. The same shape hits --add --stdin x and pm notes/learnings. Without a trailing operand the pm-vcu7 guard does fire (annotation_flag_like_value), but its recovery says 'Use --stdin to read stdin' even when the swallowed flag was --file, so the agent is not told that --file <path> works on its own. pm-vcu7 is closed and its AC covered notes --add --stdin, learnings --add --file and comments --add --stdin without a trailing operand; this is the operand-following composition it did not test. Duplicate check: searched comments --add --file, flag-like annotation values, positional and --add conflict across all statuses; pm-vcu7 (closed, fixed), pm-hcco and pm-yp56 are the nearest and do not cover this precedence."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["agent-ux","annotations","comments","recovery","recurrence"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-07T09:07:11.835Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-07T09:07:11.835Z"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/estimated_minutes","value":60},{"op":"add","path":"/metadata/acceptance_criteria","value":"pm comments|notes|learnings <id> --add --file <path> and --add --stdin <operand> refuse with annotation_flag_like_value (not command_failed), before the positional/--add conflict check; The recovery names the swallowed flag's own form: for --file it says to drop --add and pass --file <path>, for --stdin to drop --add; The executable retry, when offered, runs successfully against a sandbox tracker; Regression tests cover each annotation command with a trailing operand, with a negative control that restores the old check order"},{"op":"add","path":"/metadata/parent","value":"pm-f05lsg"},{"op":"add","path":"/metadata/risk","value":"low"},{"op":"add","path":"/metadata/confidence","value":"high"},{"op":"add","path":"/metadata/severity","value":"low"},{"op":"add","path":"/metadata/repro_steps","value":"pm comments <id> --add --file note.md --json"},{"op":"add","path":"/metadata/expected_result","value":"annotation_flag_like_value naming --file: drop --add and pass --file note.md"},{"op":"add","path":"/metadata/actual_result","value":"command_failed: Specify comment text either as positional [text] or with --add, not both"},{"op":"add","path":"/metadata/affected_version","value":"2026.11.7"},{"op":"add","path":"/metadata/component","value":"annotations"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-hcco","kind":"related","created_at":"2026-11-07T09:07:11.835Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"},{"id":"pm-vcu7","kind":"related","created_at":"2026-11-07T09:07:11.835Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"},{"id":"pm-yp56","kind":"related","created_at":"2026-11-07T09:07:11.835Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"e5d24b4add5087f03994e207726e6eef5b407935baedaf751e98d10fed18db25","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"ef659a70264b452e760d01c0619e84b780f238b7140c2f0c71a0a2319d094c1f"}

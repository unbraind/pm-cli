{"hash_algorithm":"sha256","ts":"2026-11-20T14:31:22.483Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"4b084a2f74dd44054f4b141a","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.329","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-20T14:31:22.483Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-20T14:31:22.482Z","author":"harness:claude-code","text":"CodeRabbit (review of 1b1bd929c) pointed out that the close text overstated the outcome. A non-string recorded harness is ignored, so an author with a vocabulary alias still resolves as harness_source vocabulary; unresolved applies only when no alias matches. The acceptance criteria and expected result now say so. The spec's author has no alias, so its unresolved assertion is that fallback."}]}],"before_hash":"16279f11999f06c56a85e5c8bbee6cb3b1fdfe6fbc436b575162194db808d453","after_hash":"29aed462b56b9635c48adea5ced04f2ab574dc1df9db0fbbdecc178b94d3bb8a","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"e2ca7a2fb46ef47c961b3a1e650fc9c431a2fe751dbf8115aab9e94cbdd12168"}

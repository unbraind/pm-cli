{"hash_algorithm":"sha256","ts":"2026-11-04T07:57:54.450Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"436e44ca2d204a1ee603915a","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.317","source":"probe"}},"op":"update","patch":[{"op":"replace","path":"/metadata/acceptance_criteria","value":"A null on a clearable update field (one the update unset table covers) clears it in every update-many spelling (runAction flat, runAction nested and direct runUpdateMany) exactly like a single update; it is never silently dropped; A null on a non-clearable update field (for example title) refuses naming the field in every update-many spelling, exactly as a single update refuses it; Flat and nested update-many spellings of the same request produce the same rows, clears and refusals alike, with a spec for each spelling; A flat null on a key that is a selection filter rather than an update field is refused naming the key, never applied as a clear"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-04T07:57:54.450Z"}],"before_hash":"7fcc2a50c03ba89404e4a92e754111378c7701d34deb07503ba8259174baa9ab","after_hash":"46a771bed3199cb5c3f03e7eb8854f3fda0e8e20c4807a0f51e706f98959bdc7","item_hash_version":3,"message":"Cover every update-many spelling (CodeRabbit PR 1658)","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"0ecb2315e07bc4b02b8b142721b687200bf6f2fa69af147431888e79dfdd7f6a"}

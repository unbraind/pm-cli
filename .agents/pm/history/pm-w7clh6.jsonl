{"hash_algorithm":"sha256","ts":"2026-11-04T07:57:53.166Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"436e44ca2d204a1ee603915a","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.317","source":"probe"}},"op":"update","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-04T07:57:53.166Z"},{"op":"replace","path":"/metadata/description","value":"Found by Codex review of the GH-1655 change (pm-gh1655) and corrected by CodeRabbit on PR 1658. In runAction('update-many', ...) both spellings normalize a null update field to undefined before resolveUpdateTransportOptions sees it: { ids: [id], assignee: null, description: 'changed' } and { ids: [id], update: { assignee: null, description: 'changed' } } both change the description and silently keep the assignee (reproduced on the PR 1658 build in a sandbox). Only a direct runUpdateMany call whose update record still carries the null reaches the pm-gh1655 fold. pm-gh1655 therefore kept update-many out of the null-clear contract (PmUpdateManyActionOptions stays non-nullable)."},{"op":"replace","path":"/metadata/title","value":"update-many silently drops a null update field in both the flat and nested runAction transports instead of clearing it or refusing"}],"before_hash":"8be4ed87025ce02ac64c3ed92b08cd836774cd3aa68f8403bccda8bd4a8dbc66","after_hash":"e50f69dc7a64bf53fd3555c0f14e6a8521bd252254b393cefb32de4df011dde2","item_hash_version":3,"message":"Correct the diagnosis: the nested runAction form drops null too (CodeRabbit PR 1658)","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"982f485e1918f7725031790f9ac86530309a9267ce746fc89dc9f440828b47eb"}

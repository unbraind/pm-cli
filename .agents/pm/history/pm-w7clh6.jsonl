{"hash_algorithm":"sha256","ts":"2026-11-04T12:20:04.692Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"436e44ca2d204a1ee603915a","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.317","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-04T12:20:04.692Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-04T12:20:04.691Z","author":"harness:claude-code","text":"Direct SDK spelling covered on PR #1658 (CodeRabbit review of fdb25f6f0). A direct runUpdateMany from the SDK (src/sdk/lifecycle/update-many.ts) folds a null in its update record into unset through resolveUpdateTransportOptions, exactly like runUpdate, and clears every matched row. The CLI compatibility wrapper (src/cli/commands/lifecycle/update-many.ts) marks the record as CLI input, so the same null is refused as 'update assignee must be a string.' New spec in update-many-command.spec.ts asserts both, plus the by-name refusal of title: null. The two runAction spellings, which drop the null before the fold, remain this item's scope. CodeRabbit suggested refusing the null on the direct path. That was declined, because it would contradict this item's first acceptance criterion (a null clears in every update-many spelling)."}]}],"before_hash":"6ccee77fa1668664a7e110897e55e2b436e73005c3b3cecfeb999b8790c13e85","after_hash":"68b66acc64d276965b3344cb7654208e865f3e9213c9a3b391d95adaa2d28aff","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"e656cea5588b42
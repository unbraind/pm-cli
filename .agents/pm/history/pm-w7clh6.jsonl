{"hash_algorithm":"sha256","ts":"2026-11-03T23:06:21.402Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"436e44ca2d204a1ee603915a","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1655","claim:pm-mrvq8u","claim:pm-thbdxu","lineage:pm-thbdxu","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1655+pm-mrvq8u+pm-thbdxu","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1655","claim:pm-mrvq8u","claim:pm-thbdxu","lineage:pm-thbdxu","lineage:pm-doxj"]},"version":{"value":"2.1.317","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-w7clh6"},{"op":"add","path":"/metadata/title","value":"update-many silently drops a null update field in the flat transport instead of clearing it or refusing"},{"op":"add","path":"/metadata/description","value":"Found by Codex review of the GH-1655 change (pm-gh1655). updateManyOptionsFromFlat in src/sdk/runtime-input.ts normalizes a flat update field whose value is null to undefined, so runAction('update-many', { ids: [id], assignee: null, description: 'changed' }) changes the description and silently keeps the assignee. The nested form ({ update: { assignee: null } }) reaches resolveUpdateTransportOptions and is folded into unset by pm-gh1655, so the two spellings of one request disagree. The flat form mixes selection filters and update fields in one record, which is why pm-gh1655 kept update-many out of the null-clear contract (PmUpdateManyActionOptions stays non-nullable)."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":3},{"op":"add","path":"/metadata/tags","value":["bulk","pm-gh1655","sdk","update-many"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-03T23:06:21.402Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-03T23:06:21.402Z"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/estimated_minutes","value":90},{"op":"add","path":"/metadata/acceptance_criteria","value":"A flat update-many payload with a null update field either clears it like the nested form or refuses naming the field and the unset form; it never silently drops it; Flat and nested update-many spellings of the same request produce the same rows, with a spec for each"},{"op":"add","path":"/metadata/parent","value":"pm-9rgaal"},{"op":"add","path":"/metadata/risk","value":"low"},{"op":"add","path":"/metadata/confidence","value":"high"},{"op":"add","path":"/metadata/severity","value":"low"},{"op":"add","path":"/metadata/expected_result","value":"A null update field in a flat update-many payload clears or refuses"},{"op":"add","path":"/metadata/actual_result","value":"The flat payload drops the null field silently while the rest of the update applies"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-gh1655","kind":"discovered_from","created_at":"2026-11-03T23:06:21.402Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"fa58f976ea9800d82201b35e433fc6ac4cd16891a12e245196bdbe0759b6604f","item_hash_version":3,"message":"File update-many flat null follow-up","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"c091014f1bd4df8a3f11441fa5e5f0672df898074f514d830df193be97126ce1"}

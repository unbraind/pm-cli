{"hash_algorithm":"sha256","ts":"2026-11-14T22:05:20.907Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"dec610b5c29dc08047ecfcc1","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.325","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/7","value":{"created_at":"2026-11-14T22:05:20.906Z","author":"harness:claude-code","text":"CodeRabbit review on PR #1732 (head 35a0623a7): the renderer and exit-code findings were already fixed in 7fa0738ee. The Major finding is valid and fixed: native delivery marks an omitted-for-budget read with process.exitCode ||= 2 and renders the refusal instead of throwing, so the harness returned the original success. The harness now clears the exit code for the synchronous formatting call, observes the mark, restores the caller's value, and throws output_budget_exceeded (exit 2). The trivial finding (a budgeted harness case beside the unbudgeted one) is added to direct-caller-option-contract.integration.spec; harness-parity.spec checks the caller's exit code (undefined and 1) is preserved."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-14T22:05:20.907Z"}],"before_hash":"57a995708e2cb0e0a6d3f9fc57453e5621ccb1c523423c6f855d602d61c8bfce","after_hash":"21cd089694d62fb8fc381d925000b4b40844643d60286408baa2c169c68f2f61","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"7d47b7cec78468669ce833adeefa6b8f3c484560c8dbf13545e929f8daf4b234"}

{"hash_algorithm":"sha256","ts":"2026-11-14T16:56:07.237Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"dec610b5c29dc08047ecfcc1","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1726","claim:pm-gh1727","claim:pm-gh1728","claim:pm-gh1729","lineage:pm-gh1729","lineage:pm-ugqx","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1726+pm-gh1727+pm-gh1728+pm-gh1729","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1726","claim:pm-gh1727","claim:pm-gh1728","claim:pm-gh1729","lineage:pm-gh1729","lineage:pm-ugqx","lineage:pm-doxj"]},"version":{"value":"2.1.325","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-14T16:56:07.237Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-14T16:56:07.237Z","author":"harness:claude-code","text":"Root cause (2026-11-14): attachExtensionReadOutputRows (src/sdk/read-output/extension.ts) refuses a result that lacks a declared row collection before projection or any output_format service runs, which is intended: declared row_keys are a promise. runRegisteredCommandForTest never ran that check, so a receipt-only handler passed package tests and failed natively. Fix: the check is extracted as assertExtensionReadOutputResult and the harness applies it to every handled result of a command whose last registration declares read_output, so package tests now fail with the same code and message. The refusal now also carries required/why text naming the compatible pattern: keep returning the rows (an empty collection is valid) and let the output_format service render the compact receipt. Oversized delivered output stays refused natively (output_budget_exceeded) even with valid rows; the regression fixture covers receipt-only, rows, empty rows, malformed rows and oversized delivery."}]}],"before_hash":"a3bc0dac782f94eb483d5f6461b084023d454aa6fcb9adf14e9d314a32528b10","after_hash":"9c4ca0ec6966587477b1ace9efddd33976d9db902feaecada70964bfd7ecc333","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"0be1b5fd598283648aa33179ada28642ec8980aecc136556bd1f8d6c1c0dc9d1"}

{"ts":"2026-07-02T21:55:37.614Z","author":"claude-code-agent","op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-gdi7"},{"op":"add","path":"/metadata/title","value":"Agent-UX output polish: unknown-option errors should suggest valid flags; list-closed projection too verbose; schema add-field help discoverability"},{"op":"add","path":"/metadata/description","value":"From 2026-07-02 audit (Lane A, pm-kes3): (1) unknown-option errors do not list valid flags or a nearest-match suggestion, forcing an extra contracts round-trip (agents should never be blocked by wrong flags); (2) pm list-closed defaults to the full projection (verbose for agents; closed queries are usually triage scans); (3) pm schema add-field help is buried in the shared option list, hard to discover the field-definition flags."},{"op":"add","path":"/metadata/type","value":"Task"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["agent-ux","audit-followup","cli"]},{"op":"add","path":"/metadata/created_at","value":"2026-07-02T21:55:37.614Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-07-02T21:55:37.614Z"},{"op":"add","path":"/metadata/author","value":"claude-code-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"c9fc244ce5ec55d777c60248ed83a236fec96b77927dfe1fc893402341ba7c7b","message":""}

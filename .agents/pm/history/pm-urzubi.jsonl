{"hash_algorithm":"sha256","ts":"2026-11-02T13:29:12.559Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"6da2f5f4d31f8f762cde8c96","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1576","claim:pm-urzubi","lineage:pm-urzubi","lineage:pm-33cw","lineage:pm-doxj"]},"topic":{"value":"workset:pm-gh1576+pm-urzubi","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-gh1576","claim:pm-urzubi","lineage:pm-urzubi","lineage:pm-33cw","lineage:pm-doxj"]},"version":{"value":"2.1.316","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-02T13:29:12.559Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-02T13:29:12.559Z","author":"harness:claude-code","text":"Implementation evidence (feat/write-time-preconditions): sdk/lifecycle/start-blockers.ts owns one admission check, admitStartWithOpenBlockers, governed by the new governance.start_blocker_enforcement (strict default, warn, off; pm config key governance-start-blocker-enforcement). It resolves blockers through sdk/query/declared-blockers.ts, the resolution pm get's blockers facet already used, extracted so the two cannot disagree. Terminal targets resolve; missing, unsafe and external references stay open. Hooks: runUpdate checks inside its locked mutate callback on the UPDATED metadata, so an update that removes the edge and starts in one call is admitted. runClaim(start) checks under the claim lock (claim --next --start). runStartTask pre-checks before the claim write, so a refused claim <id> --start leaves no claim, and the update re-checks under its own lock. Refusal start_blocked_by_open_dependency (exit 4) lists details.open_blockers and an executable unblock command (--unset blocked_by and/or --dep-remove id=<b>,kind=blocked_by, chosen from where the blocker is declared). Verified the advertised command then lets the start succeed. --force admits with start_blocker_override:<id>:<blockers>, and warn mode records start_with_open_blockers:<id>:<blockers>."}]}],"before_hash":"3840a105a9b2becc64f6823e5d8f1b139ac6669d1f94bb237703c72d547a7fb9","after_hash":"2ea8fc18d9c5417ab7bb1bbd47ff8d9fbf85f9d8355d5a2007fceea6bab12b21","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"325494320a3f3f9fd51d3ea65061ed0de8e019cf924815be7fe6a8f046fe7beb"}

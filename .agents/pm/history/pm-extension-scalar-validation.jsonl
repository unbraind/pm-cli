xported through runtime-primitives. Verified via a file-based extension fixture in a sandbox and through the public CLI in integration tests.\n"}},{"op":"replace","path":"/metadata/updated_at","value":"2026-10-15T12:29:34.131Z"}],"before_hash":"3225921858a4b38f4877c3d4f90e8d6640bdaea0633f11fba73029bc59716403","after_hash":"b65d39b143c4283f4257ab3a5a35ae2e97de65c4044f3aad14c9bae905649f23","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"e708e3fba3e99a079a2cdabd98572d938f8a8389fa193ddca863a269765278b6"}

{"hash_algorithm":"sha256","ts":"2026-11-20T15:23:09.895Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"4b084a2f74dd44054f4b141a","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.329","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-fh07lz"},{"op":"add","path":"/metadata/title","value":"Benchmark fixture generation does not reject a scratch root inside a Git checkout, so PmClient.init can modify that checkout's .gitattributes and Git config"},{"op":"add","path":"/metadata/description","value":"Raised by the Codex review of PR #1761 (pm-gh1664) on 2026-11-20. scripts/bench/scale-workspace.mjs generateSyntheticWorkspace, used by run-scale-benchmarks, cli-transport-floor and the new history-read-costs benchmark, creates its fixture under os.tmpdir() and checks the path only lexically. If TMPDIR lies inside another Git checkout, or reaches into this one through a symlink, PmClient.init discovers the enclosing worktree and can install the merge fence (.gitattributes) and local Git configuration there. Fixture cleanup removes only the fixture directory, so those changes remain. The repository's scratch isolation rule (docs/REPOSITORY_TESTING.md) requires physical scratch roots outside live worktrees. Fix in the shared generator: realpath the scratch root and refuse it when git rev-parse --show-toplevel succeeds there, or pass an explicit non-Git workspace mode to init."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":3},{"op":"add","path":"/metadata/tags","value":["benchmark","git","isolation","scale","scripts"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-20T15:23:09.895Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-20T15:23:09.895Z"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/estimated_minutes","value":60},{"op":"add","path":"/metadata/acceptance_criteria","value":"generateSyntheticWorkspace resolves the physical scratch root and refuses one inside any Git worktree before init; a spec covers a scratch root inside a temporary Git repository and a symlink into one; existing benchmarks keep passing from the default temp directory"},{"op":"add","path":"/metadata/parent","value":"pm-u9d0"},{"op":"add","path":"/metadata/risk","value":"low"},{"op":"add","path":"/metadata/confidence","value":"medium"},{"op":"add","path":"/metadata/severity","value":"low"},{"op":"add","path":"/metadata/expected_result","value":"Benchmark fixtures never modify an enclosing Git checkout"},{"op":"add","path":"/metadata/actual_result","value":"A TMPDIR inside a Git checkout lets fixture init write that checkout's .gitattributes and Git config"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-gh1664","kind":"discovered_from","created_at":"2026-11-20T15:23:09.895Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"767a21c102de3429206289ab604cf713660997717c12e3011b184a3df4c32ba1","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"e4d4ef61c9d4fab55139513548794ae927b521b094c3e59c6fb7ff796f15bc43"}

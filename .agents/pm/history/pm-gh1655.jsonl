tinel (status canceled removes the assignee: no advisory), with specs."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-03T23:06:33.108Z"}],"before_hash":"61ce9d8ecb151cddfafa31cf6ffb65eb74414827be467f405407528f9b82dbe3","after_hash":"74b80128fdf4be73fd3db2c8c6d3f4edc9cc47b2d8d2564daf70022381e46976","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"e946b967de3433eaf2e7b30599b482cd76d831f29a77c4786810a9385866e3de"}

"},{"op":"add","path":"/metadata/estimated_minutes","value":180},{"op":"add","path":"/metadata/acceptance_criteria","value":"The published tarball contains a generated migration record (for example docs/MIGRATIONS.md) holding only entries with a Migrate: note, newest first, bounded by release count or size; The record is produced by pm-changelog from contract_change data, not hand-written, and a check fails when it drifts from the tracker; The tarball size gate covers the new file and stays within budget; npx and bunx installs of the release can read the record offline"},{"op":"add","path":"/metadata/parent","value":"pm-u9d0"},{"op":"add","path":"/metadata/risk","value":"low"},{"op":"add","path":"/metadata/confidence","value":"medium"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-gh1657","kind":"related","created_at":"2026-11-14T15:41:55.575Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"},{"id":"pm-jndg9a","kind":"discovered_from","created_at":"2026-11-14T15:41:55.575Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"d0d1d23167701ac82ccd59c5a488fa26c94797fc66ca7cb60ee06a76f3c21b37","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"f4f5093c003cabb9eda8244775844110d585b2ff1e3d999b173259b82e625d58"}

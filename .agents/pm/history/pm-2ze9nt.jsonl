{"hash_algorithm":"sha256","ts":"2026-11-28T14:00:13.238Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"39f0409326ff3a93bdf4de17","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-2ze9nt","lineage:pm-2ze9nt","lineage:pm-ugqx","lineage:pm-doxj"]},"topic":{"value":"pm-2ze9nt","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-2ze9nt","lineage:pm-2ze9nt","lineage:pm-ugqx","lineage:pm-doxj"]},"version":{"value":"2.1.332","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-28T14:00:13.238Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-28T14:00:13.238Z","author":"harness:claude-code","text":"Implementation note (2026-11-28): registerItemFields now judges each field against the declarations already admitted to the shared registration registry, plus the fields admitted earlier in the same call. It uses findConflictingItemFieldDeclaration in item-fields.ts, which reads names and types with the write path's own normalizeFieldName and normalizeFieldType, so activation and collectRegisteredFieldDefinitions can never disagree. The first declaration in activation order wins. A later one with another type is dropped with extension_item_field_type_conflict:<layer>:<package>:<field>:<type>:kept=<layer>:<package>:<type>, which package doctor and health carry as activation warnings, the same path the reserved-field warning takes. A same-type redeclaration is kept. A rolled-back package's declarations are truncated from the registry before later packages are judged (captureExtensionActivationRollback), so a failed package never shadows a later one. collectRegisteredFieldDefinitions keeps its typed refusal for hand-built registries, and the existing negative control still proves that refusal on create and update."}]}],"before_hash":"44bf051bbcd12946f17bb594e2137038db17b9e5dcb38b97a51fb9b2c3612cce","after_hash":"29a0ca6c52c5432ab3fae103ee8d6a1b5006dc4b93b00711a7bcfa8052c545c7","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"7a97d25fcef29a4c4ffb5f8042b0f921a6fe25d08dc4d540c9e78ec4ba57e5df"}

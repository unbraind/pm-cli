{"ts":"2026-08-17T05:51:23.890Z","author":"harness:codex","author_source":"detected","agent_harness":"codex","agent_instance":"52e09ad611fe4b76c9f77dec","agent_provenance":{"model":null,"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-dilou2"},{"op":"add","path":"/metadata/title","value":"Exporter artifact-channel contract: clean stdout, bounded receipts, and binary-safe streaming"},{"op":"add","path":"/metadata/description","value":"GitHub issue #1049 demonstrates that registered exporters can write an artifact to stdout while the host appends a second generic receipt to the same stream, producing invalid structured output and duplicating the full artifact. Define an SDK-owned artifact-channel contract that lets extensions declare stdout or file delivery, suppresses incompatible host rendering by construction, preserves human summaries on a separate channel when requested, and proves JSON, CSV, opaque bytes, file output, and global JSON behavior through real extension dispatch."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["agent-ux","area:cli","area:extensions","area:sdk","github:1049","output-contract","streaming","token-efficiency"]},{"op":"add","path":"/metadata/created_at","value":"2026-08-17T05:51:23.890Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-17T05:51:23.890Z"},{"op":"add","path":"/metadata/author","value":"harness:codex"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Exporter registration metadata declares the artifact channel and receipt policy through public SDK types; A stdout artifact is the only document written to stdout by default and is never duplicated inside a generic receipt; JSON, CSV, opaque byte, file-output, human-summary, and global --json modes have explicit non-overlapping channel behavior; Derived exporter help and SDK authoring documentation expose the stream contract and compatibility behavior; Temporary installed-extension acceptance proves jq-safe and redirect-safe output"},{"op":"add","path":"/metadata/parent","value":"pm-mav1ak"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-7qjk","kind":"discovered_from","created_at":"2026-08-17T05:51:23.890Z","author":"harness:codex","source_kind":"cli:create:dep","author_source":"detected"},{"id":"pm-mav1ak","kind":"implements","created_at":"2026-08-17T05:51:23.890Z","author":"harness:codex","source_kind":"cli:create:dep","author_source":"detected"},{"id":"pm-psy1","kind":"verifies","created_at":"2026-08-17T05:51:23.890Z","author":"harness:codex","source_kind":"cli:create:dep","author_source":"detected"}]},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-17T05:51:23.890Z","author":"harness:codex","text":"text=Duplicate check 2026-08-17: searched all 2,515 items across every status for exporter stdout, clean artifact stream, and global --quiet; no item owns this failure. GitHub source: https://github.com/unbraind/pm-cli/issues/1049"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"32591feb95ea791f9e6bdeff03ebf8bbdc892032ab359f65d817b205bf048093","item_hash_version":2,"message":""}

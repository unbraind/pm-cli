d PM_EXTENSION_UPDATE_CHECK_TIMEOUT_MS"},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-18T11:09:17.435Z"}],"before_hash":"3efb8dd381ab62548aaa45b1c85d4290291b2afc4b9c2db26aa44263798c7241","after_hash":"7227264ec7b6eb6dfcb38c605bd2a297b19c8882ae6ecce57d0784962fde9f70","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"4e7709005aa079bf54a17c4fe6f0c06541ad3bcca573b3588e17a762b1b73a8c"}

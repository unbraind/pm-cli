{"hash_algorithm":"sha256","ts":"2026-11-17T21:32:17.484Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"ddb2e572b3dc24915ab9fe76","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-03q389","lineage:pm-03q389","lineage:pm-i7w2"]},"topic":{"value":"pm-03q389","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-03q389","lineage:pm-03q389","lineage:pm-i7w2"]},"version":{"value":"2.1.326","source":"probe"}},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-17T21:32:17.484Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-11-17T21:32:17.484Z","author":"harness:claude-code","text":"Owner decision 2026-11-17: admin-merge PR 1746 despite the environmental advisory failure, and add a time-bounded waiver so the daily release continues while upstream has no patch. Design (this PR): config/dependency-advisory-waivers.json declares exact waivers (GitHub advisory id + npm package + exact locked versions + pm owner + reason >= 20 chars + RFC 3339 UTC expiry at most 30 days past the judging run; notice window 0 to 30 days). scripts/release/dependency-advisories/waivers.mjs validates them with no dist import (the gate runs before pnpm build in quality:static). Receipt version 2 records each registry advisory's validated package, severity, GitHub id and finding versions; a malformed detail voids the advisory's waivability. verifyReceipt checks counts, ids and advisory list agree, then covers each OSV row id and each registry finding version only by an exact live waiver; the verdict discloses waived and unused_waivers. Any malformed, duplicate, expired or over-long waiver refuses even when unused. The gate's refusal now names the uncovered package@version advisory (validated fields only) instead of the generic message. defect-evidence-gate --waiver-notice gained a dependency_advisory check: same validity rules, the declared notice window through the SDK waiverNoticeFor primitive, and an owner that must be an open tracker item; its negative control seeds an advisory waiver an hour from expiry."}]}],"before_hash":"5967034b998293823c32f7da55925487c46f3f9fc4cc460d4439581d2be11d24","after_hash":"081607cf0f5d0ac8941aa41be33b1a40b1f0ba98f2f1047627e982886827da17","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"27edabd7435ec777820b74736a6d0679dcac143a6b1ec9afe000286e9d38c117"}

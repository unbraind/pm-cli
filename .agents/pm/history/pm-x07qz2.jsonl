{"hash_algorithm":"sha256","ts":"2026-11-17T12:36:58.682Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"ddb2e572b3dc24915ab9fe76","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.326","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/3","value":{"created_at":"2026-11-17T12:36:58.682Z","author":"harness:claude-code","text":"CodeRabbit on c529018a9: the no-disclosure statement is narrowed to what the guard guarantees, in docs/MUTATION_INTEGRITY.md and the SecretGuardFinding.path docs. The guard never returns a leaf's matched text, and a property name that a rule flags on its own appears only as its positional placeholder. A name that is not credential-shaped by itself stays in the path even when it equals a value another rule flags elsewhere in the payload. Redacting such names would mean comparing every path segment with every matched span, which the guard deliberately never extracts. Recorded here as the documented boundary of this item."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-17T12:36:58.682Z"}],"before_hash":"71273158a1cf77f015a8088d9241d57adcfd7a8a0e8806fc9eac6620a56aa429","after_hash":"40ed1b4c4007ced2dfd4e77c11be85471046312e43ededce2d94db97de0e9689","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"8407f525273cb36f2da9fd51d16d89764c1e78a33237f5f23527ebc5e3468d5f"}

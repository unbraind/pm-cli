{"hash_algorithm":"sha256","ts":"2026-11-07T00:18:03.112Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"4d05e51e9085533fb7cd32a8","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-dg68kr","lineage:pm-dg68kr","lineage:pm-998juj","lineage:pm-u9d0","lineage:pm-doxj"]},"topic":{"value":"pm-dg68kr","source":"inferred","confidence":"medium","rule_version":"v2","evidence":["claim:pm-dg68kr","lineage:pm-dg68kr","lineage:pm-998juj","lineage:pm-u9d0","lineage:pm-doxj"]},"version":{"value":"2.1.319","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-07T00:18:03.112Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-07T00:18:03.112Z","author":"harness:claude-code","text":"Implemented and measured on fix/recovery-replays-invocation. exportedDeclarationClosure in scripts/release/package-distribution.mjs walks every exported types entry (11 unique) through relative from and import() specifiers, and reaches 473 of the 685 dist declarations. The staging loop skips any dist .d.ts outside that closure, and the checkout keeps every file. Gate receipts on the current build: base profile distribution_size 19,759,014 <= 20,000,000 with 1,589 <= 1,800 files (was 20,025,149 and 1,801). The Sentry-injected profile with --simulate-injection gives 20,037,538 <= 20,298,752 across 778 injected files. Headroom is now 240,986 B and 211 files, with ceilings unchanged. Proof: node scripts/smoke-npx-from-pack.mjs passed locally ('npx and bunx packed package smoke passed (2026.11.6, packages=9)'). Its strict consumer now imports all 12 exported types specifiers. Negative control: on an installed copy of the pruned tarball the same strict consumer compiles with exit 0. After removing the reachable dist/core/checkpoint/mutation-checkpoint.d.ts it fails with TS7016 from dist/sdk/runtime-primitives.d.ts, exit 2. Unit specs cover the closure (cycle, null export target, string targets, bare and .json specifiers, unpacked reference, unsupported specifier) and a real packDistribution fixture. In that fixture an unreachable dist declaration is dropped, while reachable and non-dist declarations ship. Targeted coverage of both scripts reports no uncovered branches or statements."}]}],"before_hash":"298251d7b0334f311e554bc16553374a6c124d985b1164414c8b98ae29b4dc6e","after_hash":"bf1c0aa6974254ae1ffc10b13efad2ded2e8a42cf2752d16e8a9962178b25558","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"cb3511ff0f65df82c08d9f203cb148999ea8ea366668047561cb884b39cf8994"}

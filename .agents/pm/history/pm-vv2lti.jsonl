{"ts":"2026-07-29T18:28:12.101Z","author":"harness:codex","author_source":"detected","agent_harness":"codex","agent_instance":"8e44c177d404faaccfcac65c","agent_provenance":{"model":null},"op":"learning_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-07-29T18:28:12.101Z"},{"op":"add","path":"/metadata/learnings","value":[{"created_at":"2026-07-29T18:28:12.101Z","author":"harness:codex","text":"Item count alone is not a corpus contract. Reproducible performance evidence needs a versioned population declaration, measured conformance after generation, and shape-qualified thresholds; otherwise constants fitted to one shallow synthetic population look universal."}]}],"before_hash":"ea4f7f8b5b7d8ef79a9795e8385a18bcd9695732d854f3f02cf00a398e655ba1","after_hash":"c45fe4ce7b1dc5b02a3d0bdf623e5117e966515a631de95b743554613a550978"}

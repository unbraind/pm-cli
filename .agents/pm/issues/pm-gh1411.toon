  - command: "node --input-type=module -e 'import assert from \"node:assert/strict\"; import { runIsolatedRegressionControl } from \"./scripts/release/isolated-regression-control.mjs\"; const control={\"sourcePath\": \"src/sdk/read-output-contracts.ts\", \"testPath\": \"tests/unit/sdk/read-output/delivered-counts.spec.ts\", \"testName\": \"rebases producer deletion fallback from the uncapped page coordinate\", \"before\": \"originalItemCount: Array.isArray(projected.items)\\n      ? projected.items.length\\n      : 0,\", \"after\": \"originalItemCount: Array.isArray(projected.items)\\n      ? (cursor?.total_rows ?? projected.items.length)\\n      : 0,\"}; const negative=await runIsolatedRegressionControl(control,true); assert.equal(negative.exit_code,1,negative.output); assert.match(negative.output,/AssertionError/); assert.match(negative.output,/resumed.next_cursor/); const positive=await runIsolatedRegressionControl(control,false); assert.equal(positive.exit_code,0,positive.output); console.log(JSON.stringify({negative:negative.exit_code,positive:positive.exit_code}));'"

tests[1]{command,scope,provenance{author,created_at,source_kind,source_ref}}:
  node scripts/run-tests.mjs test -- tests/unit/core/lock/lock-lease-fencing.spec.ts,project,"harness:claude-code","2026-10-22T18:29:38.324Z",local_mutation,fix/lock-lease-fencing-and-progress-wait
close_reason: "Shipped progress-aware lock waiting as an opt-in wait policy: for the item-store mutation lease, restore and the hierarchy-integrity lock the wait budget is a no-progress window that restarts on every observed owner handoff, capped at 120 s total; other locks keep a fixed total budget; explicit maxWaitMs ceilings and wait 0 fail-fast are unchanged; lock_conflict recovery reports waited_ms and owner_handoffs through JSON, text and compact CLI output."
escape_class: production_defect

gate_evidence:
  disposition: gate_strengthened
  gate_id: repository-independent-dependency-advisories
  owner: pm-vkckiv
  negative_control: "node --input-type=module --eval 'import { execFileSync, spawnSync } from '\"'\"'node:child_process'\"'\"';\nimport { mkdtempSync, mkdirSync, readFileSync, symlinkSync, rmSync } from '\"'\"'node:fs'\"'\"';\nimport os from '\"'\"'node:os'\"'\"';\nimport path from '\"'\"'node:path'\"'\"';\nconst root = process.cwd(), unsafe = '\"'\"'b76d697ee7d38d9f9a031406e6d08cb3dc387870'\"'\"';\nconst tmp = mkdtempSync(path.join(os.tmpdir(), '\"'\"'pm-qs-gate-negative-'\"'\"'));\ntry {\n const work = path.join(tmp, '\"'\"'checkout'\"'\"'); mkdirSync(work);\n const archive = path.join(tmp, '\"'\"'source.tar'\"'\"');\n execFileSync('\"'\"'git'\"'\"', ['\"'\"'archive'\"'\"', '\"'\"'--output='\"'\"' + archive, unsafe]);\n execFileSync('\"'\"'tar'\"'\"', ['\"'\"'--exclude=.agents/pm'\"'\"', '\"'\"'-xf'\"'\"', archive, '\"'\"'-C'\"'\"', work]);\n symlinkSync(path.join(root, '\"'\"'node_modules'\"'\"'), path.join(work, '\"'\"'node_modules'\"'\"'), '\"'\"'junction'\"'\"');\n const result = spawnSync(process.execPath, ['\"'\"'scripts/release/dependency-advisories/gate.mjs'\"'\"'], { cwd: work, encoding: '\"'\"'utf8'\"'\"', timeout: 180000, maxBuffer: 16777216, env: { ...process.env, PM_PATH: path.join(tmp, '\"'\"'pm'\"'\"'), PM_GLOBAL_PATH: path.join(tmp, '\"'\"'global'\"'\"'), PM_TELEMETRY_DISABLED: '\"'\"'1'\"'\"', PM_SENTRY_DISABLED: '\"'\"'1'\"'\"' } });\n const receipt = JSON.parse(readFileSync(path.join(work, '\"'\"'.cache/dependency-security/receipt.json'\"'\"'), '\"'\"'utf8'\"'\"'));\n const row = receipt.feeds?.osv?.rows?.find(r => r.name === '\"'\"'qs'\"'\"' && r.version === '\"'\"'6.16.0'\"'\"');\n const proven = result.status === 1 && !result.signal && !result.error && receipt.status === '\"'\"'complete'\"'\"' && receipt.feeds.registry.status === '\"'\"'complete'\"'\"' && receipt.feeds.osv.status === '\"'\"'complete'\"'\"' && row?.ids.includes('\"'\"'GHSA-6pq8-jhm2-2vcw'\"'\"');\n console.log(JSON.stringify({ unsafe, negative_control_proven: proven, advisory: row?.ids }));\n process.exitCode = proven ? 1 : 3;\n} catch (error) { console.error(error); process.exitCode = 3; }\nfinally { rmSync(tmp, { recursive: true, force: true }); }\n'"
  local_checks[3]: node scripts/release/dependency-advisories/gate.mjs,pnpm install --frozen-lockfile,node scripts/release/runtime-lock.mjs check
  hosted_checks[2]: Gates (static),Gates (coverage)

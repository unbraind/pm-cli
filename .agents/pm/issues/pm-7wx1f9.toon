environment: published pm-cli 2026.8.3; --no-extensions; Node 22/Linux
repro_steps: "Enumerate pm --no-extensions contracts --json --full, then invoke pm --no-extensions help --json workspace snapshot list; contracts lists the runnable path but help exits unknown_command."

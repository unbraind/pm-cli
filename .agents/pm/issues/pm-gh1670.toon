severity: medium
repro_steps: "In a fresh tracker: pm health --summary | wc -c (636), pm health --full --summary | wc -c (15704), pm health --summary --full | wc -c (15704), pm health --full | wc -c (15704); all exit 0"
expected_result: "An explicit --summary with --full runs every check and renders the compact summary, or the pair is refused with a remedy; never a silent drop"
actual_result: "--full wins in either order and the output is byte-identical to --full alone with no warning, refusal or omission receipt"
affected_version: 2026.11.4

  negative_control: "node --input-type=module --eval 'import {execFileSync,spawnSync} from '\\''node:child_process'\\'';\nimport {mkdtempSync,readFileSync,writeFileSync,symlinkSync,rmSync} from '\\''node:fs'\\'';\nimport os from '\\''node:os'\\'';import path from '\\''node:path'\\'';\nconst candidate=\"862c800cfe785da6e80a2490318b81586615465b\",unsafe=\"a967abee7afff03cdb9b2e2fba7d206c7b497313\",file=\"src/sdk/query/history.ts\",cases=[{\"kind\":\"preimage\",\"title\":\"aligns filtered diffs with physical history while replaying excluded updates\",\"file\":\"tests/unit/sdk/query/history-recency.spec.ts\",\"fragment\":\"expected [ 5, 4 ] to deeply equal [ 4, 2 ]\"},{\"kind\":\"newest-mutant\",\"title\":\"keeps the newest of 251 native entries and resumes every older entry exactly once\",\"file\":\"tests/unit/sdk/query/history-recency.spec.ts\",\"fragment\":\"to be 251\"}];\nconst root=process.cwd(),tmp=mkdtempSync(path.join(os.tmpdir(),'\\''pm-negative-replay-'\\''));\ntry {\n const archive=path.join(tmp,'\\''source.tar'\\'');\n execFileSync('\\''git'\\'',['\\''archive'\\'','\\''--output='\\''+archive,candidate]);\n execFileSync('\\''tar'\\'',['\\''--exclude=.agents/pm'\\'','\\''-xf'\\'',archive,'\\''-C'\\'',tmp]);\n symlinkSync(path.join(root,'\\''node_modules'\\''),path.join(tmp,'\\''node_modules'\\''),'\\''junction'\\'');\n const fixed=execFileSync('\\''git'\\'',['\\''show'\\'',candidate+'\\'':'\\''+file],{encoding:'\\''utf8'\\''});\n for(const control of cases){\n  let mutant=execFileSync('\\''git'\\'',['\\''show'\\'',unsafe+'\\'':'\\''+file],{encoding:'\\''utf8'\\''});\n  if(control.kind==='\\''newest-mutant'\\''){\n   const needle='\\''const newestFirst = limit === undefined && (compact || options.provenance === true);'\\'';\n   if(fixed.split(needle).length!==2)throw new Error('\\''Refuse ambiguous newest-history mutant'\\'');\n   mutant=fixed.replace(needle,'\\''const newestFirst = false;'\\'');\n  }\n  writeFileSync(path.join(tmp,file),mutant);\n  const report=path.join(tmp,'\\''negative-control.json'\\'');\n  const result=spawnSync(process.execPath,['\\''scripts/run-tests.mjs'\\'','\\''test'\\'','\\''--'\\'',control.file,'\\''-t'\\'',control.title,'\\''--reporter=json'\\'','\\''--outputFile='\\''+report],{cwd:tmp,encoding:'\\''utf8'\\'',timeout:180000,maxBuffer:16777216});\n  const data=JSON.parse(readFileSync(report,'\\''utf8'\\''));\n  const failures=data.testResults.flatMap(s=>s.assertionResults).filter(t=>t.status==='\\''failed'\\'');\n  const proven=result.status===1&&data.numFailedTests===1&&data.testResults.every(s=>s.message==='\\'''\\'')&&failures.length===1&&failures[0].title===control.title&&failures[0].failureMessages.some(m=>m.includes('\\''AssertionError'\\'')&&m.includes(control.fragment));\n  console.log(JSON.stringify({candidate,unsafe,condition:control.kind,test:control.title,negative_control_proven:proven}));\n  if(!proven){process.exitCode=3;break;}\n }\n if(process.exitCode!==3)process.exitCode=1;\n} catch(error){console.error(error);process.exitCode=3;}finally{rmSync(tmp,{recursive:true,force:true});}'"

  owner: pm-gh1611
  negative_control: "node --input-type=module --eval 'import { execFileSync, spawnSync } from '\"'\"'node:child_process'\"'\"';\nimport { mkdtempSync, mkdirSync, readFileSync, copyFileSync, symlinkSync, rmSync, existsSync } from '\"'\"'node:fs'\"'\"';\nimport os from '\"'\"'node:os'\"'\"';\nimport path from '\"'\"'node:path'\"'\"';\nconst root = process.cwd();\nconst unsafe = \"57aced0baeb08fa5bdf81414fef9a02ebef32aaa\";\nconst tmp = mkdtempSync(path.join(os.tmpdir(), '\"'\"'pm-refusal-negative-'\"'\"'));\nconst files = [\"tests/unit/sdk/lifecycle/completion-scope.spec.ts\"];\ntry {\n  const work = path.join(tmp, '\"'\"'checkout'\"'\"'); mkdirSync(work);\n  const archive = path.join(tmp, '\"'\"'source.tar'\"'\"');\n  execFileSync('\"'\"'git'\"'\"', ['\"'\"'archive'\"'\"', '\"'\"'--output='\"'\"' + archive, unsafe], { cwd: root });\n  execFileSync('\"'\"'tar'\"'\"', ['\"'\"'--exclude=.agents/pm'\"'\"', '\"'\"'-xf'\"'\"', archive, '\"'\"'-C'\"'\"', work]);\n  symlinkSync(path.join(root, '\"'\"'node_modules'\"'\"'), path.join(work, '\"'\"'node_modules'\"'\"'), '\"'\"'junction'\"'\"');\n  for (const file of files) copyFileSync(path.join(root, file), path.join(work, file));\n  const report = path.join(tmp, '\"'\"'result.json'\"'\"');\n  const result = spawnSync(process.execPath, ['\"'\"'scripts/run-tests.mjs'\"'\"', '\"'\"'test'\"'\"', '\"'\"'--'\"'\"', ...files, '\"'\"'-t'\"'\"', \"replays an environment-selected root-layout tracker at cwd without touching its nested peer\", '\"'\"'--reporter=json'\"'\"', '\"'\"'--outputFile='\"'\"' + report], { cwd: work, encoding: '\"'\"'utf8'\"'\"', timeout: 240000, maxBuffer: 16777216, env: { ...process.env, PM_PATH: path.join(tmp, '\"'\"'pm'\"'\"'), PM_GLOBAL_PATH: path.join(tmp, '\"'\"'global'\"'\"') } });\n  if (!existsSync(report)) throw new Error('\"'\"'Missing negative-control report: '\"'\"' + result.status + '\"'\"' '\"'\"' + result.signal + '\"'\"' '\"'\"' + (result.error?.message ?? '\"'\"''\"'\"') + '\"'\"'\\n'\"'\"' + result.stderr);\n  const data = JSON.parse(readFileSync(report, '\"'\"'utf8'\"'\"'));\n  const failed = data.testResults.flatMap(s => s.assertionResults).filter(t => t.status === '\"'\"'failed'\"'\"');\n  const expected = [\"replays an environment-selected root-layout tracker at cwd without touching its nested peer\"];\n  const proven = result.status === 1 && !result.signal && !result.error && data.numFailedTests === 1 && failed.length === 1 && data.testResults.every(s => s.message === '\"'\"''\"'\"') && expected.every(title => failed.some(t => t.title === title && t.failureMessages.some(m => m.includes('\"'\"'AssertionError'\"'\"'))));\n  console.log(JSON.stringify({ unsafe, negative_control_proven: proven, failed: failed.map(t => t.title) }));\n  process.exitCode = proven ? 1 : 3;\n} catch (error) { console.error(error); process.exitCode = 3; }\nfinally { rmSync(tmp, { recursive: true, force: true }); }\n'"

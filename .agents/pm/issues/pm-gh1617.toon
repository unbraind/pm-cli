  negative_control: "node --input-type=module --eval 'import {execFileSync,spawnSync} from '\\''node:child_process'\\'';\nimport {existsSync,mkdtempSync,writeFileSync,readFileSync,symlinkSync,rmSync} from '\\''node:fs'\\'';\nimport os from '\\''node:os'\\'';import path from '\\''node:path'\\'';\nconst candidate='\\''beb4dc43b5993cb8b08d38f450930723c06faf30'\\'', unsafe='\\''0194b37689531155b105a614874cc26131e36a60'\\'';\nconst cases=[['\\''src/sdk/query/history.ts'\\'','\\''tests/unit/sdk/query/history-recency.spec.ts'\\'','\\''honors explicit display order for every projection and latest-entry window'\\'',\"to be '\\''oldest_first'\\''\"],['\\''src/sdk/output/table-rows.ts'\\'','\\''tests/unit/sdk/output/table-rows.spec.ts'\\'','\\''compacts agenda null columns and safe string lists with exact restoration'\\'','\\''expected undefined to deeply equal'\\'']];\nconst root=process.cwd(),tmp=mkdtempSync(path.join(os.tmpdir(),'\\''pm-context-negative-'\\''));\ntry {\nconst archive=path.join(tmp,'\\''source.tar'\\'');execFileSync('\\''git'\\'',['\\''archive'\\'','\\''--output='\\''+archive,candidate]);\nexecFileSync('\\''tar'\\'',['\\''--exclude=.agents/pm'\\'','\\''-xf'\\'',archive,'\\''-C'\\'',tmp]);\nsymlinkSync(path.join(root,'\\''node_modules'\\''),path.join(tmp,'\\''node_modules'\\''),'\\''junction'\\'');\nfor(const [source,test,title,fragment] of cases){\nconst fixed=execFileSync('\\''git'\\'',['\\''show'\\'',candidate+'\\'':'\\''+source],{encoding:'\\''utf8'\\''});\nconst needle=source.includes('\\''history.ts'\\'') ? '\\''const newestFirst = (options.order ?? (compact || options.provenance === true ? \"newest_first\" : \"oldest_first\")) === \"newest_first\";'\\'' : '\\''  const columns = [...new Set(rows.flatMap((row) => Object.keys(row)))];'\\'';\nconst replacement=source.includes('\\''history.ts'\\'') ? '\\''const newestFirst = limit === undefined && (compact || options.provenance === true);'\\'' : '\\''  options = {};\\n'\\''+needle;\nif(fixed.split(needle).length!==2)throw new Error('\\''Ambiguous mutation'\\'');\nwriteFileSync(path.join(tmp,source),fixed.replace(needle,replacement));\nconst report=path.join(tmp,'\\''negative.json'\\'');\nconst result=spawnSync(process.execPath,['\\''scripts/run-tests.mjs'\\'','\\''test'\\'','\\''--'\\'',test,'\\''-t'\\'',title,'\\''--reporter=json'\\'','\\''--outputFile='\\''+report],{cwd:tmp,env:{...process.env,PM_PATH:path.join(tmp,'\\''isolated-pm'\\''),PM_GLOBAL_PATH:path.join(tmp,'\\''isolated-global'\\'')},encoding:'\\''utf8'\\'',timeout:180000,maxBuffer:16777216});\nif(!existsSync(report))throw new Error(JSON.stringify({status:result.status,signal:result.signal,error:result.error,stdout:result.stdout?.slice(-5000),stderr:result.stderr?.slice(-5000)}));\nconst data=JSON.parse(readFileSync(report,'\\''utf8'\\''));const failures=data.testResults.flatMap(s=>s.assertionResults).filter(t=>t.status==='\\''failed'\\'');\nconst proven=result.status===1&&data.numFailedTests===1&&data.testResults.every(s=>s.message==='\\'''\\'')&&failures.length===1&&failures[0].title===title&&failures[0].failureMessages.some(m=>m.includes('\\''AssertionError'\\'')&&m.includes(fragment));\nconsole.log(JSON.stringify({candidate,unsafe,test:title,negative_control_proven:proven}));\nif(!proven){process.exitCode=3;break;}\nwriteFileSync(path.join(tmp,source),execFileSync('\\''git'\\'',['\\''show'\\'',candidate+'\\'':'\\''+source]));\n}\nif(process.exitCode!==3)process.exitCode=1;\n} catch(error){console.error(error);process.exitCode=3;}finally{rmSync(tmp,{recursive:true,force:true});}\n'"

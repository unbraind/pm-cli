close_reason: Compacted strings carry a recognisable marker and annotation edits refuse text copied from a compacted read
contract_change:
  api: "Budgeted read output (CLI, SDK and MCP string compaction) and annotation --edit"
  before: "A compacted string ended with a bare ellipsis, and an edit accepted text copied from a compacted read"
  after: "A compacted string ends with the marker …[+N chars] naming the omitted UTF-16 code units, and an annotation --edit whose text ends with that marker is refused with annotation_text_compacted"
  migrate: "Detect compaction through read_output.strings_compacted or the trailing …[+N chars] marker instead of a bare ellipsis; re-read the full entry with --output-budget unbounded before editing it"
escape_class: production_defect

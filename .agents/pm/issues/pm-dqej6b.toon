gate_evidence:
  disposition: gate_strengthened
  gate_id: scratch-lifecycle-performance
  negative_control: "node --input-type=module --eval 'import { cp, mkdtemp, readFile, rm, symlink, writeFile } from \"node:fs/promises\";\nimport { spawnSync } from \"node:child_process\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nconst source = process.cwd();\nconst root = await mkdtemp(path.join(tmpdir(), \"pm-latency-negative-\"));\nconst excluded = new Set([\".agents\", \".git\", \".cache\", \"coverage\", \"node_modules\"]);\ntry {\n  await cp(source, root, { recursive: true, filter: value => !path.relative(source, value).split(path.sep).some(segment => excluded.has(segment)) });\n  await symlink(path.join(source, \"node_modules\"), path.join(root, \"node_modules\"), \"junction\");\n  const spec = path.join(root, \"tests/integration/scratch-lifecycle.integration.spec.ts\");\n  const original = await readFile(spec, \"utf8\");\n  const marker = \"const started = performance.now();\";\n  if (!original.includes(marker)) throw new Error(\"Latency control insertion point is absent\");\n  await writeFile(spec, original.replace(marker, marker + \"\\n      await new Promise(resolve => setTimeout(resolve, 15100));\"));\n  const result = spawnSync(process.execPath, [\"scripts/run-tests.mjs\", \"test\", \"--\", \"tests/integration/scratch-lifecycle.integration.spec.ts\"], { cwd: root, env: process.env, stdio: \"inherit\" });\n  if (result.error) throw result.error;\n  process.exitCode = result.status ?? 1;\n} finally {\n  await rm(root, { recursive: true, force: true });\n}\n'"
  local_checks[2]: node scripts/run-tests.mjs test -- tests/integration/scratch-lifecycle.integration.spec.ts,node scripts/run-tests.mjs coverage
  hosted_checks[2]: CI / Gates (coverage),CI / Windows regression (Node 24)

gate_evidence:
  disposition: gate_strengthened
  gate_id: mutation-event-authoritative-integrity
  negative_control: "Run new history/mutation-event-integrity.spec.ts against unchanged main3ba042b3d in an isolated worktree: stale same-length non-tail record_hash data is served and verification/raw timestamp controls fail. Identical post-fix controls pass. Review controls against ddc2d5ce1 fail three cases: call-order-dependent unverified timestamps and repeated reparsing of invalid-UTF8 receipts with and without SQLite; all pass after the exact-byte/projection refinements. Final review control against783318c3b warms two streams, appends to the first and corrupts the second, then proves a failed strict read must not hide the append on a selected unverified read; unchanged code fails and local staged-map publication passes. Against a6703edc8, native three-reader filesystem barriers expose fresh receipts paired with stale rows, and the existing native host-file test fails only for verify=true. Both fail before coherent object publication/shared error wrapping and pass afterward; no SDK result is mocked."
  local_checks[4]: node scripts/run-tests.mjs test -- tests/unit/sdk/history/mutation-event-integrity.spec.ts tests/unit/sdk/mutation-events.spec.ts tests/unit/core/history/event-index.spec.ts tests/unit/core/history/event-index-snapshots.spec.ts tests/unit/cli/register-list-query.spec.ts tests/unit/core/history/history-read-bytes.spec.ts,node scripts/run-tests.mjs coverage,"pnpm quality:static",node scripts/run-tests.mjs test -- tests/unit/sdk/history/mutation-event-fallback.spec.ts

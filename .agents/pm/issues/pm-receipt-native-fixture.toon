  negative_control: "node --input-type=module --eval 'import {execFileSync,spawnSync} from '\\''node:child_process'\\'';\nimport {mkdtempSync,mkdirSync,existsSync,readFileSync,writeFileSync,symlinkSync,rmSync} from '\\''node:fs'\\'';\nimport os from '\\''node:os'\\'';import path from '\\''node:path'\\'';\nconst unsafe='\\''0af0391c1c4a4c2ff80a2e0abb74379b3bcb3169'\\'',root=process.cwd(),tmp=mkdtempSync(path.join(os.tmpdir(),'\\''pm-native-receipt-negative-'\\''));\ntry{\n const work=path.join(tmp,'\\''checkout'\\'');mkdirSync(work);const archive=path.join(tmp,'\\''source.tar'\\'');execFileSync('\\''git'\\'',['\\''archive'\\'','\\''--output='\\''+archive,unsafe]);execFileSync('\\''tar'\\'',['\\''--exclude=.agents/pm'\\'','\\''-xf'\\'',archive,'\\''-C'\\'',work]);\n symlinkSync(path.join(root,'\\''node_modules'\\''),path.join(work,'\\''node_modules'\\''),'\\''junction'\\'');\n const physical=path.join(tmp,'\\''physical'\\''),alias=path.join(tmp,'\\''alias'\\'');mkdirSync(physical);symlinkSync(physical,alias,'\\''junction'\\'');\n const report=path.join(tmp,'\\''negative.json'\\'');\n const result=spawnSync(process.execPath,['\\''scripts/run-tests.mjs'\\'','\\''test'\\'','\\''--'\\'','\\''tests/unit/sdk/test/receipt-index-snapshot.spec.ts'\\'','\\''-t'\\'','\\''preserves snapshot authority on a source'\\'','\\''--reporter=json'\\'','\\''--outputFile='\\''+report],{cwd:work,encoding:'\\''utf8'\\'',timeout:180000,maxBuffer:16777216,env:{...process.env,TMPDIR:alias,TMP:alias,TEMP:alias,PM_PATH:path.join(tmp,'\\''sandbox-pm'\\''),PM_GLOBAL_PATH:path.join(tmp,'\\''sandbox-global'\\'')}});\n if(!existsSync(report)){console.error(JSON.stringify({status:result.status,signal:result.signal,error:result.error?.message}));console.error((result.stdout||'\\'''\\'')+(result.stderr||'\\'''\\''));throw new Error('\\''Missing negative-control report'\\'');}\n const data=JSON.parse(readFileSync(report,'\\''utf8'\\'')),failed=data.testResults.flatMap(s=>s.assertionResults).filter(t=>t.status==='\\''failed'\\'');\n const conditions=['\\''corrupt index'\\'','\\''missing object'\\'','\\''invalid repository'\\'','\\''missing Git metadata'\\'','\\''missing workspace'\\''];\n const expected=conditions.map(c=>'\\''preserves snapshot authority on a source '\\''+c+'\\'' read failure'\\'');\n const proven=result.status===1&&data.numFailedTests===5&&data.testResults.every(s=>s.message==='\\'''\\'')&&failed.length===5&&expected.every(title=>failed.some(t=>t.title===title&&t.failureMessages.some(m=>m.includes('\\''AssertionError'\\'')&&m.includes('\\''expected +0 to be 1'\\''))));\n console.log(JSON.stringify({unsafe,failed_cases:failed.length,negative_control_proven:proven}));process.exitCode=proven?1:3;\n}catch(error){console.error(error);process.exitCode=3;}finally{rmSync(tmp,{recursive:true,force:true});}'"

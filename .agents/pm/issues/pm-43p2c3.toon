close_reason: GitHub managed-package update checks report stable github_remote_lookup_failed and github_remote_lookup_timed_out codes instead of git's command line and stderr
contract_change:
  api: "Managed GitHub update checks: update_error and update_check_reason"
  before: "A failed git ls-remote reported git's command line and stderr, starting 'Git command failed: git ls-remote', as update_error"
  after: "It reports github_remote_lookup_timed_out with update_check_timeout_ms when the budget ran out and github_remote_lookup_failed otherwise, and git runs with GIT_TERMINAL_PROMPT=0 and GCM_INTERACTIVE=never"
  migrate: "Match the two stable codes instead of parsing git's message, and run git ls-remote directly to see git's own error"
escape_class: production_defect

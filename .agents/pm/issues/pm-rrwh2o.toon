repro_steps: "In a sandbox tracker run pm learnings <id> --add x --output-cursor bad --json and read the code, required and examples fields"
expected_result: "The refusal carries a stable code, names the offending output flags and suggests the mutation retry without them"
actual_result: "code command_failed, generic required text and pm --help examples"

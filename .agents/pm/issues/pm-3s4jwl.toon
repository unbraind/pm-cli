    scope: project
    note: normalizeCliToken exported
  - path: src/sdk/extension-command-context.ts
    scope: project
    note: settings writer shares add-field admission for new/changed inline fields
  - path: src/sdk/schema/field-option-collisions.ts
    scope: project
  - path: tests/unit/sdk/transactions/settings-field-admission.spec.ts
    scope: project
tests[1]{command,scope,provenance{author,created_at,source_kind,source_ref}}:
  node scripts/run-tests.mjs test -- tests/unit/sdk/transactions/settings-field-admission.spec.ts,project,"harness:claude-code","2026-11-23T08:45:47.376Z",local_mutation,fix/extension-harness-admission-parity
docs[2]{path,scope}:
  docs/EXTENSIONS.md,project
  docs/SDK_AUDITED_MUTATIONS.md,project
close_reason: "Extension item fields cannot shadow a built-in option, which is measured and documented; the settings writer shares the add-field admission"
contract_change:
  api: sdk.mutateWorkspaceSettings for inline schema field definitions
  before: A settings proposal could add or change an inline custom field whose option shadows a built-in option or whose flag the parser splits; only the settings shape was validated
  after: "Each added or changed inline field definition takes the schema add-field admission before anything is written, dry run included; a definition left exactly as stored is not judged"
  migrate: "Rename a proposed field that shadows a built-in option, or register it only for commands where its option is free; pass one spelling per alias"
escape_class: production_defect
gate_evidence:
  disposition: gate_added
  owner: pm-3s4jwl
  gate_id: settings-writer-field-admission
  negative_control: On 2026.11.23 mutateWorkspaceSettings appending an inline field full on create and list is written; settings-field-admission.spec.ts requires schema_field_option_collision with settings.json unchanged
  local_checks[1]: node scripts/run-tests.mjs test -- tests/unit/sdk/transactions/settings-field-admission.spec.ts
  hosted_checks[2]: Gates (coverage),Gates (static)
body: ""

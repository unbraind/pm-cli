  negative_control: "node --input-type=module --eval 'import {execFileSync,spawnSync} from '\\''node:child_process'\\'';\nimport {mkdtempSync,readFileSync,writeFileSync,symlinkSync,rmSync} from '\\''node:fs'\\'';\nimport os from '\\''node:os'\\'';\nimport path from '\\''node:path'\\'';\nconst root=process.cwd(),tmp=mkdtempSync(path.join(os.tmpdir(),'\\''pm-negative-replay-'\\''));\ntry {\n const archive=path.join(tmp,'\\''source.tar'\\'');\n execFileSync('\\''git'\\'',['\\''archive'\\'','\\''--output='\\''+archive,'\\''73846f26f2255ca4afaffb642543e2e3d3d63f44'\\'']);\n execFileSync('\\''tar'\\'',['\\''--exclude=.agents/pm'\\'','\\''-xf'\\'',archive,'\\''-C'\\'',tmp]);\n symlinkSync(path.join(root,'\\''node_modules'\\''),path.join(tmp,'\\''node_modules'\\''),'\\''junction'\\'');\n writeFileSync(path.join(tmp,'\\''src/sdk/test/command-resolution.ts'\\''),execFileSync('\\''git'\\'',['\\''show'\\'','\\''9dad0a28c87beb0fbb66f9eec9f7360f9bf549dd:src/sdk/test/command-resolution.ts'\\'']));\n const report=path.join(tmp,'\\''negative.json'\\'');\n const result=spawnSync(process.execPath,['\\''scripts/run-tests.mjs'\\'','\\''test'\\'','\\''--'\\'','\\''tests/unit/sdk/test/missing-command.spec.ts'\\'','\\''-t'\\'',\"distinguishes an absent script interpreter from scripts reporting their own launch failures\",'\\''--reporter=json'\\'','\\''--outputFile'\\'',report],{cwd:tmp,env:{...process.env,PM_TELEMETRY_DISABLED:'\\''1'\\'',PM_SENTRY_ENABLED:'\\''0'\\''},stdio:'\\''inherit'\\''});\n const data=JSON.parse(readFileSync(report,'\\''utf8'\\''));\n const failures=data.testResults.flatMap(s=>s.assertionResults).filter(t=>t.status==='\\''failed'\\'');\n const proven=result.status===1 && data.numFailedTests===1 && !data.numRuntimeErrorTestSuites && failures.length===1 && failures[0].title===\"distinguishes an absent script interpreter from scripts reporting their own launch failures\" && failures[0].failureMessages.some(m=>m.includes('\\''AssertionError'\\''));\n console.log(JSON.stringify({candidate:'\\''73846f26f2255ca4afaffb642543e2e3d3d63f44'\\'',mutant:'\\''9dad0a28c87beb0fbb66f9eec9f7360f9bf549dd'\\'',test:\"distinguishes an absent script interpreter from scripts reporting their own launch failures\",negative_control_proven:proven}));\n process.exitCode=proven?1:3;\n} catch(error){console.error(error);process.exitCode=3;} finally{rmSync(tmp,{recursive:true,force:true});}'"

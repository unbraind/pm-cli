author: "harness:claude-code"
estimated_minutes: 240
acceptance_criteria: "An extension whose manifest declares narrow activation.commands is NOT imported for a command outside that scope, regardless of which capabilities it declares; the ~1.5x ceiling from pm-4oww is re-measured and enforced by a gate that can fail"
parent: pm-ugqx
risk: medium

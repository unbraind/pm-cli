assignee: "harness:codex"
claim_principal: "harness:codex#0be07b94b7b44e4ec913bc03"
author: "harness:codex"
acceptance_criteria: "The Windows Node 24 nightly release cleanup test distinguishes Node process compile cache from owned release workspace residue without weakening the sentinel and refusal checks; Focused regression and exact full coverage/static gates pass, and a hosted Windows Node 24 nightly run verifies the fix before GitHub issue closure"
parent: pm-p5u6

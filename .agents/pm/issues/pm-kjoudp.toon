  gate_id: rendered-command-shell-safety
  negative_control: "tests/integration/cli/rendered-command-shell-safety.integration.spec.ts runs a hostile corpus ($(...), backticks, %VAR%, quotes, ampersands, apostrophes, typographic quotes, empty strings and tabs) through pwsh -EncodedCommand and asserts byte-exact argv with a defined probe variable; the CommandLineToArgvW double-quoted form of 2026.11.24 expands $(Write-Output PWNED) in PowerShell"
  local_checks[1]: node scripts/run-tests.mjs test -- tests/unit/cli/argv-utils.spec.ts tests/integration/cli/rendered-command-shell-safety.integration.spec.ts tests/unit/core/shared/url-credentials.spec.ts
  hosted_checks[2]: "Windows regression cohort (native 1/1, Node 24)",Gates (coverage)

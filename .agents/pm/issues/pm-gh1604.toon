  negative_control: "node --input-type=module --eval 'import {execFileSync,spawnSync} from '\\''node:child_process'\\'';\nimport {mkdtempSync,readFileSync,writeFileSync,symlinkSync,rmSync} from '\\''node:fs'\\'';\nimport os from '\\''node:os'\\'';import path from '\\''node:path'\\'';\nconst root=process.cwd(),tmp=mkdtempSync(path.join(os.tmpdir(),'\\''pm-negative-replay-'\\''));\ntry {\n const archive=path.join(tmp,'\\''source.tar'\\'');execFileSync('\\''git'\\'',['\\''archive'\\'','\\''--output='\\''+archive,'\\''aff043f08ea0bd4a14b30af6f420d0f7f01c910f'\\'']);\n execFileSync('\\''tar'\\'',['\\''--exclude=.agents/pm'\\'','\\''-xf'\\'',archive,'\\''-C'\\'',tmp]);\n symlinkSync(path.join(root,'\\''node_modules'\\''),path.join(tmp,'\\''node_modules'\\''),'\\''junction'\\'');\n writeFileSync(path.join(tmp,\"src/sdk/test/execution.ts\"),execFileSync('\\''git'\\'',['\\''show'\\'',\"ce979159acfe034217a5694a3e826940895b3581:src/sdk/test/execution.ts\"]));\n const report=path.join(tmp,'\\''negative.json'\\'');\n const result=spawnSync(process.execPath,['\\''scripts/run-tests.mjs'\\'','\\''test'\\'','\\''--'\\'',\"tests/unit/sdk/test/missing-command.spec.ts\",'\\''-t'\\'',\"distinguishes shell command lookup failures from executed children exiting 127 or printing ENOENT\",'\\''--reporter=json'\\'','\\''--outputFile'\\'',report],{cwd:tmp,env:{...process.env,PM_TELEMETRY_DISABLED:'\\''1'\\'',PM_SENTRY_DISABLED:'\\''1'\\''},stdio:'\\''inherit'\\''});\n const data=JSON.parse(readFileSync(report,'\\''utf8'\\'')),failures=data.testResults.flatMap(s=>s.assertionResults).filter(t=>t.status==='\\''failed'\\'');\n const proven=result.status===1 && data.numFailedTests===1 && data.testResults.every(s=>s.message==='\\'''\\'') && failures.length===1 && failures[0].title===\"distinguishes shell command lookup failures from executed children exiting 127 or printing ENOENT\" && failures[0].failureMessages.some(m=>m.includes('\\''AssertionError'\\'')&&m.includes(\"to match object\"));\n console.log(JSON.stringify({candidate:'\\''aff043f08ea0bd4a14b30af6f420d0f7f01c910f'\\'',unsafe_condition:\"ce979159acfe034217a5694a3e826940895b3581\",file:\"src/sdk/test/execution.ts\",test:\"distinguishes shell command lookup failures from executed children exiting 127 or printing ENOENT\",negative_control_proven:proven}));\n if(!proven)console.error(JSON.stringify({status:result.status,suites:data.testResults.map(s=>({message:s.message})),failures}));\n process.exitCode=proven?1:3;\n} catch(error){console.error(error);process.exitCode=3;} finally{rmSync(tmp,{recursive:true,force:true});}'"

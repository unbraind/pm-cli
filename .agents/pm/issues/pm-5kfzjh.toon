contract_change:
  api: "Managed npm update checks: update_error, update_check_reason, update_check_timeout_ms and PM_EXTENSION_UPDATE_CHECK_TIMEOUT_MS"
  before: "An npm update lookup that ran out of its fixed 10-second budget reported npm_registry_lookup_failed, like an unavailable registry"
  after: "It reports npm_registry_lookup_timed_out with update_check_timeout_ms naming the budget, other failures still report npm_registry_lookup_failed, and PM_EXTENSION_UPDATE_CHECK_TIMEOUT_MS sets the budget (default 10000, clamped to 1000-120000)"
  migrate: "Match npm_registry_lookup_timed_out wherever npm_registry_lookup_failed is matched, and raise PM_EXTENSION_UPDATE_CHECK_TIMEOUT_MS for a slow registry or cold start"
body: ""

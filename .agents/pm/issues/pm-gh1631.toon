  gate_id: "tests/integration/telemetry/extension-error-provenance.spec.ts producer-diagnostics marker against real local OTLP and Sentry collectors (Node and Bun), plus tests/unit/core/shared/error-details.spec.ts admission and byte-ceiling cases"
  negative_control: "Remove omitProducerDiagnostics from beforeSend in src/core/sentry/instrument.ts: the instrument.spec.ts case finds the diagnostics marker in the outgoing event; remove the details projection from errorContent in src/mcp/server.ts: the MCP oversize case receives the 5,000-byte payload"
  local_checks[2]: node scripts/run-tests.mjs test -- tests/unit/core/shared/error-details.spec.ts tests/unit/cli/error-guidance.spec.ts tests/unit/mcp/mcp-server-branch-residual.spec.ts tests/unit/core/sentry/instrument.spec.ts tests/unit/core/sentry/sentry-helpers.spec.ts tests/unit/sdk/sdk-index.spec.ts,node scripts/run-tests.mjs test -- tests/integration/telemetry/extension-error-provenance.spec.ts

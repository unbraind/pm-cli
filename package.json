{
  "name": "@unbrained/pm-cli",
  "version": "2026.8.4",
  "description": "Git-native project management CLI for humans and agents.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "author": "unbrained",
  "homepage": "https://github.com/unbraind/pm-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbraind/pm-cli.git"
  },
  "bugs": {
    "url": "https://github.com/unbraind/pm-cli/issues"
  },
  "bin": {
    "pm-cli": "dist/cli.js",
    "pm": "dist/cli.js",
    "pm-mcp": "dist/mcp/server.js"
  },
  "types": "dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/cli-bundle/sdk.js",
      "default": "./dist/cli-bundle/sdk.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/cli-bundle/sdk.js",
      "default": "./dist/cli-bundle/sdk.js"
    },
    "./sdk/authoring": {
      "types": "./dist/sdk/authoring.d.ts",
      "import": "./dist/cli-bundle/sdk-authoring.js",
      "default": "./dist/cli-bundle/sdk-authoring.js"
    },
    "./sdk/contracts": {
      "types": "./dist/sdk/contracts.d.ts",
      "import": "./dist/cli-bundle/sdk-contracts.js",
      "default": "./dist/cli-bundle/sdk-contracts.js"
    },
    "./sdk/core": {
      "types": "./dist/sdk/core.d.ts",
      "import": "./dist/cli-bundle/sdk-core.js",
      "default": "./dist/cli-bundle/sdk-core.js"
    },
    "./sdk/governance": {
      "types": "./dist/sdk/governance.d.ts",
      "import": "./dist/cli-bundle/sdk-governance.js",
      "default": "./dist/cli-bundle/sdk-governance.js"
    },
    "./sdk/graph": {
      "types": "./dist/sdk/graph.d.ts",
      "import": "./dist/cli-bundle/sdk-graph.js",
      "default": "./dist/cli-bundle/sdk-graph.js"
    },
    "./sdk/merge": {
      "types": "./dist/sdk/merge.d.ts",
      "import": "./dist/cli-bundle/sdk-merge.js",
      "default": "./dist/cli-bundle/sdk-merge.js"
    },
    "./sdk/query": {
      "types": "./dist/sdk/query.d.ts",
      "import": "./dist/cli-bundle/sdk-query.js",
      "default": "./dist/cli-bundle/sdk-query.js"
    },
    "./sdk/runtime": {
      "types": "./dist/sdk/runtime.d.ts",
      "import": "./dist/cli-bundle/sdk-runtime.js",
      "default": "./dist/cli-bundle/sdk-runtime.js"
    },
    "./sdk/testing": {
      "types": "./dist/sdk/testing.d.ts",
      "import": "./dist/cli-bundle/sdk-testing.js",
      "default": "./dist/cli-bundle/sdk-testing.js"
    },
    "./sdk/public-surface.json": "./sdk/public-surface.json",
    "./cli": {
      "types": "./dist/cli/main.d.ts",
      "import": "./dist/cli/main.js",
      "default": "./dist/cli/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE",
    "AGENTS.md",
    "docs/**",
    "sdk/public-surface.json",
    ".claude-plugin/**",
    "plugins/**",
    "packages/pm-*/**",
    "scripts/bundle-cli.mjs",
    "scripts/generate-agent-capability-surfaces.mjs",
    "scripts/finalize-build.mjs",
    "scripts/install.sh",
    "scripts/install.ps1",
    "scripts/prepare-build-cache.mjs",
    "marketplace.json"
  ],
  "scripts": {
    "build": "node scripts/prepare-build-cache.mjs && tsc -p tsconfig.json && node scripts/bundle-cli.mjs && node scripts/finalize-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.typetests.json && tsc -p tsconfig.packages.json && tsc -p tsconfig.examples.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "node scripts/run-tests.mjs test",
    "test:coverage": "node scripts/run-tests.mjs coverage",
    "test:fuzz": "node scripts/run-tests.mjs test -- tests/fuzz",
    "lint": "pnpm lint:eslint && pnpm lint:duplicates && pnpm lint:codefactor",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:eslint:prune": "eslint . --prune-suppressions",
    "lint:complexity:baseline": "eslint . --suppress-rule complexity --suppress-rule sonarjs/cognitive-complexity",
    "lint:duplicates": "jscpd --config .jscpd.json",
    "lint:codefactor": "pnpm quality:static",
    "quality:static": "pnpm build && pnpm exec tsx scripts/release/static-quality-gate.mts --max-eslint-suppressions 127 --max-coverage-ignore-pragmas 477 --min-docstring-coverage 100 --min-exported-docstring-coverage 100 --min-member-docstring-coverage 100 && node scripts/release/audit-package-boundary.mjs && node scripts/release/package-sdk-contract-parity.mjs && node scripts/release/token-budget-gate.mjs && node scripts/release/context-intent-calibration-gate.mjs && node scripts/release/gate-registry.mjs && node scripts/sdk-surface-snapshot.mjs --check && node scripts/bench/sdk-entrypoint-costs.mjs --check && node scripts/bench/cli-transport-floor.mjs --check",
    "quality:token-budget": "node scripts/release/token-budget-gate.mjs",
    "quality:token-surface": "node scripts/measure-agent-token-surface.mjs --check",
    "quality:token-surface:update": "pnpm build && node scripts/measure-agent-token-surface.mjs --update",
    "quality:context-eval": "pnpm build && node scripts/release/context-eval-gate.mjs && node scripts/release/retrieval-eval-gate.mjs --negative-control && node scripts/release/retrieval-eval-gate.mjs && node scripts/release/agent-task-token-gate.mjs --negative-control && node scripts/release/agent-task-token-gate.mjs && pnpm quality:token-surface",
    "quality:agent-task-token": "pnpm build && node scripts/release/agent-task-token-gate.mjs",
    "quality:agent-task-token:update": "pnpm build && node scripts/release/agent-task-token-gate.mjs --update",
    "quality:retrieval-eval": "pnpm build && node scripts/release/retrieval-eval-gate.mjs",
    "quality:retrieval-eval:update": "pnpm build && node scripts/release/retrieval-eval-gate.mjs --update",
    "quality:gate-registry": "pnpm build && node scripts/release/gate-registry.mjs",
    "quality:package-artifact": "pnpm build && node scripts/release/package-artifact-gate.mjs",
    "quality:docs-skills": "node scripts/release/docs-skills-gate.mjs",
    "quality:docs-links": "node scripts/release/docs-skills-gate.mjs --links-only",
    "quality:hosted-analysis": "node scripts/release/hosted-analysis-gate.mjs",
    "benchmark:scale:generate": "node scripts/bench/scale-workspace.mjs",
    "benchmark:scale": "node scripts/bench/run-scale-benchmarks.mjs",
    "benchmark:scale:check": "node scripts/bench/run-scale-benchmarks.mjs --items ci --iterations 3 --transport both --check --output .cache/scale-local-report.json",
    "benchmark:corpus-shapes": "pnpm build && node scripts/bench/compare-corpus-shapes.mjs",
    "benchmark:sdk-entrypoints:update": "pnpm build && node scripts/bench/sdk-entrypoint-costs.mjs --update",
    "benchmark:sdk-entrypoints:check": "pnpm build && node scripts/bench/sdk-entrypoint-costs.mjs --check",
    "benchmark:transport:update": "pnpm build && node scripts/bench/cli-transport-floor.mjs --update",
    "benchmark:transport:check": "pnpm build && node scripts/bench/cli-transport-floor.mjs --check",
    "contracts:update": "node scripts/contracts-snapshot.mjs --update",
    "contracts:check": "pnpm build && node scripts/contracts-snapshot.mjs --check && node scripts/generate-agent-capability-surfaces.mjs --check && node scripts/generate-error-code-catalog.mjs --check",
    "contracts:errors:update": "node scripts/generate-error-code-catalog.mjs",
    "contracts:errors:check": "node scripts/generate-error-code-catalog.mjs --check",
    "contracts:agent-surfaces:update": "pnpm build && node scripts/generate-agent-capability-surfaces.mjs",
    "contracts:agent-surfaces:check": "pnpm build && node scripts/generate-agent-capability-surfaces.mjs --check",
    "sdk:surface:update": "pnpm build && node scripts/sdk-surface-snapshot.mjs --update",
    "sdk:surface:check": "pnpm build && node scripts/sdk-surface-snapshot.mjs --check",
    "dogfood:package-first": "node scripts/dogfood-package-first.mjs",
    "smoke:external-packages": "node scripts/smoke-external-packages.mjs",
    "smoke:codex-plugin": "node scripts/smoke-codex-plugin-mcp.mjs",
    "smoke:claude-plugin": "node scripts/smoke-claude-plugin.mjs",
    "version:check": "node scripts/release-version.mjs check && node scripts/sync-versions.mjs check",
    "version:next": "node scripts/release-version.mjs next",
    "version:sync": "node scripts/sync-versions.mjs apply",
    "changelog:pm:install": "node dist/cli.js install npm:pm-changelog --project",
    "changelog:pm": "pnpm changelog:pm:install && node dist/cli.js changelog generate --output CHANGELOG.md --title \"Changelog\" --mode replace --all-release-tags --status closed --item-url-base https://github.com/unbraind/pm-cli/blob/main/.agents/pm",
    "changelog:pm:check": "pnpm changelog:pm:install && node dist/cli.js changelog generate --output CHANGELOG.md --title \"Changelog\" --mode replace --all-release-tags --status closed --item-url-base https://github.com/unbraind/pm-cli/blob/main/.agents/pm --check",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "release:gates": "node scripts/release/run-gates.mjs --telemetry-mode best-effort",
    "release:pipeline": "node scripts/release/run-release-pipeline.mjs",
    "release:pipeline:dry-run": "node scripts/release/run-release-pipeline.mjs --dry-run",
    "release:verify-published": "node scripts/release/verify-published-release.mjs",
    "release:verify-installed-agent": "node scripts/release/verify-installed-agent-session.mjs",
    "review:greptile": "greptile review --agent",
    "review:greptile:gate": "node scripts/release/greptile-review-gate.mjs",
    "security:scan": "node scripts/check-secrets.mjs",
    "smoke:npx": "node scripts/smoke-npx-from-pack.mjs",
    "sentry:telemetry:gate": "node scripts/release/sentry-telemetry-gate.mjs",
    "sentry:inject": "sentry-cli sourcemaps inject dist/",
    "sentry:upload": "sentry-cli sourcemaps upload --org unbrained --project pm-cli --release \"pm-cli@$npm_package_version\" --validate dist/",
    "build:sentry": "pnpm build && pnpm sentry:inject && pnpm sentry:upload",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "cli",
    "project-management",
    "agents",
    "ai",
    "git-native",
    "typescript",
    "task-tracker",
    "coding-agents"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@sentry/node": "10.69.0",
    "@toon-format/toon": "^4.1.0",
    "@types/node": ">=22",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "fast-json-patch": "^3.1.1",
    "npm-package-arg": "^13.0.2",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.6.2",
    "@types/node": "^26.1.2",
    "@types/npm-package-arg": "^6.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "fast-check": "^4.9.0",
    "greptile": "^3.3.1",
    "jscpd": "^5.0.14",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
